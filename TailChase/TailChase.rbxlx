CheckUIIcons.FlatMap = FlatMap

--[[
	Get an icon asset ID by path or category, subcategory, itemName.
	Examples:
		CheckUIIcons.Get("Currency/Coin/Golden Coin 1st")
		CheckUIIcons.Get("Currency", "Coin", "Golden_1st")
--]]
function CheckUIIcons.Get(...: string): string
	local args = { ... }
	if #args == 1 then
		local path = args[1]
		if FlatMap[path] then
			return FlatMap[path]
		end
		-- Check direct lookup
		for k, v in pairs(FlatMap) do
			if string.find(string.lower(k), string.lower(path)) then
				return v
			end
		end
		warn("[CheckUIIcons] Icon not found for path: " .. tostring(path))
		return ""
	elseif #args == 3 then
		local cat, sub, name = args[1], args[2], args[3]
		local catTbl = CheckUIIcons[cat]
		if catTbl and catTbl[sub] and catTbl[sub][name] then
			return catTbl[sub][name]
		end
		warn("[CheckUIIcons] Icon not found for: " .. cat .. "." .. sub .. "." .. name)
		return ""
	end
	return ""
end

--[[
	Search icons by name keyword.
	Returns array of { Path = string, AssetId = string }
--]]
function CheckUIIcons.Search(keyword: string): { { Path: string, AssetId: string } }
	local results = {}
	local lower = string.lower(keyword)
	for path, assetId in pairs(FlatMap) do
		if string.find(string.lower(path), lower) then
			table.insert(results, { Path = path, AssetId = assetId })
		end
	end
	return results
end

return table.freeze(CheckUIIcons)]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000F"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--[[
	Audio - lecture des sons définis dans Config.Sounds (client).
	Les IDs qui commencent par "PLACEHOLDER_" sont ignorés sans erreur (à renseigner plus tard).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage.Shared.Config)

local Audio = {}

local function valid(def): boolean
	return def ~= nil and type(def.Id) == "string" and def.Id ~= "" and not def.Id:find("^PLACEHOLDER")
end

--- Joue un son une fois. `parent` = BasePart/Attachment pour un son 3D, nil pour un son 2D.
function Audio.Play(name: string, parent: Instance?, pitchJitter: number?): Sound?
	local def = Config.Sounds[name]
	if not valid(def) then return nil end
	local s = Instance.new("Sound")
	s.Name = "SFX_" .. name
	s.SoundId = def.Id
	s.Volume = def.Volume or 0.5
	local j = pitchJitter or 0
	s.PlaybackSpeed = (def.Pitch or 1) * (1 + (math.random() * 2 - 1) * j)
	s.RollOffMaxDistance = 120
	s.Parent = parent or SoundService
	s:Play()
	Debris:AddItem(s, 6)
	return s
end

--- Musique en boucle (une seule à la fois). name = nil coupe la musique.
local current: Sound? = nil
local currentName: string? = nil
function Audio.Music(name: string?)
	if name == currentName then return end
	currentName = name
	if current then
		local old = current
		current = nil
		task.spawn(function()
			for i = 10, 0, -1 do
				old.Volume = old.Volume * 0.8
				task.wait(0.05)
			end
			old:Destroy()
		end)
	end
	if not name then return end
	local def = Config.Sounds[name]
	if not valid(def) then return end
	local s = Instance.new("Sound")
	s.Name = "Music_" .. name
	s.SoundId = def.Id
	s.Looped = true
	s.Volume = def.Volume or 0.3
	s.Parent = SoundService
	s:Play()
	current = s
end

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">ClientSignals</string><ProtectedString name="Source"><![CDATA[--[[
	ClientSignals - petit bus d'événements entre les contrôleurs clients (Movement, UI, Animation, Effects).
	Chaque LocalScript qui require ce module obtient la même table (cache de require par environnement client).

	Signaux :
		Dash(cooldown)            le joueur local vient de dasher
		Slide(active)             début / fin du slide local
		MobileAction(name)        bouton tactile pressé ("Dash" | "Slide")
		Shake(intensity, time)    secousse caméra
		LocalCapture(victimName)  le joueur local vient de prendre une queue
]]

local Signals = {}
local events: { [string]: BindableEvent } = {}

local function get(name: string): BindableEvent
	local e = events[name]
	if not e then
		e = Instance.new("BindableEvent")
		e.Name = name
		events[name] = e
	end
	return e
end

function Signals.Fire(name: string, ...)
	get(name):Fire(...)
end

function Signals.Connect(name: string, fn: (...any) -> ()): RBXScriptConnection
	return get(name).Event:Connect(fn)
end

-- état partagé lisible par tous les contrôleurs
Signals.State = {
	DashReadyAt = 0,
	DashCooldown = 0,
	Sliding = false,
}

return Signals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Config - TOUTES les valeurs ajustables de TAIL CHASE.
	Modifie ici les durées, vitesses, cooldowns, récompenses et prix : aucun autre script ne contient de "nombre magique" de gameplay.
]]

local Config = {}

-- =====================================================================
-- BOUCLE DE MANCHE
-- =====================================================================
Config.MinPlayers = 2            -- joueurs "prêts" minimum pour lancer l'intermission (1 chasseur + 1 participant)
Config.StudioMinPlayers = 2      -- en Studio aussi (Test > Local Server 2 joueurs). Pour tester seul : panel admin > LANCER
Config.IntermissionTime = 20     -- secondes
Config.CountdownTime = 5         -- décompte avant le départ (tout le monde figé)
Config.HunterReleaseDelay = 3    -- avance des participants : les chasseurs partent X s après le GO
Config.RoundTime = 180           -- 3 minutes
Config.ResultsTime = 10
Config.ExtraHunterThreshold = 10 -- au-delà de ce nombre de joueurs : 2 chasseurs
Config.VoteOptions = 3          -- nombre de maps proposées au vote pendant l'intermission

-- =====================================================================
-- ADMIN (panel « Admin » du lobby)
-- Admins : en Studio tout le monde, sinon le créateur du jeu (ou rang >= AdminGroupRank du groupe propriétaire)
-- + les UserIds listés ici.
-- =====================================================================
Config.Admins = {
	-- 123456789,
}
Config.AdminGroupRank = 254
Config.AdminShortRoundTime = 60   -- bouton « MANCHE COURTE »
Config.AdminCoinsGift = 1000      -- bouton « +1000 PIÈCES »

-- =====================================================================
-- CAPTURE (validée côté serveur)
-- =====================================================================
Config.CaptureDistance = 5.5       -- distance max (studs) entre les HumanoidRootPart
Config.CaptureVerticalMax = 6      -- écart vertical max (évite les captures à travers un toit)
Config.HunterCaptureCooldown = 0.6 -- délai entre deux captures d'un même chasseur
Config.NewHunterImmunity = 2       -- anti-chaîne : un nouveau chasseur ne peut pas capturer pendant X s
Config.CaptureCheckRate = 1 / 20   -- fréquence du test de capture (s)

-- =====================================================================
-- MOUVEMENT
-- =====================================================================
Config.RunnerWalkSpeed = 20
Config.HunterWalkSpeed = 21.5
Config.LobbyWalkSpeed = 18
Config.JumpPower = 50

Config.DashSpeed = 78           -- vitesse horizontale pendant le dash
Config.DashDuration = 0.18
Config.DashCooldown = 4
Config.DashFovBoost = 14        -- élargissement bref du FOV
Config.DashServerTolerance = 0.35 -- marge latence pour la validation serveur du cooldown

Config.SlideBoost = 1.55        -- multiplicateur de vitesse au début du slide (conserve l'élan)
Config.SlideMinSpeed = 30
Config.SlideMaxSpeed = 60
Config.SlideDuration = 0.85
Config.SlideFriction = 1.6      -- décroissance de la vitesse par seconde (fraction)
Config.SlideCooldown = 1.1
Config.SlideCrouchSpeed = 13    -- vitesse quand on reste accroupi sous un plafond de tunnel
Config.SlideCameraOffset = -1.8

Config.JumpPadPower = 105       -- vitesse verticale donnée par un jump pad
Config.JumpPadCooldown = 0.6

Config.KillPlaneY = -40         -- sous cette hauteur, le joueur est replacé

-- =====================================================================
-- ÉCONOMIE
-- =====================================================================
Config.Coins = {
	SurvivalSecondsPerCoin = 5, -- 1 pièce / 5 s de survie
	PerTail = 10,               -- 10 pièces par queue prise
	Participation = 25,
	LastSurvivor = 50,
	StartingCoins = 100,
}

-- =====================================================================
-- DONNÉES
-- =====================================================================
Config.Data = {
	StoreName = "TailChase_Profiles_v1",
	LeaderboardStore = "TailChase_TailsTaken_v1",
	AutoSaveInterval = 120,
	Retries = 4,
	RetryDelay = 1.5,
	LeaderboardRefresh = 60,
}

-- =====================================================================
-- MONÉTISATION (points d'extension, NON implémentés)
-- Renseigne ici les IDs quand tu les crées sur le dashboard ; ShopService.GrantProduct est le point d'entrée prévu.
-- =====================================================================
Config.Monetization = {
	DeveloperProducts = {
		-- [123456789] = { Kind = "Coins", Amount = 500 },
	},
	Gamepasses = {
		-- [987654321] = { Kind = "Cosmetic", Item = "tail_rainbow" },
	},
}

-- =====================================================================
-- AUDIO (sons libres Roblox / fichiers intégrés ; remplace les PLACEHOLDER_ par tes IDs)
-- =====================================================================
Config.Sounds = {
	RoundStart = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, Pitch = 0.8 },
	Countdown = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.7, Pitch = 1 },
	Go = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.9, Pitch = 1.3 },
	Capture = { Id = "rbxasset://sounds/snap.wav", Volume = 1, Pitch = 0.9 },
	CaptureWhoosh = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.8, Pitch = 1.2 },
	Dash = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.7, Pitch = 1.5 },
	Slide = { Id = "rbxasset://sounds/action_swim.mp3", Volume = 0.6, Pitch = 1.6 },
	JumpPad = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.9, Pitch = 0.8 },
	Purchase = { Id = "rbxassetid://1319346243", Volume = 0.55, Pitch = 1 },
	Victory = { Id = "rbxasset://sounds/victory.wav", Volume = 0.8, Pitch = 1 },
	Notify = { Id = "rbxassetid://109359226723492", Volume = 0.35, Pitch = 1.3 },
	CoinTick = { Id = "rbxassetid://6895079853", Volume = 0.35, Pitch = 1.4 },
	-- Musiques : PLACEHOLDER. Mets ici l'ID d'une musique libre de la Creator Store (ex : "rbxassetid://XXXX").
	MusicLobby = { Id = "PLACEHOLDER_MusicLobby", Volume = 0.3, Pitch = 1 },
	MusicRound = { Id = "PLACEHOLDER_MusicRound", Volume = 0.3, Pitch = 1 },
}

-- =====================================================================
-- VISUEL
-- =====================================================================
Config.StudTexture = "rbxassetid://140544932962041" -- motif de studs tileable (même texture que le kit StudUI)
Config.HunterColor = Color3.fromRGB(255, 30, 50)
Config.RunnerColor = Color3.fromRGB(60, 170, 255)
Config.TailSegments = 6
Config.TailSegmentLength = 0.75

-- =====================================================================
-- ANIMATIONS
-- Par défaut TOUT est procédural (AnimationController) : aucune animation à uploader.
-- Si tu crées tes propres animations (Animation Editor -> Publish), colle leur ID ici : l'état correspondant
-- jouera alors ton animation (répliquée à tous) et le procédural ne s'appliquera plus à cet état.
-- =====================================================================
Config.Animations = {
	Idle = "",  -- ex : "rbxassetid://123456789"
	Walk = "",
	Run = "",
	Jump = "",
	Fall = "",
	Slide = "",
	Dash = "",
}
Config.WalkRunThreshold = 14 -- au-dessus : cycle "course", en dessous : "marche"

Config.States = {
	Lobby = "Lobby",
	Intermission = "Intermission",
	Countdown = "Countdown",
	Round = "Round",
	Results = "Results",
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Cosmetics - catalogue du shop (cosmétiques uniquement, aucun avantage de gameplay).
	Chaque item : Id, Category ("Tail" | "Trail" | "Capture"), Name, Price, Rarity (échelle StudUI), Icon (chemin CheckUIIcons),
	+ les paramètres visuels lus par TailBuilder / EffectsController.
	Pour ajouter un item : ajoute une entrée ici, c'est tout (le shop et l'inventaire sont générés depuis cette liste).
]]

local C3 = Color3.fromRGB

export type Item = {
	Id: string,
	Category: string,
	Name: string,
	Price: number,
	Rarity: string,
	Icon: string,
	Colors: { Color3 }?,
	Material: Enum.Material?,
	Pattern: string?, -- "Solid" | "Stripes" | "Flame" | "Rainbow" | "Gold" | "Neon"
	Color: Color3?,
	Fx: string?,
	Default: boolean?,
}

local Cosmetics = {}

Cosmetics.Categories = {
	{ Id = "Tail", Label = "Queues", Icon = "Exclusive/Trail/Red Trail 1st Outline", Theme = "red" },
	{ Id = "Trail", Label = "Traînées", Icon = "Main/Lighting/Lighting 1st Outline", Theme = "blue" },
	{ Id = "Capture", Label = "Captures", Icon = "Main/Star/Golden Star 1st Outline", Theme = "yellow" },
}

Cosmetics.Items = {
	-- ------------------------------------------------------------------ QUEUES
	{ Id = "tail_classic", Category = "Tail", Name = "Classique", Price = 0, Rarity = "Common", Default = true,
		Icon = "Exclusive/Trail/Red Trail 1st Outline", Pattern = "Solid", Colors = { C3(255, 120, 30) }, Material = Enum.Material.SmoothPlastic },
	{ Id = "tail_striped", Category = "Tail", Name = "Rayée", Price = 250, Rarity = "Uncommon",
		Icon = "Exclusive/Trail/Blue Trail 1st Outline", Pattern = "Stripes", Colors = { C3(255, 255, 255), C3(40, 120, 255) }, Material = Enum.Material.SmoothPlastic },
	{ Id = "tail_flame", Category = "Tail", Name = "Flamme", Price = 600, Rarity = "Rare",
		Icon = "Main/Fire/Fire 1st Outline", Pattern = "Flame", Colors = { C3(255, 230, 60), C3(255, 120, 0), C3(220, 20, 0) }, Material = Enum.Material.Neon },
	{ Id = "tail_rainbow", Category = "Tail", Name = "Arc-en-ciel", Price = 1200, Rarity = "Epic",
		Icon = "Exclusive/Trail/Purple Trail 1st Outline", Pattern = "Rainbow", Colors = { C3(255, 40, 80), C3(255, 150, 0), C3(255, 230, 0), C3(40, 220, 60), C3(0, 190, 255), C3(140, 60, 255) }, Material = Enum.Material.SmoothPlastic },
	{ Id = "tail_gold", Category = "Tail", Name = "Dorée", Price = 2500, Rarity = "Legendary",
		Icon = "Item/Crown/Crown 1st Outline", Pattern = "Gold", Colors = { C3(255, 210, 60), C3(255, 170, 20) }, Material = Enum.Material.Foil },
	{ Id = "tail_neon", Category = "Tail", Name = "Néon", Price = 4000, Rarity = "Mythic",
		Icon = "Main/Lighting/Blue Lighting 1st Outline", Pattern = "Neon", Colors = { C3(0, 255, 230), C3(255, 0, 200) }, Material = Enum.Material.Neon },

	-- ------------------------------------------------------------------ TRAÎNÉES DE DASH
	{ Id = "trail_default", Category = "Trail", Name = "Vent", Price = 0, Rarity = "Common", Default = true,
		Icon = "Exclusive/Trail/Blue Trail 1st Outline", Colors = { C3(255, 255, 255), C3(180, 220, 255) } },
	{ Id = "trail_lime", Category = "Trail", Name = "Éclair vert", Price = 300, Rarity = "Uncommon",
		Icon = "Main/Lighting/Green Lighting 1st Outline", Colors = { C3(200, 255, 60), C3(40, 200, 0) } },
	{ Id = "trail_fire", Category = "Trail", Name = "Brasier", Price = 800, Rarity = "Rare",
		Icon = "Main/Fire/Fire 1st Outline", Colors = { C3(255, 230, 60), C3(255, 40, 0) } },
	{ Id = "trail_galaxy", Category = "Trail", Name = "Galaxie", Price = 1800, Rarity = "Epic",
		Icon = "Main/Lighting/Purple Lighting 1st Outline", Colors = { C3(120, 60, 255), C3(255, 60, 200) } },
	{ Id = "trail_rainbow", Category = "Trail", Name = "Prisme", Price = 3500, Rarity = "Legendary",
		Icon = "Exclusive/Trail/Yellow Trail 1st Outline", Colors = { C3(255, 40, 80), C3(255, 230, 0), C3(0, 200, 255) } },

	-- ------------------------------------------------------------------ EFFETS DE CAPTURE
	{ Id = "capture_default", Category = "Capture", Name = "Pouf", Price = 0, Rarity = "Common", Default = true,
		Icon = "Main/Star/Golden Star 1st Outline", Fx = "Puff", Color = C3(255, 255, 255) },
	{ Id = "capture_stars", Category = "Capture", Name = "Étoiles", Price = 400, Rarity = "Uncommon",
		Icon = "Main/Star/Blue Star 1st Outline", Fx = "Stars", Color = C3(255, 230, 80) },
	{ Id = "capture_hearts", Category = "Capture", Name = "Cœurs", Price = 900, Rarity = "Rare",
		Icon = "Main/Heart/Heart 1st Outline", Fx = "Hearts", Color = C3(255, 80, 140) },
	{ Id = "capture_skull", Category = "Capture", Name = "Crâne", Price = 1600, Rarity = "Epic",
		Icon = "Player/Skull/Skull 1st Outline", Fx = "Skull", Color = C3(170, 90, 255) },
	{ Id = "capture_coins", Category = "Capture", Name = "Jackpot", Price = 3000, Rarity = "Legendary",
		Icon = "Currency/Coin/Golden Coin 1st Outline", Fx = "Coins", Color = C3(255, 200, 40) },
} :: { Item }

Cosmetics.ById = {} :: { [string]: Item }
for _, item in Cosmetics.Items do
	Cosmetics.ById[item.Id] = item
end

function Cosmetics.Get(id: string?): Item?
	if not id then return nil end
	return Cosmetics.ById[id]
end

--- Item par défaut d'une catégorie (gratuit, possédé d'office).
function Cosmetics.DefaultFor(category: string): string
	for _, item in Cosmetics.Items do
		if item.Category == category and item.Default then return item.Id end
	end
	return ""
end

function Cosmetics.ByCategory(category: string): { Item }
	local list = {}
	for _, item in Cosmetics.Items do
		if item.Category == category then table.insert(list, item) end
	end
	table.sort(list, function(a, b) return a.Price < b.Price end)
	return list
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">TailBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TailBuilder - construit la "queue" (chasuble qui pend dans le dos) d'un participant.
	Partagé : le serveur l'attache aux personnages, le client s'en sert pour la queue qui vole vers le chasseur.

	Structure :
		Model "Tail" (Attribute Skin)
		 ├ Seg1 ... SegN   petites plaques souples (Massless, sans collision)
		 └ Weld "Joint" dans chaque segment (Part0 = segment précédent / torse) avec Attribute "BaseC0"
	Le balancement est procédural : EffectsController fait osciller le C0 de chaque Joint (purement visuel, local).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)

local TailBuilder = {}

local WIDTH, THICK = 1.15, 0.14

local function segmentColor(item: Cosmetics.Item, i: number, n: number): Color3
	local colors = item.Colors or { Color3.fromRGB(255, 120, 30) }
	local pattern = item.Pattern or "Solid"
	if pattern == "Stripes" or pattern == "Neon" then
		return colors[((i - 1) % #colors) + 1]
	elseif pattern == "Rainbow" then
		return colors[math.clamp(math.floor((i - 1) / math.max(n - 1, 1) * (#colors - 1) + 0.5) + 1, 1, #colors)]
	elseif pattern == "Flame" or pattern == "Gold" then
		local t = (i - 1) / math.max(n - 1, 1)
		local a = colors[1]
		local b = colors[#colors]
		return a:Lerp(b, t)
	end
	return colors[1]
end

local function studTexture(part: BasePart, face: Enum.NormalId)
	local tex = Instance.new("Texture")
	tex.Texture = Config.StudTexture
	tex.Face = face
	tex.StudsPerTileU = 1
	tex.StudsPerTileV = 1
	tex.Transparency = 0.55
	tex.Parent = part
end

--- Construit les segments ; si `anchorTo` est fourni, le premier segment y est soudé (dans le dos).
function TailBuilder.Build(skinId: string?, anchorTo: BasePart?): Model
	local item = Cosmetics.Get(skinId) or Cosmetics.Get(Cosmetics.DefaultFor("Tail")) :: Cosmetics.Item
	local n = Config.TailSegments
	local L = Config.TailSegmentLength
	local model = Instance.new("Model")
	model.Name = "Tail"
	model:SetAttribute("Skin", item.Id)

	local prev: BasePart? = anchorTo
	for i = 1, n do
		local seg = Instance.new("Part")
		seg.Name = "Seg" .. i
		-- la queue s'affine vers le bout
		local w = WIDTH * (1 - (i - 1) / n * 0.35)
		seg.Size = Vector3.new(w, L, THICK)
		seg.Material = item.Material or Enum.Material.SmoothPlastic
		seg.Color = segmentColor(item, i, n)
		seg.CanCollide = false
		seg.CanQuery = false
		seg.CanTouch = false
		seg.Massless = true
		seg.CastShadow = false
		seg.TopSurface = Enum.SurfaceType.Smooth
		seg.BottomSurface = Enum.SurfaceType.Smooth
		studTexture(seg, Enum.NormalId.Back)
		studTexture(seg, Enum.NormalId.Front)
		seg.Parent = model

		if prev then
			local joint = Instance.new("Weld")
			joint.Name = "Joint"
			joint.Part0 = prev
			joint.Part1 = seg
			local c0: CFrame
			if i == 1 and anchorTo then
				-- dos du torse (+Z local = arrière), un peu en dessous du milieu, incliné vers l'arrière
				c0 = CFrame.new(0, -anchorTo.Size.Y * 0.2, anchorTo.Size.Z / 2 + THICK / 2 + 0.02) * CFrame.Angles(math.rad(-12), 0, 0)
			else
				c0 = CFrame.new(0, -L / 2, 0) * CFrame.Angles(math.rad(-6), 0, 0)
			end
			joint.C0 = c0
			joint.C1 = CFrame.new(0, L / 2, 0)
			joint:SetAttribute("BaseC0", c0)
			joint:SetAttribute("Index", i)
			joint.Parent = seg
		end
		prev = seg
	end

	-- décorations selon le motif
	local last = model:FindFirstChild("Seg" .. n) :: BasePart
	local pattern = item.Pattern
	if pattern == "Flame" then
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 4
		fire.Color = Color3.fromRGB(255, 140, 0)
		fire.SecondaryColor = Color3.fromRGB(255, 40, 0)
		fire.Parent = last
	elseif pattern == "Gold" then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 220, 90)
		sp.Parent = last
	elseif pattern == "Neon" then
		local light = Instance.new("PointLight")
		light.Color = (item.Colors or {})[1] or Color3.new(0, 1, 1)
		light.Range = 8
		light.Brightness = 2
		light.Parent = last
	end
	return model
end

--- Torse sur lequel accrocher la queue (R15 : UpperTorso, R6 : Torso).
function TailBuilder.TorsoOf(character: Model): BasePart?
	return (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
end

function TailBuilder.Attach(character: Model, skinId: string?): Model?
	TailBuilder.Remove(character)
	local torso = TailBuilder.TorsoOf(character)
	if not torso then return nil end
	local tail = TailBuilder.Build(skinId, torso)
	tail.Parent = character
	return tail
end

function TailBuilder.Remove(character: Model)
	local old = character:FindFirstChild("Tail")
	if old then old:Destroy() end
end

return TailBuilder
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000001F"><Properties><string name="Name">Remotes</string></Properties><Item class="RemoteEvent" referent="RBX00000010"><Properties><string name="Name">RoundState</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000011"><Properties><string name="Name">Notify</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000012"><Properties><string name="Name">RoleAssigned</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000013"><Properties><string name="Name">Captured</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000014"><Properties><string name="Name">MoveAction</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000015"><Properties><string name="Name">Results</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000016"><Properties><string name="Name">DataUpdated</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000017"><Properties><string name="Name">SetReady</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000018"><Properties><string name="Name">OpenMenu</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000019"><Properties><string name="Name">TutorialDone</string></Properties></Item><Item class="RemoteEvent" referent="RBX0000001A"><Properties><string name="Name">MapVote</string></Properties></Item><Item class="RemoteFunction" referent="RBX0000001B"><Properties><string name="Name">AdminCommand</string></Properties></Item><Item class="RemoteFunction" referent="RBX0000001C"><Properties><string name="Name">ShopPurchase</string></Properties></Item><Item class="RemoteFunction" referent="RBX0000001D"><Properties><string name="Name">ShopEquip</string></Properties></Item><Item class="RemoteFunction" referent="RBX0000001E"><Properties><string name="Name">GetProfile</string></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000030"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[--[[
	AdminService - commandes du panel admin (RemoteFunction Remotes.AdminCommand), vérifiées côté serveur.
	Qui est admin : tout le monde en Studio ; en ligne, le créateur du jeu (ou rang >= Config.AdminGroupRank si le jeu
	appartient à un groupe) + Config.Admins. Player Attribute "IsAdmin" -> le client affiche la tuile Admin.

	Commandes :
		"Start"      lance la manche tout de suite (tout le monde devient prêt, intermission sautée)
		"End"        termine la manche en cours (résultats normaux)
		"AllReady"   met tous les joueurs « prêts »
		"Coins"      +Config.AdminCoinsGift pièces pour l'admin
		"ShortRound" bascule la durée de manche : Config.RoundTime <-> Config.AdminShortRoundTime
		"ResetTuto"  rejoue le tutoriel au prochain affichage
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local AdminService = {}

-- état lu par GameManager
AdminService.Control = {
	ForceStart = false,
	ForceEnd = false,
	ShortRound = false,
}

function AdminService.IsAdmin(player: Player): boolean
	if RunService:IsStudio() then return true end
	if table.find(Config.Admins, player.UserId) then return true end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
	return ok and rank >= Config.AdminGroupRank
end

function AdminService.RoundTime(): number
	return if AdminService.Control.ShortRound then Config.AdminShortRoundTime else Config.RoundTime
end

local function reply(ok: boolean, msg: string)
	return { Ok = ok, Message = msg, ShortRound = AdminService.Control.ShortRound }
end

local function run(player: Player, cmd: any)
	if not AdminService.IsAdmin(player) then return reply(false, "Accès refusé") end
	if typeof(cmd) ~= "string" then return reply(false, "Commande invalide") end
	local state = ReplicatedStorage:GetAttribute("GameState")
	local S = Config.States
	if cmd == "Start" then
		if state == S.Round or state == S.Countdown then return reply(false, "Une manche est déjà en cours") end
		for _, p in Players:GetPlayers() do p:SetAttribute("Ready", true) end
		AdminService.Control.ForceStart = true
		return reply(true, "Lancement de la manche !")
	elseif cmd == "End" then
		if state ~= S.Round and state ~= S.Countdown then return reply(false, "Aucune manche en cours") end
		AdminService.Control.ForceEnd = true
		return reply(true, "Fin de manche demandée")
	elseif cmd == "AllReady" then
		for _, p in Players:GetPlayers() do p:SetAttribute("Ready", true) end
		return reply(true, "Tout le monde est prêt")
	elseif cmd == "Coins" then
		DataService.AddCoins(player, Config.AdminCoinsGift)
		return reply(true, "+" .. Config.AdminCoinsGift .. " pièces")
	elseif cmd == "ShortRound" then
		AdminService.Control.ShortRound = not AdminService.Control.ShortRound
		return reply(true, if AdminService.Control.ShortRound then ("Manches de %d s"):format(Config.AdminShortRoundTime) else ("Manches de %d s"):format(Config.RoundTime))
	elseif cmd == "ResetTuto" then
		local d = DataService.Get(player)
		if d then
			d.TutorialDone = false
			DataService.Push(player)
		end
		return reply(true, "Tutoriel réinitialisé")
	end
	return reply(false, "Commande inconnue")
end

function AdminService.Init()
	Remotes.AdminCommand.OnServerInvoke = run
	local function tag(p: Player)
		task.spawn(function() p:SetAttribute("IsAdmin", AdminService.IsAdmin(p)) end)
	end
	Players.PlayerAdded:Connect(tag)
	for _, p in Players:GetPlayers() do tag(p) end
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">CoinService</string><ProtectedString name="Source"><![CDATA[--[[
	CoinService - calcule et verse les pièces de fin de manche.
		survie        : 1 pièce / Config.Coins.SurvivalSecondsPerCoin secondes
		queues prises : Config.Coins.PerTail par queue
		participation : Config.Coins.Participation
		dernier survivant : Config.Coins.LastSurvivor (survivants à la fin, sinon le dernier capturé)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local CoinService = {}

export type Breakdown = { Survival: number, Tails: number, Participation: number, Bonus: number, Total: number }

function CoinService.Compute(survivalSeconds: number, tails: number, lastSurvivor: boolean): Breakdown
	local c = Config.Coins
	local b = {
		Survival = math.floor(math.max(0, survivalSeconds) / c.SurvivalSecondsPerCoin),
		Tails = tails * c.PerTail,
		Participation = c.Participation,
		Bonus = if lastSurvivor then c.LastSurvivor else 0,
		Total = 0,
	}
	b.Total = b.Survival + b.Tails + b.Participation + b.Bonus
	return b
end

--- Verse les pièces et met à jour les stats. Retourne le détail.
function CoinService.Reward(player: Player, survivalSeconds: number, tails: number, lastSurvivor: boolean, survived: boolean): Breakdown
	local b = CoinService.Compute(survivalSeconds, tails, lastSurvivor)
	local d = DataService.Get(player)
	if d then
		d.Stats.Rounds += 1
		d.Stats.TailsTaken += tails
		d.Stats.BestSurvival = math.max(d.Stats.BestSurvival, math.floor(survivalSeconds))
		if survived then d.Stats.Wins += 1 end
		DataService.AddCoins(player, b.Total)
	end
	return b
end

return CoinService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService - sauvegarde DataStore des profils (pièces, achats, équipements, stats).
	  * chargement / sauvegarde avec pcall + retries + backoff
	  * sauvegarde auto toutes les Config.Data.AutoSaveInterval s, à la sortie du joueur et à la fermeture (BindToClose)
	  * si le chargement échoue définitivement, le profil est marqué "NoSave" : on ne risque pas d'écraser les vraies données
	  * leaderstats (Pièces / Queues) + leaderboard du lobby (OrderedDataStore, repli sur les joueurs présents)
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local UI = require(ReplicatedStorage.StudUI)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }
local loaded = Instance.new("BindableEvent")
DataService.ProfileLoaded = loaded.Event

local store, ordered
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.Data.StoreName)
		ordered = DataStoreService:GetOrderedDataStore(Config.Data.LeaderboardStore)
	end)
	if not ok then
		warn("[DataService] DataStore indisponible (active 'Studio Access to API Services' pour tester la sauvegarde) :", err)
	end
end

local function template()
	return {
		Version = 1,
		Coins = Config.Coins.StartingCoins,
		Owned = {
			[Cosmetics.DefaultFor("Tail")] = true,
			[Cosmetics.DefaultFor("Trail")] = true,
			[Cosmetics.DefaultFor("Capture")] = true,
		},
		Equipped = {
			Tail = Cosmetics.DefaultFor("Tail"),
			Trail = Cosmetics.DefaultFor("Trail"),
			Capture = Cosmetics.DefaultFor("Capture"),
		},
		Stats = { Rounds = 0, TailsTaken = 0, BestSurvival = 0, Wins = 0, CoinsEarned = 0 },
		TutorialDone = false,
	}
end

--- Complète un profil chargé avec les champs manquants du modèle (migrations simples).
local function reconcile(data, tpl)
	for k, v in tpl do
		if data[k] == nil then
			data[k] = if type(v) == "table" then table.clone(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

--- Exécute fn avec retries + backoff. Retourne ok, résultat.
local function retry(label: string, fn: () -> any)
	local lastErr
	for attempt = 1, Config.Data.Retries do
		local ok, res = pcall(fn)
		if ok then return true, res end
		lastErr = res
		warn(("[DataService] %s : essai %d/%d échoué : %s"):format(label, attempt, Config.Data.Retries, tostring(res)))
		task.wait(Config.Data.RetryDelay * attempt)
	end
	return false, lastErr
end

local function key(player: Player) return "player_" .. player.UserId end

-- -------------------------------------------------------------------- leaderstats
local function setupLeaderstats(player: Player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Pièces"
	coins.Value = data.Coins
	coins.Parent = ls
	local tails = Instance.new("IntValue")
	tails.Name = "Queues"
	tails.Value = data.Stats.TailsTaken
	tails.Parent = ls
	ls.Parent = player
end

local function refreshLeaderstats(player: Player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then return end
	ls["Pièces"].Value = data.Coins
	ls.Queues.Value = data.Stats.TailsTaken
end

--- Copie envoyée au client (pas de référence partagée).
function DataService.Snapshot(player: Player)
	local d = DataService.Profiles[player]
	if not d then return nil end
	return {
		Coins = d.Coins,
		Owned = table.clone(d.Owned),
		Equipped = table.clone(d.Equipped),
		Stats = table.clone(d.Stats),
		TutorialDone = d.TutorialDone == true,
	}
end

function DataService.Push(player: Player)
	local d = DataService.Profiles[player]
	if not d then return end
	refreshLeaderstats(player, d)
	player:SetAttribute("TrailSkin", d.Equipped.Trail) -- lu par EffectsController de tous les clients
	Remotes.DataUpdated:FireClient(player, DataService.Snapshot(player))
end

-- -------------------------------------------------------------------- load / save
function DataService.Load(player: Player)
	local data
	local noSave = false
	if store then
		local ok, res = retry("Load " .. player.Name, function()
			return store:GetAsync(key(player))
		end)
		if ok then
			data = res
		else
			noSave = true
			warn("[DataService] profil de " .. player.Name .. " non chargé : session sans sauvegarde")
		end
	else
		noSave = true
	end
	if not player.Parent then return end
	data = reconcile(type(data) == "table" and data or {}, template())
	data.NoSave = noSave or nil
	DataService.Profiles[player] = data
	setupLeaderstats(player, data)
	DataService.Push(player)
	loaded:Fire(player, data)
end

function DataService.Save(player: Player)
	local d = DataService.Profiles[player]
	if not d or d.NoSave or not store then return false end
	local payload = table.clone(d)
	payload.NoSave = nil
	local ok = retry("Save " .. player.Name, function()
		store:UpdateAsync(key(player), function()
			return payload
		end)
	end)
	if ordered then
		pcall(function() ordered:SetAsync(key(player), d.Stats.TailsTaken) end)
	end
	return ok
end

function DataService.Get(player: Player)
	return DataService.Profiles[player]
end

--- Attend le profil (max `timeout` s).
function DataService.Wait(player: Player, timeout: number?)
	local t0 = os.clock()
	while not DataService.Profiles[player] and player.Parent and os.clock() - t0 < (timeout or 15) do
		task.wait(0.1)
	end
	return DataService.Profiles[player]
end

function DataService.AddCoins(player: Player, amount: number)
	local d = DataService.Profiles[player]
	if not d then return end
	d.Coins = math.max(0, d.Coins + math.floor(amount))
	if amount > 0 then d.Stats.CoinsEarned += math.floor(amount) end
	DataService.Push(player)
end

-- -------------------------------------------------------------------- leaderboard du lobby
local function renderLeaderboard(entries: { { Name: string, Value: number } })
	for _, board in CollectionService:GetTagged("LeaderboardBoard") do
		local sg = board:FindFirstChildOfClass("SurfaceGui")
		local rows = sg and sg:FindFirstChild("Rows")
		if rows then
			for _, c in rows:GetChildren() do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			for i, e in entries do
				if i > 8 then break end
				local medal = if i == 1 then "#FFD23F" elseif i == 2 then "#E2E6EC" elseif i == 3 then "#FF9A4A" else "#FFFFFF"
				local t = UI.Text(rows, ("<font color=\"%s\">#%d</font>  %s  <font color=\"#60E87A\">%d</font>"):format(medal, i, e.Name, e.Value), {
					Name = "Ligne" .. i, Size = UDim2.new(1, 0, 0, 48), AnchorPoint = Vector2.zero, Position = UDim2.new(),
					AlignX = Enum.TextXAlignment.Left, Max = 38, Rich = true, Thickness = 3,
				})
				t.LayoutOrder = i
			end
			if #entries == 0 then
				UI.Text(rows, "Joue une manche pour apparaître ici !", { Size = UDim2.new(1, 0, 0, 48), AnchorPoint = Vector2.zero,
					Position = UDim2.new(), Max = 32, Font = "Bold" })
			end
		end
	end
end

local function refreshLeaderboard()
	local entries = {}
	local ok = false
	if ordered then
		ok = pcall(function()
			local pages = ordered:GetSortedAsync(false, 8)
			for _, item in pages:GetCurrentPage() do
				local id = tonumber(string.match(item.key, "%d+"))
				local name = "?"
				if id then
					local okName, n = pcall(Players.GetNameFromUserIdAsync, Players, id)
					if okName then name = n end
				end
				table.insert(entries, { Name = name, Value = item.value })
			end
		end)
	end
	if not ok then
		-- repli : joueurs présents sur le serveur
		for p, d in DataService.Profiles do
			table.insert(entries, { Name = p.Name, Value = d.Stats.TailsTaken })
		end
		table.sort(entries, function(a, b) return a.Value > b.Value end)
	end
	renderLeaderboard(entries)
end

-- -------------------------------------------------------------------- init
function DataService.Init()
	Players.PlayerAdded:Connect(function(p) task.spawn(DataService.Load, p) end)
	for _, p in Players:GetPlayers() do task.spawn(DataService.Load, p) end

	Players.PlayerRemoving:Connect(function(p)
		DataService.Save(p)
		DataService.Profiles[p] = nil
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then return end
		local pending = 0
		for _, p in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataService.Save(p)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do task.wait(0.1) end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutoSaveInterval)
			for _, p in Players:GetPlayers() do task.spawn(DataService.Save, p) end
		end
	end)

	task.spawn(function()
		task.wait(3)
		while true do
			refreshLeaderboard()
			task.wait(Config.Data.LeaderboardRefresh)
		end
	end)

	Remotes.TutorialDone.OnServerEvent:Connect(function(player)
		local d = DataService.Profiles[player]
		if d and not d.TutorialDone then
			d.TutorialDone = true
			DataService.Push(player)
		end
	end)

	Remotes.GetProfile.OnServerInvoke = function(player)
		DataService.Wait(player, 10)
		return DataService.Snapshot(player)
	end
end

DataService.RefreshLeaderboard = refreshLeaderboard

return DataService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000024"><Properties><string name="Name">GameManager</string><ProtectedString name="Source"><![CDATA[--[[
	GameManager - point d'entrée serveur de TAIL CHASE.
	Construit la map, initialise les services et fait tourner la boucle :
		Lobby -> Intermission (20 s, min joueurs prêts) -> Countdown (5 s, figés) -> Round (3 min) -> Results (10 s) -> Lobby

	État répliqué via les Attributes de ReplicatedStorage (lus par l'UI) :
		GameState, EndsAt (temps serveur), ReadyCount, MinPlayers, RunnersLeft, HuntersCount, HuntersReleaseAt
	Captures : détectées et validées UNIQUEMENT ici (distance horizontale + verticale, ligne de vue, cooldown,
	immunité anti-chaîne, état de manche). Le client ne peut pas déclarer une capture.
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MapBuilder = require(script.Parent.MapBuilder)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local TailService = require(script.Parent.TailService)
local RoleService = require(script.Parent.RoleService)
local CoinService = require(script.Parent.CoinService)
local MovementService = require(script.Parent.MovementService)
local AdminService = require(script.Parent.AdminService)
local Control = AdminService.Control

local S = Config.States
local MIN_PLAYERS = if RunService:IsStudio() then Config.StudioMinPlayers else Config.MinPlayers

-- =====================================================================
-- INIT
-- =====================================================================
MapBuilder.Build()
DataService.Init()
ShopService.Init()
TailService.Init()
MovementService.Init()
AdminService.Init()

ReplicatedStorage:SetAttribute("MinPlayers", MIN_PLAYERS)
ReplicatedStorage:SetAttribute("MapCatalog", HttpService:JSONEncode(MapBuilder.Catalog()))

local function now(): number
	return workspace:GetServerTimeNow()
end

local function setState(state: string, duration: number?)
	ReplicatedStorage:SetAttribute("GameState", state)
	ReplicatedStorage:SetAttribute("EndsAt", if duration then now() + duration else 0)
	Remotes.RoundState:FireAllClients(state, duration or 0)
end

local function notifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

local function rootOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function shuffle<T>(t: { T }): { T }
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local function teleport(player: Player, cf: CFrame)
	local char = player.Character
	if char then
		char:PivotTo(cf)
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then root.AssemblyLinearVelocity = Vector3.zero end
	end
end

local function randomMapSpawn(): CFrame
	local spawns = MapBuilder.GetMapSpawns()
	if #spawns == 0 then return CFrame.new(0, 6, 0) end
	local s = spawns[math.random(1, #spawns)]
	return s.CFrame + Vector3.new(0, 3.5, 0)
end

-- =====================================================================
-- VOTE DE MAP (pendant l'intermission)
-- Attributes : VoteOptions (JSON de N ids), Votes_<id> (compte). Remote MapVote(id) validé ici.
-- =====================================================================
local votes: { [Player]: string } = {}
local voteOptions: { string } = {}

local function clearVote()
	for _, id in voteOptions do ReplicatedStorage:SetAttribute("Votes_" .. id, nil) end
	table.clear(votes)
	table.clear(voteOptions)
	ReplicatedStorage:SetAttribute("VoteOptions", nil)
end

local function startVote()
	clearVote()
	local pool = {}
	for _, m in MapBuilder.Maps do table.insert(pool, m.Id) end
	shuffle(pool)
	for i = 1, math.min(Config.VoteOptions, #pool) do
		table.insert(voteOptions, pool[i])
		ReplicatedStorage:SetAttribute("Votes_" .. pool[i], 0)
	end
	ReplicatedStorage:SetAttribute("VoteOptions", HttpService:JSONEncode(voteOptions))
end

local function recount()
	local counts = {}
	for _, id in voteOptions do counts[id] = 0 end
	for p, id in votes do
		if p.Parent and counts[id] then counts[id] += 1 end
	end
	for id, n in counts do ReplicatedStorage:SetAttribute("Votes_" .. id, n) end
	return counts
end

--- Termine le vote et retourne la map gagnante (égalité : tirage au sort ; pas de vote : map au hasard).
local function finishVote(): string
	local pool = if #voteOptions > 0 then table.clone(voteOptions) else {}
	if #pool == 0 then
		for _, m in MapBuilder.Maps do table.insert(pool, m.Id) end
	end
	local counts = recount()
	local best, bestN = {}, -1
	for _, id in pool do
		local n = counts[id] or 0
		if n > bestN then best, bestN = { id }, n elseif n == bestN then table.insert(best, id) end
	end
	clearVote()
	return best[math.random(1, #best)]
end

Remotes.MapVote.OnServerEvent:Connect(function(player: Player, id: any)
	if typeof(id) ~= "string" or not table.find(voteOptions, id) then return end
	if ReplicatedStorage:GetAttribute("GameState") ~= S.Intermission then return end
	votes[player] = id
	recount()
end)
Players.PlayerRemoving:Connect(function(p)
	if votes[p] then votes[p] = nil; recount() end
end)

-- =====================================================================
-- MANCHE
-- =====================================================================
type PData = { Role: string, StartedAsRunner: boolean, CapturedAt: number?, Tails: number, LastCapture: number, ImmuneUntil: number }
type Round = { Players: { [Player]: PData }, GoTime: number, Active: boolean, LastCaptured: Player?, Released: boolean }

local round: Round? = nil

local function readyPlayers(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Ready") and p.Character and DataService.Get(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function countRoles(): (number, number)
	local runners, hunters = 0, 0
	if round then
		for _, d in round.Players do
			if d.Role == "Runner" then runners += 1 elseif d.Role == "Hunter" then hunters += 1 end
		end
	end
	return runners, hunters
end

local function updateCounts()
	local r, h = countRoles()
	ReplicatedStorage:SetAttribute("RunnersLeft", r)
	ReplicatedStorage:SetAttribute("HuntersCount", h)
end

--- Capture validée : la queue est arrachée, le participant devient chasseur.
local function capture(hunter: Player, runner: Player)
	local r = round
	if not r then return end
	local hd, rd = r.Players[hunter], r.Players[runner]
	if not hd or not rd or rd.Role ~= "Runner" or hd.Role ~= "Hunter" then return end
	local t = os.clock()

	rd.Role = "Hunter"
	rd.CapturedAt = now()
	rd.ImmuneUntil = t + Config.NewHunterImmunity
	r.LastCaptured = runner
	hd.Tails += 1
	hd.LastCapture = t

	hunter:SetAttribute("TailsTaken", hd.Tails)
	runner:SetAttribute("ImmuneUntil", now() + Config.NewHunterImmunity)

	local tailCF, skin = TailService.Remove(runner)
	RoleService.Set(runner, "Hunter")
	MovementService.EndSlide(runner)

	local hdata = DataService.Get(hunter)
	local fx = hdata and hdata.Equipped.Capture or "capture_default"
	Remotes.Captured:FireAllClients(hunter, runner, skin, fx, tailCF)
	notifyAll(("%s est devenu chasseur !"):format(runner.DisplayName), "hunter")
	Remotes.Notify:FireClient(hunter, ("Tu as pris une queue ! +%d"):format(Config.Coins.PerTail), "success")
	Remotes.Notify:FireClient(runner, "On t'a arraché ta queue ! À toi de chasser !", "danger")
	updateCounts()
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function checkCaptures()
	local r = round
	if not r or not r.Released then return end
	local t = os.clock()
	local chars = {}
	for p in r.Players do
		if p.Character then table.insert(chars, p.Character) end
	end
	rayParams.FilterDescendantsInstances = chars

	for hunter, hd in r.Players do
		if hd.Role == "Hunter" and t >= hd.ImmuneUntil and t - hd.LastCapture >= Config.HunterCaptureCooldown
			and not hunter:GetAttribute("Frozen") then
			local hr = rootOf(hunter)
			if hr then
				for runner, rd in r.Players do
					if rd.Role == "Runner" and runner ~= hunter then
						local rr = rootOf(runner)
						if rr then
							local d = rr.Position - hr.Position
							local flat = Vector3.new(d.X, 0, d.Z).Magnitude
							if flat <= Config.CaptureDistance and math.abs(d.Y) <= Config.CaptureVerticalMax then
								-- ligne de vue : pas de capture à travers un mur / plafond de tunnel
								local hit = workspace:Raycast(hr.Position, d, rayParams)
								if not hit then
									capture(hunter, runner)
									break
								end
							end
						end
					end
				end
			end
		end
	end
end

local function endRound()
	local r = round
	if not r then return end
	r.Active = false
	local tEnd = now()
	local survivors = {}
	for p, d in r.Players do
		if d.Role == "Runner" and p.Parent then table.insert(survivors, p) end
	end

	local rows = {}
	local mine = {}
	for p, d in r.Players do
		if p.Parent then
			local survival = if d.StartedAsRunner then math.max(0, (d.CapturedAt or tEnd) - r.GoTime) else 0
			local survived = d.Role == "Runner"
			local isLast = if #survivors > 0 then survived else (p == r.LastCaptured)
			local b = CoinService.Reward(p, survival, d.Tails, isLast, survived)
			mine[p] = { Survival = survival, Tails = d.Tails, Coins = b, LastSurvivor = isLast, Survived = survived }
			table.insert(rows, { Name = p.DisplayName, UserId = p.UserId, Survival = math.floor(survival), Tails = d.Tails,
				Coins = b.Total, Survived = survived, LastSurvivor = isLast })
		end
	end
	table.sort(rows, function(a, b)
		if a.Survival ~= b.Survival then return a.Survival > b.Survival end
		return a.Tails > b.Tails
	end)

	setState(S.Results, Config.ResultsTime)
	local headline = if #survivors > 0
		then (if #survivors == 1 then survivors[1].DisplayName .. " a survécu !" else #survivors .. " survivants !")
		else "Les chasseurs ont tout pris !"
	for p, m in mine do
		Remotes.Results:FireClient(p, { Rows = rows, Mine = m, Headline = headline })
	end

	-- retour au lobby (éclairage de jour, même après une map de nuit)
	game:GetService("Lighting").ClockTime = 15.2
	for p in r.Players do
		if p.Parent then
			RoleService.SetFrozen(p, false)
			p:SetAttribute("TailsTaken", 0)
			p:SetAttribute("ImmuneUntil", 0)
			MovementService.EndSlide(p)
			RoleService.Set(p, "Lobby")
			teleport(p, MapBuilder.GetLobbySpawn())
		end
	end
	round = nil
	updateCounts()
	DataService.RefreshLeaderboard()
	task.wait(Config.ResultsTime)
end

local function runRound(mapId: string)
	local forced = Control.ForceStart
	Control.ForceStart = false
	Control.ForceEnd = false
	local participants = shuffle(readyPlayers())
	-- lancement admin : on accepte une manche solo (sans chasseur) pour tester
	if #participants < (if forced then 1 else MIN_PLAYERS) then return end

	-- construit la map gagnante du vote (détruit l'ancienne)
	local def = MapBuilder.LoadMap(mapId)
	notifyAll(("Map : %s !"):format(def.Name), "go")

	local hunterCount = if #participants > Config.ExtraHunterThreshold then 2 else 1
	if #participants < 2 then hunterCount = 0 end -- (lancement admin en solo : manche sans chasseur)
	local spawns = shuffle(MapBuilder.GetMapSpawns())
	local r: Round = { Players = {}, GoTime = 0, Active = true, LastCaptured = nil, Released = false }
	round = r

	for i, p in participants do
		local role = if i <= hunterCount then "Hunter" else "Runner"
		r.Players[p] = { Role = role, StartedAsRunner = role == "Runner", CapturedAt = nil, Tails = 0, LastCapture = 0, ImmuneUntil = 0 }
		p:SetAttribute("TailsTaken", 0)
		RoleService.SetFrozen(p, true)
		RoleService.Set(p, role)
		local sp = spawns[((i - 1) % math.max(#spawns, 1)) + 1]
		teleport(p, if sp then sp.CFrame + Vector3.new(0, 3.5, 0) else randomMapSpawn())
		Remotes.RoleAssigned:FireClient(p, role, Config.CountdownTime)
	end
	updateCounts()
	setState(S.Countdown, Config.CountdownTime)
	task.wait(Config.CountdownTime)

	-- GO : les participants partent, les chasseurs attendent un peu
	r.GoTime = now()
	ReplicatedStorage:SetAttribute("HuntersReleaseAt", now() + Config.HunterReleaseDelay)
	for p, d in r.Players do
		if d.Role == "Runner" and p.Parent then RoleService.SetFrozen(p, false) end
	end
	local roundTime = AdminService.RoundTime()
	setState(S.Round, roundTime)
	notifyAll("GO ! Fuyez !", "go")
	task.delay(Config.HunterReleaseDelay, function()
		if round ~= r or not r.Active then return end
		r.Released = true
		for p, d in r.Players do
			if d.Role == "Hunter" and p.Parent then RoleService.SetFrozen(p, false) end
		end
		notifyAll("Les chasseurs sont lâchés !", "hunter")
	end)

	local endsAt = os.clock() + roundTime
	while r.Active and os.clock() < endsAt do
		if Control.ForceEnd then
			Control.ForceEnd = false
			notifyAll("Manche terminée par un admin", "info")
			break
		end
		checkCaptures()
		local runners, hunters = countRoles()
		if runners == 0 and hunterCount > 0 then break end
		-- plus aucun chasseur (déconnexions) : un participant au hasard prend le rôle
		if hunters == 0 and hunterCount > 0 then
			if runners >= 2 then
				local pool = {}
				for p, d in r.Players do if d.Role == "Runner" then table.insert(pool, p) end end
				local p = pool[math.random(1, #pool)]
				r.Players[p].Role = "Hunter"
				r.Players[p].CapturedAt = now()
				r.Players[p].ImmuneUntil = os.clock() + Config.NewHunterImmunity
				TailService.Remove(p)
				RoleService.Set(p, "Hunter")
				notifyAll(p.DisplayName .. " devient chasseur !", "hunter")
				updateCounts()
			else
				break
			end
		end
		local count = 0
		for p in r.Players do if p.Parent then count += 1 end end
		if count == 0 then break end
		task.wait(Config.CaptureCheckRate)
	end
	endRound()
end

-- =====================================================================
-- JOUEURS
-- =====================================================================
local function onCharacter(player: Player, char: Model)
	char:WaitForChild("HumanoidRootPart", 10)
	char:WaitForChild("Humanoid", 10)
	if not char.Parent then return end
	task.wait() -- laisse le personnage se poser
	local r = round
	if r and r.Players[player] then
		teleport(player, randomMapSpawn())
		if r.Players[player].Role == "Runner" and not TailService.Has(player) then
			-- (re)spawn d'un participant : il garde son rôle
		end
	else
		if player:GetAttribute("Role") ~= "Lobby" then player:SetAttribute("Role", "Lobby") end
	end
	RoleService.ApplyVisuals(player)
end

local function onPlayer(player: Player)
	player:SetAttribute("Role", "Lobby")
	player:SetAttribute("Ready", false)
	player:SetAttribute("TailsTaken", 0)
	player.CharacterAdded:Connect(function(c) onCharacter(player, c) end)
	player.CharacterAppearanceLoaded:Connect(function()
		RoleService.ApplyVisuals(player) -- les parties du corps peuvent avoir été remplacées
	end)
	if player.Character then task.spawn(onCharacter, player, player.Character) end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end

Players.PlayerRemoving:Connect(function(p)
	if round and round.Players[p] then
		round.Players[p] = nil
		updateCounts()
	end
end)

DataService.ProfileLoaded:Connect(function(player: Player)
	RoleService.ApplyVisuals(player)
end)

Remotes.SetReady.OnServerEvent:Connect(function(player: Player, ready: any)
	player:SetAttribute("Ready", ready == true)
end)

if MapBuilder.ShopPrompt then
	MapBuilder.ShopPrompt.Triggered:Connect(function(player)
		Remotes.OpenMenu:FireClient(player, "Shop")
	end)
end

-- kill plane : tout joueur qui tombe est replacé
task.spawn(function()
	while true do
		task.wait(0.25)
		for _, p in Players:GetPlayers() do
			local root = rootOf(p)
			if root and root.Position.Y < Config.KillPlaneY then
				if round and round.Players[p] then
					teleport(p, randomMapSpawn())
				else
					teleport(p, MapBuilder.GetLobbySpawn())
				end
				Remotes.Notify:FireClient(p, "Oups ! Replacé.", "info")
			end
		end
	end
end)

-- =====================================================================
-- BOUCLE PRINCIPALE
-- =====================================================================
while true do
	setState(S.Lobby)
	repeat
		ReplicatedStorage:SetAttribute("ReadyCount", #readyPlayers())
		task.wait(1)
	until #readyPlayers() >= MIN_PLAYERS or Control.ForceStart

	local cancelled = false
	if not Control.ForceStart then
		startVote()
		setState(S.Intermission, Config.IntermissionTime)
		local t0 = os.clock()
		while os.clock() - t0 < Config.IntermissionTime and not Control.ForceStart do
			task.wait(0.25)
			local n = #readyPlayers()
			ReplicatedStorage:SetAttribute("ReadyCount", n)
			if n < MIN_PLAYERS and not Control.ForceStart then
				cancelled = true
				break
			end
		end
	end
	if cancelled then
		clearVote()
		notifyAll("Pas assez de joueurs, retour à l'attente.", "info")
	else
		local mapId = finishVote()
		local ok, err = pcall(runRound, mapId)
		if not ok then
			warn("[GameManager] erreur pendant la manche :", err)
			-- sécurité : on remet tout le monde au lobby
			for _, p in Players:GetPlayers() do
				RoleService.SetFrozen(p, false)
				RoleService.Set(p, "Lobby")
				teleport(p, MapBuilder.GetLobbySpawn())
			end
			round = nil
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	MapBuilder - génère les maps studded (vote : Ville + les modules de server/Maps) et le lobby.
	Une seule map existe à la fois dans Workspace.Map ; LoadMap(id) détruit l'ancienne et construit la gagnante du vote.
	Le lobby est construit une fois (un modèle Workspace.Lobby déjà présent est réutilisé tel quel).

	Règle anti z-fighting (vérifiée par tests/run.sh) : deux faces de même orientation ne doivent jamais être
	coplanaires ET se recouvrir. Les rampes/ponts (slab) sont surélevés de 0.06 pour ne jamais affleurer leur support.

	Ville - repères (Y = 0 = sol) :
		Place centrale  : centre, anneau surélevé (passerelle) à Y=14, fontaine, rampes, jump pads
		Village (NE)    : 3x3 maisons à toits plats (Y=14) reliés par planches, ruelles avec tunnels de slide
		Toits (SE)      : tours de hauteurs variées, passerelles, jump pads, petit parcours de saut flottant
		Industriel (SO) : conteneurs, échafaudages + passerelle Y=14, gros tunnels de slide dans des blocs-tuyaux
		Jardins (NO)    : haies (labyrinthe à boucles), arbre-plateforme Y=14, étang, haie avec trou de slide
	Chaque zone est reliée à l'anneau central par un pont diagonal à Y=14 -> boucles sur deux niveaux, pas d'impasse.

	Tags (CollectionService) :
		"JumpPad"      Attributes Power (vitesse verticale) / Push (Vector3 horizontal)  -> MovementController
		"SlideCeiling" plafonds de tunnel (CollisionGroup "SlideCeiling", traversés uniquement en slide)
	Dossiers : Map.Spawns (points de départ de manche), Lobby.Spawns (SpawnLocation)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")

local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(ReplicatedStorage.StudUI)

local MapBuilder = {}

local RGB = Color3.fromRGB
local V3 = Vector3.new
local CF = CFrame.new

MapBuilder.LobbyCenter = V3(0, 0, 420)
MapBuilder.RingHeight = 14

-- Palette cohérente (couleurs vives, chaudes)
local PAL = {
	Road = RGB(78, 84, 102),
	RoadLine = RGB(255, 214, 60),
	Plaza = RGB(242, 214, 160),
	PlazaAlt = RGB(226, 186, 128),
	Grass = RGB(110, 200, 70),
	GrassDark = RGB(70, 160, 50),
	Hedge = RGB(50, 140, 60),
	Leaves = RGB(90, 200, 70),
	Trunk = RGB(140, 90, 50),
	Water = RGB(60, 170, 255),
	Concrete = RGB(170, 170, 180),
	Metal = RGB(110, 115, 130),
	Wall = RGB(255, 120, 80),
	Ring = RGB(255, 80, 110),
	Bridge = RGB(255, 190, 40),
	Pad = RGB(60, 255, 120),
	Neon1 = RGB(0, 230, 255),
	Neon2 = RGB(255, 60, 200),
	White = RGB(250, 250, 250),
	Houses = { RGB(255, 160, 160), RGB(160, 210, 255), RGB(255, 230, 140), RGB(190, 255, 170), RGB(230, 180, 255), RGB(255, 200, 150) },
	Roofs = { RGB(220, 70, 60), RGB(60, 120, 220), RGB(240, 150, 30), RGB(60, 170, 90) },
	Containers = { RGB(230, 60, 50), RGB(40, 120, 230), RGB(255, 190, 30), RGB(50, 180, 90), RGB(240, 110, 30) },
	Towers = { RGB(120, 200, 255), RGB(255, 140, 200), RGB(255, 210, 90), RGB(150, 255, 200) },
}

-- =====================================================================
-- HELPERS
-- =====================================================================
local SIDES = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }

local function studs(p: BasePart, sides: boolean?)
	local function add(face)
		local t = Instance.new("Texture")
		t.Name = "Studs"
		t.Texture = Config.StudTexture
		t.Face = face
		t.StudsPerTileU = 1
		t.StudsPerTileV = 1
		t.Transparency = 0.6
		t.Parent = p
	end
	add(Enum.NormalId.Top)
	if sides then
		for _, f in SIDES do add(f) end
	end
end

type PartOpts = {
	Name: string?, Material: Enum.Material?, Shape: Enum.PartType?, CanCollide: boolean?, Transparency: number?,
	Sides: boolean?, NoStuds: boolean?, Tag: string?, CastShadow: boolean?,
}

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, o: PartOpts?): Part
	local opts: PartOpts = o or {}
	local p = Instance.new("Part")
	p.Name = opts.Name or "Part"
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = opts.Material or Enum.Material.Plastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts.Shape then p.Shape = opts.Shape end
	if opts.CanCollide == false then p.CanCollide = false end
	if opts.Transparency then p.Transparency = opts.Transparency end
	if opts.CastShadow == false then p.CastShadow = false end
	if not opts.NoStuds and p.Material ~= Enum.Material.Neon and p.Material ~= Enum.Material.Glass then
		studs(p, opts.Sides ~= false and (size.Y >= 3))
	end
	if opts.Tag then CollectionService:AddTag(p, opts.Tag) end
	p.Parent = parent
	return p
end

--- Bloc posé au sol : (x, z) centre, taille, hauteur de base y0.
local function block(parent, x, z, sx, sy, sz, color, y0, o)
	return part(parent, V3(sx, sy, sz), CF(x, (y0 or 0) + sy / 2, z), color, o)
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

--- Rampe/pont entre deux points (dessus de la dalle = segment a->b).
local function slab(parent, a: Vector3, b: Vector3, width: number, color: Color3, thick: number?, name: string?)
	local t = thick or 1
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	-- +0.06 : le dessus ne coïncide jamais avec le sol / toit sur lequel il s'appuie (anti z-fighting)
	cf = cf * CF(0, -t / 2 + 0.06, 0)
	return part(parent, V3(width, t, len), cf, color, { Name = name or "Rampe", Sides = false })
end

local function railing(parent, a: Vector3, b: Vector3, color: Color3)
	local len = (b - a).Magnitude
	local mid = (a + b) / 2 + V3(0, 0.75, 0)
	return part(parent, V3(0.6, 1.5, len), CFrame.lookAt(mid, b + V3(0, 0.75, 0)), color, { Name = "Rambarde", NoStuds = true })
end

local function pillar(parent, x, z, h, r, color, y0)
	return part(parent, V3(h, r * 2, r * 2), CF(x, (y0 or 0) + h / 2, z) * CFrame.Angles(0, 0, math.rad(90)), color,
		{ Name = "Pilier", Shape = Enum.PartType.Cylinder, NoStuds = true })
end

local function jumpPad(parent, pos: Vector3, power: number, push: Vector3?)
	local base = part(parent, V3(0.6, 7, 7), CF(pos + V3(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), RGB(30, 40, 50),
		{ Name = "JumpPadSocle", Shape = Enum.PartType.Cylinder, NoStuds = true })
	local pad = part(parent, V3(0.4, 5.6, 5.6), CF(pos + V3(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), PAL.Pad,
		{ Name = "JumpPad", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Tag = "JumpPad" })
	pad:SetAttribute("Power", power)
	pad:SetAttribute("Push", push or Vector3.zero)
	local att = Instance.new("Attachment")
	att.Parent = pad
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Fleches"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(PAL.Pad)
	pe.Size = NumberSequence.new(0.6, 0)
	pe.Lifetime = NumberRange.new(0.6, 0.9)
	pe.Rate = 12
	pe.Speed = NumberRange.new(8, 12)
	pe.SpreadAngle = Vector2.new(10, 10)
	pe.EmissionDirection = Enum.NormalId.Right -- axe du cylindre tourné = haut
	pe.LightEmission = 1
	pe.Parent = att
	return pad, base
end

local function lamp(parent, x, z, y0, color)
	local y = y0 or 0
	pillar(parent, x, z, 9, 0.35, RGB(40, 44, 56), y)
	local head = part(parent, V3(1.6, 1.2, 1.6), CF(x, y + 9.4, z), color or RGB(255, 230, 150),
		{ Name = "Lampe", Material = Enum.Material.Neon, CastShadow = false })
	part(parent, V3(2.2, 0.4, 2.2), CF(x, y + 10.2, z), RGB(40, 44, 56), { Name = "Chapeau", NoStuds = true })
	local l = Instance.new("PointLight")
	l.Color = color or RGB(255, 210, 140)
	l.Range = 22
	l.Brightness = 1.4
	l.Shadows = false
	l.Parent = head
end

local function tree(parent, x, z, scale, y0)
	local s = scale or 1
	local y = y0 or 0
	block(parent, x, z, 1.6 * s, 6 * s, 1.6 * s, PAL.Trunk, y, { Name = "Tronc" })
	block(parent, x, z, 7 * s, 4 * s, 7 * s, PAL.Leaves, y + 5.5 * s, { Name = "Feuillage", Sides = true })
	block(parent, x, z, 4.6 * s, 3 * s, 4.6 * s, PAL.GrassDark:Lerp(PAL.Leaves, 0.5), y + 9.5 * s, { Name = "Feuillage" })
end

local function bench(parent, x, z, rotY, y0)
	local y = y0 or 0
	local base = CF(x, y, z) * CFrame.Angles(0, math.rad(rotY or 0), 0)
	part(parent, V3(5, 0.5, 1.6), base * CF(0, 1.4, 0), RGB(200, 120, 60), { Name = "Banc" })
	part(parent, V3(4.8, 1.4, 0.4), base * CF(0, 2.3, 0.7), RGB(200, 120, 60), { Name = "Dossier" })
	part(parent, V3(0.5, 1.2, 1.4), base * CF(-2.1, 0.6, 0), RGB(50, 50, 60), { Name = "Pied", NoStuds = true })
	part(parent, V3(0.5, 1.2, 1.4), base * CF(2.1, 0.6, 0), RGB(50, 50, 60), { Name = "Pied", NoStuds = true })
end

local function neonStrip(parent, size: Vector3, cf: CFrame, color: Color3)
	return part(parent, size, cf, color, { Name = "Neon", Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
end

--[[ Bloc avec tunnel de slide traversant. axis = "X" ou "Z" (sens du tunnel). Ouverture : 5 de large, 3 de haut.
	Le plafond (et tout le haut du bloc) est dans le CollisionGroup "SlideCeiling" : seul un joueur en slide passe. ]]
local TUNNEL_W, TUNNEL_H = 5, 3
local function slideBlock(parent, center: Vector3, length: number, width: number, height: number, color: Color3, axis: string)
	local m = Instance.new("Model")
	m.Name = "TunnelSlide"
	m.Parent = parent
	local side = (width - TUNNEL_W) / 2
	local alongX = axis == "X"
	local function sz(along, across, h)
		return if alongX then V3(along, h, across) else V3(across, h, along)
	end
	local function off(across)
		return if alongX then V3(0, 0, across) else V3(across, 0, 0)
	end
	-- murs latéraux
	local y = center.Y
	part(m, sz(length, side, height), CF(V3(center.X, y + height / 2, center.Z) + off(-(TUNNEL_W / 2 + side / 2))), color, { Name = "Mur" })
	part(m, sz(length, side, height), CF(V3(center.X, y + height / 2, center.Z) + off(TUNNEL_W / 2 + side / 2)), color, { Name = "Mur" })
	-- plafond (traversable en slide uniquement)
	local ceil = part(m, sz(length, TUNNEL_W, height - TUNNEL_H), CF(center.X, y + TUNNEL_H + (height - TUNNEL_H) / 2, center.Z), color,
		{ Name = "Plafond", Tag = "SlideCeiling" })
	ceil.CollisionGroup = "SlideCeiling"
	-- intérieur sombre + bandes néon pour signaler l'entrée
	part(m, sz(length - 0.2, TUNNEL_W - 0.1, 0.1), CF(center.X, y + TUNNEL_H - 0.05, center.Z), RGB(30, 30, 40),
		{ Name = "Ombre", CanCollide = false, NoStuds = true, CastShadow = false })
	for _, s in { -1, 1 } do
		local endOff = if alongX then V3(s * (length / 2 + 0.05), 0, 0) else V3(0, 0, s * (length / 2 + 0.05))
		neonStrip(m, sz(0.2, TUNNEL_W + 0.6, 0.3), CF(V3(center.X, y + TUNNEL_H + 0.25, center.Z) + endOff), PAL.Neon1)
		-- panneau "SLIDE" au dessus de l'entrée
		local sign = part(m, sz(0.3, 4.5, 1.6), CF(V3(center.X, y + math.min(height - 0.9, TUNNEL_H + 1.4), center.Z) + endOff * 1.01), RGB(20, 24, 32),
			{ Name = "PanneauSlide", NoStuds = true, CanCollide = false })
		local face
		if alongX then face = if s > 0 then Enum.NormalId.Right else Enum.NormalId.Left
		else face = if s > 0 then Enum.NormalId.Back else Enum.NormalId.Front end
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.Parent = sign
		UI.Text(sg, "SLIDE  [C]", { Size = UDim2.fromScale(1, 1), Max = 44, Color = PAL.Neon1, Stroke = RGB(0, 30, 40), Thickness = 3, Font = "Gotham" })
	end
	return m
end

local function sign(parent: Instance, size: Vector3, cf: CFrame, face: Enum.NormalId, ppu: number?): (Part, SurfaceGui)
	local p = part(parent, size, cf, RGB(22, 26, 36), { Name = "Panneau", NoStuds = true })
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = ppu or 50
	sg.LightInfluence = 0.2
	sg.Parent = p
	return p, sg
end
MapBuilder.Sign = sign

local function spawnPoint(spawns: Folder, pos: Vector3)
	local s = part(spawns, V3(4, 0.2, 4), CF(pos + V3(0, 0.1, 0)), RGB(255, 255, 255),
		{ Name = "MapSpawn", CanCollide = false, Transparency = 1, NoStuds = true })
	s.CanQuery = false
	s.CanTouch = false
end

-- =====================================================================
-- ZONES
-- =====================================================================
local function buildGround(map)
	local g = folder(map, "Sol")
	-- base (routes)
	part(g, V3(300, 4, 300), CF(0, -2, 0), PAL.Road, { Name = "Route", Sides = false })
	-- marquages de route
	for i = -3, 3 do
		if i ~= 0 and math.abs(i) ~= 2 then
			part(g, V3(6, 0.1, 1), CF(i * 20, 0.05, 43), PAL.RoadLine, { Name = "Marquage", NoStuds = true, CanCollide = false })
			part(g, V3(6, 0.1, 1), CF(i * 20, 0.05, -43), PAL.RoadLine, { Name = "Marquage", NoStuds = true, CanCollide = false })
			part(g, V3(1, 0.1, 6), CF(43, 0.05, i * 20), PAL.RoadLine, { Name = "Marquage", NoStuds = true, CanCollide = false })
			part(g, V3(1, 0.1, 6), CF(-43, 0.05, i * 20), PAL.RoadLine, { Name = "Marquage", NoStuds = true, CanCollide = false })
		end
	end
	-- dalles de zones (léger trottoir de 0.4)
	part(g, V3(70, 0.4, 70), CF(0, 0.2, 0), PAL.Plaza, { Name = "Place" })
	part(g, V3(30, 0.1, 30), CF(0, 0.45, 0), PAL.PlazaAlt, { Name = "PlaceCentre", Sides = false })
	part(g, V3(96, 0.4, 96), CF(99, 0.2, -99), RGB(200, 230, 150), { Name = "SolVillage" })
	part(g, V3(96, 0.4, 96), CF(99, 0.2, 99), RGB(150, 160, 190), { Name = "SolToits" })
	part(g, V3(96, 0.4, 96), CF(-99, 0.2, 99), PAL.Concrete, { Name = "SolIndustriel" })
	part(g, V3(96, 0.4, 96), CF(-99, 0.2, -99), PAL.Grass, { Name = "SolJardins" })

	-- murs d'enceinte (hauts, colorés, néon en haut)
	local walls = folder(map, "Enceinte")
	for i, w in {
		{ V3(308, 40, 4), CF(0, 20, -152) }, { V3(308, 40, 4), CF(0, 20, 152) },
		{ V3(4, 40, 300), CF(-152, 20, 0) }, { V3(4, 40, 300), CF(152, 20, 0) },
	} do
		part(walls, w[1], w[2], PAL.Wall, { Name = "Mur" })
		local ns = if i <= 2 then V3(w[1].X + 0.2, 0.8, w[1].Z + 0.2) else V3(w[1].X + 0.2, 0.7, w[1].Z - 0.6)
		neonStrip(walls, ns, w[2] * CF(0, 20.4, 0), PAL.Neon2)
	end
end

local function buildPlaza(map, spawns)
	local z = folder(map, "PlaceCentrale")
	local H = MapBuilder.RingHeight
	-- fontaine
	part(z, V3(2, 22, 22), CF(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(90)), PAL.White, { Name = "Bassin", Shape = Enum.PartType.Cylinder, NoStuds = true })
	part(z, V3(0.4, 19, 19), CF(0, 2.3, 0) * CFrame.Angles(0, 0, math.rad(90)), PAL.Water,
		{ Name = "Eau", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Glass, Transparency = 0.25, NoStuds = true })
	pillar(z, 0, 0, 7, 1.2, PAL.White, 0.4)
	local top = part(z, V3(1.5, 5, 5), CF(0, 8.2, 0) * CFrame.Angles(0, 0, math.rad(90)), PAL.Neon1,
		{ Name = "Jet", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon })
	local att = Instance.new("Attachment"); att.Parent = top
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Color = ColorSequence.new(RGB(180, 230, 255))
	pe.Size = NumberSequence.new(1.2, 0.2)
	pe.Transparency = NumberSequence.new(0.3, 1)
	pe.Lifetime = NumberRange.new(1, 1.4)
	pe.Rate = 30
	pe.Speed = NumberRange.new(10, 14)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = V3(0, -25, 0)
	pe.EmissionDirection = Enum.NormalId.Right
	pe.Parent = att

	-- anneau surélevé (passerelle) Y = 14
	local R, Wd = 32, 6
	local ring = folder(z, "Anneau")
	part(ring, V3(2 * R + Wd, 1, Wd), CF(0, H - 0.5, -R), PAL.Ring, { Name = "AnneauN", Sides = false })
	part(ring, V3(2 * R + Wd, 1, Wd), CF(0, H - 0.5, R), PAL.Ring, { Name = "AnneauS", Sides = false })
	part(ring, V3(Wd, 1, 2 * R - Wd), CF(R, H - 0.5, 0), PAL.Ring, { Name = "AnneauE", Sides = false })
	part(ring, V3(Wd, 1, 2 * R - Wd), CF(-R, H - 0.5, 0), PAL.Ring, { Name = "AnneauO", Sides = false })
	neonStrip(ring, V3(2 * R + Wd - 0.6, 0.3, 0.3), CF(0, H - 1.1, -R - Wd / 2), PAL.Neon1)
	neonStrip(ring, V3(2 * R + Wd - 0.6, 0.3, 0.3), CF(0, H - 1.1, R + Wd / 2), PAL.Neon1)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			pillar(ring, sx * R, sz * R, H - 1, 1.1, PAL.White)
		end
		pillar(ring, sx * R, 0, H - 1, 0.9, PAL.White)
		pillar(ring, 12, sx * R, H - 1, 0.9, PAL.White)
		pillar(ring, -12, sx * R, H - 1, 0.9, PAL.White)
	end
	-- rambardes extérieures (on peut sauter par dessus)
	railing(ring, V3(-R + 4, H, -R - Wd / 2 + 0.3), V3(R - 4, H, -R - Wd / 2 + 0.3), PAL.White)
	railing(ring, V3(-R + 4, H, R + Wd / 2 - 0.3), V3(R - 4, H, R + Wd / 2 - 0.3), PAL.White)
	-- rampes d'accès (4)
	for _, sx in { -1, 1 } do
		slab(ring, V3(sx * 18, 0.4, 0), V3(sx * 18, H, -R + Wd / 2), 5, PAL.PlazaAlt, 1, "RampeN")
		slab(ring, V3(-sx * 18, 0.4, 0), V3(-sx * 18, H, R - Wd / 2), 5, PAL.PlazaAlt, 1, "RampeS")
	end
	-- jump pads vers l'anneau Nord / Sud
	jumpPad(z, V3(0, 0.4, 20), 80, V3(0, 0, 20))
	jumpPad(z, V3(0, 0.4, -20), 80, V3(0, 0, -20))

	-- ponts diagonaux vers les 4 zones (Y = 14)
	for _, d in { { 1, -1 }, { 1, 1 }, { -1, 1 }, { -1, -1 } } do
		local a = V3(d[1] * (R - 1), H, d[2] * (R - 1))
		local b = V3(d[1] * 61, H, d[2] * 61)
		local br = slab(z, a, b, 5, PAL.Bridge, 1, "Pont")
		_ = br
		local side = (b - a).Unit:Cross(V3(0, 1, 0)) * 2.5
		railing(z, a + side + (b - a).Unit * 3, b + side - (b - a).Unit * 3, PAL.White)
		railing(z, a - side + (b - a).Unit * 3, b - side - (b - a).Unit * 3, PAL.White)
		pillar(z, (a.X + b.X) / 2, (a.Z + b.Z) / 2, H - 1, 0.8, PAL.White)
	end

	-- déco : lampadaires, bancs, arbres en bacs
	for _, p in { { 24, 24 }, { -24, 24 }, { 24, -24 }, { -24, -24 } } do
		lamp(z, p[1], p[2], 0.4)
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.pi / 8
		bench(z, math.cos(a) * 14.5, math.sin(a) * 14.5, -math.deg(a) + 90, 0.4)
	end
	for _, p in { { 10, 27 }, { -10, 27 }, { 10, -27 }, { -10, -27 } } do
		block(z, p[1], p[2], 5, 1.2, 5, RGB(160, 100, 60), 0.4, { Name = "Bac" })
		tree(z, p[1], p[2], 0.7, 1.6)
	end
	-- un tunnel de slide en raccourci sous l'anneau Nord (bloc décoratif "kiosque")
	slideBlock(z, V3(0, 0.4, -R + 0.5), 7, 14, 6.5, RGB(255, 170, 60), "Z")

	for _, p in { { 14, 20 }, { -14, 20 }, { 14, -20 }, { -14, -20 } } do
		spawnPoint(spawns, V3(p[1], 0.4, p[2]))
	end
	for _, p in { { 0, 45 }, { 0, -45 }, { 45, 0 }, { -45, 0 } } do
		spawnPoint(spawns, V3(p[1], 0, p[2]))
	end
	-- lampadaires des routes
	for i = -3, 3 do
		if i ~= 0 then
			lamp(z, i * 40, 37.5, 0)
			lamp(z, i * 40, -37.5, 0)
		end
	end
end

local function buildVillage(map, spawns)
	local z = folder(map, "Village")
	local H = MapBuilder.RingHeight
	local centers = { 69, 99, 129 }
	local S = 22
	local k = 0
	for ix, x in centers do
		for iz, zz0 in centers do
			k += 1
			local zc = -zz0
			local col = PAL.Houses[(k % #PAL.Houses) + 1]
			local house = Instance.new("Model")
			house.Name = "Maison" .. k
			house.Parent = z
			block(house, x, zc, S, H - 1, S, col, 0.4, { Name = "Murs" })
			local roofCol = PAL.Roofs[(k % #PAL.Roofs) + 1]
			block(house, x, zc, S + 1, 1, S + 1, roofCol, H - 0.6, { Name = "Toit" })
			-- porte + fenêtres décoratives (sans collision)
			for _, f in { { 0, S / 2 + 0.1 }, { 0, -S / 2 - 0.1 } } do
				part(house, V3(4, 5.9, 0.3), CF(x + 5, 3.45, zc + f[2]), RGB(120, 70, 40), { Name = "Porte", CanCollide = false, NoStuds = true })
				for _, wx in { -7, 7 } do
					part(house, V3(3.5, 3, 0.3), CF(x + wx, 9, zc + f[2]), RGB(170, 230, 255),
						{ Name = "Fenetre", CanCollide = false, Material = Enum.Material.Glass, NoStuds = true, Transparency = 0.1 })
				end
			end
			-- cheminée (obstacle sur le toit) sur une maison sur deux
			if k % 2 == 0 then
				block(house, x + 6, zc - 6, 2.5, 4, 2.5, RGB(170, 80, 60), H + 0.4, { Name = "Cheminee" })
			end
			-- planches entre toits (certaines volontairement absentes : saut de 8 studs, faisable avec dash)
			if ix < 3 and not (ix == 2 and iz == 2) then
				slab(z, V3(x + (S + 1) / 2, H + 0.4, zc), V3(x + 30 - (S + 1) / 2, H + 0.4, zc), 4, PAL.Bridge, 0.8, "Planche")
			end
			if iz < 3 and not (ix == 1 and iz == 2) then
				slab(z, V3(x, H + 0.4, zc - (S + 1) / 2), V3(x, H + 0.4, zc - 30 + (S + 1) / 2), 4, PAL.Bridge, 0.8, "Planche")
			end
		end
	end
	-- rampes d'accès aux toits depuis le sol (côté route)
	slab(z, V3(58 - 26, 0, -99), V3(58 - 0.5, H + 0.4, -99), 6, PAL.PlazaAlt, 1, "RampeVillage")
	slab(z, V3(99, 0, -58 + 26), V3(99, H + 0.4, -58 + 0.5), 6, PAL.PlazaAlt, 1, "RampeVillage")
	-- jump pad dans une ruelle -> toits
	jumpPad(z, V3(84, 0.4, -114), 82, V3(0, 0, 0))
	-- tunnels de slide dans les ruelles (murets de jardin)
	slideBlock(z, V3(84, 0.4, -69), 2.5, 8, 6, RGB(240, 230, 210), "Z")
	slideBlock(z, V3(114, 0.4, -129), 2.5, 8, 6, RGB(240, 230, 210), "Z")
	slideBlock(z, V3(99, 0.4, -114), 2.5, 8, 6, RGB(240, 230, 210), "X")
	-- déco
	for _, p in { { 145, -84 }, { 145, -114 }, { 84, -146 }, { 114, -146 } } do
		tree(z, p[1], p[2], 0.8, 0.4)
	end
	for _, p in { { 66, -55 }, { 132, -55 }, { 55, -120 } } do
		lamp(z, p[1], p[2], 0.4)
	end
	spawnPoint(spawns, V3(84, 0.4, -99))
	spawnPoint(spawns, V3(129, 0.4, -114))
end

local function buildRooftops(map, spawns)
	local z = folder(map, "Toits")
	local S = 18
	-- { x, z, hauteur }
	local towers = {
		{ 69, 69, 14 }, { 99, 69, 20 }, { 129, 69, 26 },
		{ 69, 99, 20 }, { 99, 99, 14 }, { 129, 99, 32 },
		{ 69, 129, 8 }, { 99, 129, 14 }, { 129, 129, 20 },
	}
	for i, t in towers do
		local col = PAL.Towers[(i % #PAL.Towers) + 1]
		local m = Instance.new("Model")
		m.Name = "Tour" .. i
		m.Parent = z
		block(m, t[1], t[2], S, t[3] - 1, S, col, 0.4, { Name = "Tour" })
		block(m, t[1], t[2], S + 0.8, 0.6, S + 0.8, RGB(50, 54, 70), t[3] - 0.6, { Name = "Rebord" })
		-- néons verticaux aux coins
		for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
			neonStrip(m, V3(0.4, t[3] - 2, 0.4), CF(t[1] + c[1] * (S / 2 + 0.2), t[3] / 2, t[2] + c[2] * (S / 2 + 0.2)), if i % 2 == 0 then PAL.Neon1 else PAL.Neon2)
		end
		-- fenêtres néon
		for y = 4, t[3] - 3, 5 do
			neonStrip(m, V3(S - 4, 1.2, 0.2), CF(t[1], y, t[2] - S / 2 - 0.1), RGB(255, 240, 180))
		end
	end
	-- passerelles entre tours de même hauteur / jump pads entre niveaux
	slab(z, V3(78, 14, 69), V3(90, 14, 99), 4, PAL.Bridge, 0.8, "Passerelle")     -- 14 -> 14 (tour 1 -> tour 5)
	slab(z, V3(99, 14, 108), V3(99, 14, 120), 4, PAL.Bridge, 0.8, "Passerelle")   -- tour 5 -> tour 8
	slab(z, V3(78, 20, 99), V3(90, 20, 69), 4, PAL.Bridge, 0.8, "Passerelle")     -- tour 4 -> tour 2 (20)
	slab(z, V3(108, 20, 69), V3(120, 26, 69), 4, PAL.Bridge, 0.8, "Rampe")        -- tour 2 -> tour 3 (montée)
	slab(z, V3(129, 26, 78), V3(129, 32, 90), 4, PAL.Bridge, 0.8, "Rampe")        -- tour 3 -> tour 6 (sommet)
	slab(z, V3(108, 14, 129), V3(120, 20, 129), 4, PAL.Bridge, 0.8, "Rampe")      -- tour 8 -> tour 9
	jumpPad(z, V3(69, 14, 69), 70, V3(0, 0, 36))     -- tour 1 -> tour 4 (14 -> 20)
	jumpPad(z, V3(69, 8, 129), 85, V3(0, 0, -32))    -- tour 7 -> tour 4
	jumpPad(z, V3(99, 0.4, 84), 95, V3(0, 0, 10))     -- sol -> tour 5 (rue)
	-- rampes depuis le sol
	slab(z, V3(48, 0.4, 129), V3(59.5, 8, 129), 6, PAL.PlazaAlt, 1, "RampeSol")
	slab(z, V3(69, 0.4, 36), V3(69, 14, 59.5), 6, PAL.PlazaAlt, 1, "RampeSol")
	-- parcours de saut flottant (tour 9 -> tour 6)
	local steps = { V3(143, 22.5, 117), V3(144, 25, 111), V3(143, 27.5, 105), V3(144, 30, 99) }
	for i, p in steps do
		part(z, V3(3.5, 1, 3.5), CF(p), PAL.Towers[(i % #PAL.Towers) + 1], { Name = "Saut" .. i, Sides = false })
	end
	-- drapeau au sommet
	pillar(z, 129, 99, 10, 0.25, PAL.White, 32)
	part(z, V3(5, 3, 0.2), CF(131.6, 40.5, 99), PAL.Neon2, { Name = "Drapeau", NoStuds = true, CanCollide = false })
	-- tunnel de slide au sol entre deux tours
	slideBlock(z, V3(84, 0.4, 114), 12, 10, 7, RGB(90, 95, 120), "X")
	spawnPoint(spawns, V3(84, 0.4, 84))
	spawnPoint(spawns, V3(114, 0.4, 84))
end

local function buildIndustrial(map, spawns)
	local z = folder(map, "Industriel")
	local H = MapBuilder.RingHeight
	-- conteneurs (piles)
	local containers = {
		{ -60, 90, 0, "Z" }, { -60, 112, 0, "Z" }, { -78, 140, 0, "X" }, { -140, 60, 0, "Z" },
		{ -140, 85, 0, "Z" }, { -140, 85, 8.6, "Z" }, { -122, 140, 0, "X" }, { -122, 140, 8.6, "X" },
		{ -88, 92, 0, "X" }, { -112, 66, 0, "X" },
	}
	for i, c in containers do
		local col = PAL.Containers[(i % #PAL.Containers) + 1]
		local size = if c[4] == "Z" then V3(8, 8.6, 20) else V3(20, 8.6, 8)
		local p = part(z, size, CF(c[1], 0.4 + c[3] + 4.3, c[2]), col, { Name = "Conteneur" })
		-- nervures
		for s = -2, 2 do
			local off = if c[4] == "Z" then V3(4.05, 0, s * 4) else V3(s * 4, 0, 4.05)
			part(z, if c[4] == "Z" then V3(0.2, 8, 0.6) else V3(0.6, 8, 0.2), p.CFrame + off, col:Lerp(Color3.new(0, 0, 0), 0.25),
				{ Name = "Nervure", NoStuds = true, CanCollide = false })
		end
	end
	-- plateforme d'échafaudage reliée au pont (Y = 14)
	local function platform(x, zz, sx, sz)
		part(z, V3(sx, 1, sz), CF(x, H - 0.5, zz), PAL.Metal, { Name = "Plateforme", Sides = false })
		for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
			block(z, x + c[1] * (sx / 2 - 0.6), zz + c[2] * (sz / 2 - 0.6), 0.8, H - 1.4, 0.8, RGB(255, 190, 40), 0.4, { Name = "Poteau", NoStuds = true })
		end
	end
	platform(-64, 64, 14, 14)
	platform(-130, 64, 12, 12)
	platform(-64, 130, 12, 12)
	-- passerelles métalliques
	slab(z, V3(-71, H, 64), V3(-124, H, 64), 4, PAL.Metal, 0.8, "Passerelle")
	slab(z, V3(-64, H, 71), V3(-64, H, 124), 4, PAL.Metal, 0.8, "Passerelle")
	neonStrip(z, V3(53, 0.3, 0.3), CF(-97.5, H - 0.9, 66), RGB(255, 190, 40))
	neonStrip(z, V3(0.3, 0.3, 53), CF(-66, H - 0.9, 97.5), RGB(255, 190, 40))
	-- descentes
	slab(z, V3(-130, H, 70), V3(-130, 0.4, 96), 5, PAL.Metal, 1, "Escalier")
	slab(z, V3(-70, H, 130), V3(-96, 0.4, 130), 5, PAL.Metal, 1, "Escalier")
	-- gros tuyaux (obstacles qu'on saute)
	part(z, V3(30, 3, 3), CF(-112, 1.9, 128), RGB(200, 200, 210), { Name = "Tuyau", Shape = Enum.PartType.Cylinder, NoStuds = true })
	-- cheminées d'usine
	for _, p in { { -138, 138 }, { -138, 110 } } do
		pillar(z, p[1], p[2], 30, 2.5, RGB(190, 70, 60), 0.4)
		neonStrip(z, V3(5.4, 0.6, 5.4), CF(p[1], 24, p[2]), PAL.Neon1)
	end
	-- tunnels de slide (blocs-tuyaux) : vrais raccourcis entre allées
	slideBlock(z, V3(-100, 0.4, 82), 22, 11, 9, RGB(240, 130, 40), "X")
	slideBlock(z, V3(-82, 0.4, 112), 18, 11, 9, RGB(60, 140, 230), "Z")
	slideBlock(z, V3(-112, 0.4, 112), 16, 11, 7, RGB(120, 200, 80), "Z")
	-- jump pad vers la passerelle
	jumpPad(z, V3(-97, 0.4, 70), 80, V3(0, 0, -6))
	for _, p in { { -56, 56 }, { -146, 120 }, { -90, 146 } } do
		lamp(z, p[1], p[2], 0.4, RGB(255, 200, 120))
	end
	spawnPoint(spawns, V3(-80, 0.4, 76))
	spawnPoint(spawns, V3(-100, 0.4, 140))
end

local function buildGardens(map, spawns)
	local z = folder(map, "Jardins")
	local H = MapBuilder.RingHeight
	-- arbre géant avec plateforme reliée au pont (Y = 14)
	block(z, -64, -64, 5, H - 1, 5, PAL.Trunk, 0.4, { Name = "TroncGeant" })
	part(z, V3(16, 1, 16), CF(-64, H - 0.5, -64), RGB(160, 110, 60), { Name = "PlateformeArbre", Sides = false })
	for _, c in { { 6, 6 }, { -6, 6 }, { 6, -6 }, { -6, -6 } } do
		block(z, -64 + c[1], -64 + c[2], 7, 5, 7, PAL.Leaves, 21, { Name = "FeuillageGeant", Sides = true })
	end
	block(z, -64, -64, 10, 4, 10, PAL.GrassDark, 25.5, { Name = "FeuillageGeant" })
	slab(z, V3(-98, 0.4, -64), V3(-72, H, -64), 5, RGB(160, 110, 60), 1, "RampeArbre")
	-- haies (h = 6 : presque trop hautes pour sauter -> on les contourne)
	local hedges = {
		-- { x, z, sx, sz }
		{ -121.5, -90, 37, 3 }, { -76, -90, 20, 3 },           -- rangée 1 (tunnel de slide en -98)
		{ -88, -115, 44, 3 }, { -138, -115, 14, 3 },           -- rangée 2 (trou en -125)
		{ -108, -132, 3, 26 },                                 -- verticale
		{ -76, -132, 3, 20 },
	}
	for _, h in hedges do
		block(z, h[1], h[2], h[3], 6, h[4], PAL.Hedge, 0.4, { Name = "Haie" })
	end
	-- haie avec trou de slide (raccourci)
	slideBlock(z, V3(-98, 0.4, -90), 3, 10, 6, PAL.Hedge, "Z")
	slideBlock(z, V3(-125, 0.4, -115), 3, 10, 6, PAL.Hedge, "Z")
	-- étang
	part(z, V3(0.6, 24, 24), CF(-125, 0.5, -132) * CFrame.Angles(0, 0, math.rad(90)), PAL.Water,
		{ Name = "Etang", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Glass, Transparency = 0.2, NoStuds = true })
	-- parterres de fleurs
	local flowers = { RGB(255, 80, 120), RGB(255, 220, 60), RGB(200, 100, 255), RGB(255, 140, 40) }
	for i = 0, 11 do
		local x = -140 + (i % 4) * 9
		local zz = -72 + math.floor(i / 4) * -5
		block(z, x, zz, 2, 1, 2, flowers[(i % #flowers) + 1], 0.4, { Name = "Fleur" })
	end
	for _, p in { { -140, -60 }, { -90, -140 }, { -58, -100 }, { -100, -72 }, { -92, -104 }, { -140, -100 } } do
		tree(z, p[1], p[2], 1, 0.4)
	end
	for _, p in { { -56, -56 }, { -146, -146 }, { -100, -56 } } do
		lamp(z, p[1], p[2], 0.4, RGB(200, 255, 180))
	end
	jumpPad(z, V3(-80, 0.4, -80), 80, V3(10, 0, 10))
	bench(z, -92, -128, 0, 0.4)
	bench(z, -92, -138, 180, 0.4)
	spawnPoint(spawns, V3(-120, 0.4, -100))
	spawnPoint(spawns, V3(-84, 0.4, -140))
end

-- =====================================================================
-- LOBBY
-- =====================================================================
function MapBuilder.BuildLobby(): Model
	local existing = workspace:FindFirstChild("Lobby")
	if existing then return existing end
	local L = MapBuilder.LobbyCenter
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"
	local function at(x, y, zz) return CF(L.X + x, L.Y + y, L.Z + zz) end

	-- île
	part(lobby, V3(120, 4, 92), at(0, -2, 0), RGB(120, 210, 80), { Name = "Sol" })
	part(lobby, V3(124, 6, 96), at(0, -6.9, 0), RGB(150, 100, 60), { Name = "Terre", Sides = true })
	part(lobby, V3(16, 0.3, 90), at(0, 0.15, 0), RGB(242, 214, 160), { Name = "Allee", Sides = false })
	-- clôtures
	for _, f in { { V3(120, 2.5, 1), at(0, 1.25, -45.5) }, { V3(120, 2.5, 1), at(0, 1.25, 45.5) }, { V3(1, 2.5, 90), at(-59.5, 1.25, 0) }, { V3(1, 2.5, 90), at(59.5, 1.25, 0) } } do
		part(lobby, f[1], f[2], PAL.White, { Name = "Cloture" })
	end

	-- spawns du lobby (SpawnLocation neutres)
	local spawns = folder(lobby, "Spawns")
	for i, x in { -8, 0, 8 } do
		local s = Instance.new("SpawnLocation")
		s.Name = "LobbySpawn" .. i
		s.Anchored = true
		s.Neutral = true
		s.Duration = 0
		s.Size = V3(6, 1, 6)
		s.CFrame = at(x, 0.5, 30)
		s.Color = RGB(255, 210, 60)
		s.Material = Enum.Material.Plastic
		s.TopSurface = Enum.SurfaceType.Smooth
		studs(s, false)
		s.Parent = spawns
	end

	-- zone d'attente : cercle néon + bancs
	part(lobby, V3(0.4, 30, 30), at(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), RGB(255, 90, 120),
		{ Name = "ZoneAttente", Shape = Enum.PartType.Cylinder, NoStuds = true })
	part(lobby, V3(0.45, 26, 26), at(0, 0.22, 0) * CFrame.Angles(0, 0, math.rad(90)), RGB(255, 240, 200),
		{ Name = "ZoneAttenteCentre", Shape = Enum.PartType.Cylinder, NoStuds = true })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		bench(lobby, L.X + math.cos(a) * 17, L.Z + math.sin(a) * 17, -math.deg(a) + 90, 0)
	end

	-- titre géant
	local _, tsg = sign(lobby, V3(44, 10, 1), at(0, 15, -42), Enum.NormalId.Back, 30)
	UI.StudPanel(tsg, { Size = UDim2.fromScale(1, 1), Gradient = "pink", Rotation = 25, Corner = 0 })
	UI.ShadowText(tsg, "TAIL CHASE", { Size = UDim2.fromScale(0.95, 0.8), Max = 230, Stroke = RGB(40, 4, 30), Thickness = 8, Offset = 8, Font = "Gotham", ZIndex = 20 })
	pillar(lobby, L.X - 18, L.Z - 42, 10, 0.8, PAL.White, 0)
	pillar(lobby, L.X + 18, L.Z - 42, 10, 0.8, PAL.White, 0)

	-- panneau "comment jouer"
	local _, hsg = sign(lobby, V3(18, 14, 1), at(-22, 7.5, -36), Enum.NormalId.Back, 40)
	local panel = UI.StudPanel(hsg, { Size = UDim2.new(1, 0, 0, 90), Gradient = "blue", Corner = 0 })
	UI.ShadowText(panel, "COMMENT JOUER", { Size = UDim2.fromScale(0.95, 0.8), Max = 60, Stroke = RGB(2, 30, 60), Thickness = 4, ZIndex = 20 })
	UI.Text(hsg, table.concat({
		"<font color=\"#5FB4FF\">PARTICIPANT</font> : garde ta queue le plus longtemps possible !",
		"<font color=\"#FF3A4A\">CHASSEUR</font> : touche un participant pour lui arracher sa queue. Il devient chasseur à son tour.",
		"<font color=\"#FFD23F\">DASH</font> : Q / Shift  -  <font color=\"#FFD23F\">SLIDE</font> : C / Ctrl (passe dans les tunnels)",
		"Pièces : survie, queues prises, participation et bonus du dernier survivant.",
	}, "\n\n"), { Size = UDim2.new(1, -40, 1, -110), Position = UDim2.new(0.5, 0, 0, 100), AnchorPoint = Vector2.new(0.5, 0), Max = 34, Rich = true,
		Font = "Bold", AlignX = Enum.TextXAlignment.Left, AlignY = Enum.TextYAlignment.Top, Thickness = 3 })

	-- leaderboard (rempli par DataService)
	local board, lsg = sign(lobby, V3(18, 14, 1), at(22, 7.5, -36), Enum.NormalId.Back, 40)
	board.Name = "Leaderboard"
	CollectionService:AddTag(board, "LeaderboardBoard")
	local lpanel = UI.StudPanel(lsg, { Size = UDim2.new(1, 0, 0, 90), Gradient = "gold", Corner = 0 })
	UI.ShadowText(lpanel, "TOP QUEUES PRISES", { Size = UDim2.fromScale(0.95, 0.8), Max = 58, Stroke = RGB(70, 34, 0), Thickness = 4, ZIndex = 20 })
	local rows = Instance.new("Frame")
	rows.Name = "Rows"
	rows.BackgroundTransparency = 1
	rows.Size = UDim2.new(1, -40, 1, -110)
	rows.Position = UDim2.new(0.5, 0, 0, 100)
	rows.AnchorPoint = Vector2.new(0.5, 0)
	rows.Parent = lsg
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = rows

	-- stand du shop (côté Ouest, face à l'Est)
	local shop = Instance.new("Model")
	shop.Name = "ShopStand"
	shop.Parent = lobby
	part(shop, V3(6, 3.2, 14), at(-44, 1.6, 4), RGB(255, 70, 90), { Name = "Comptoir" })
	part(shop, V3(7, 0.6, 15), at(-44, 3.5, 4), PAL.White, { Name = "Plateau" })
	for i = 0, 6 do
		part(shop, V3(9, 0.5, 2), at(-45, 10.5 - (i % 2) * 0.01, -2 + i * 2) * CFrame.Angles(0, 0, math.rad(-12)),
			if i % 2 == 0 then RGB(255, 60, 80) else PAL.White, { Name = "Auvent", NoStuds = true })
	end
	for _, zz in { -3, 11 } do
		block(shop, L.X - 48, L.Z + zz, 1, 10, 1, PAL.White, 0, { Name = "Poteau", NoStuds = true })
	end
	local _, ssg = sign(shop, V3(1, 4, 12), at(-48.5, 13, 4), Enum.NormalId.Right, 40)
	UI.StudPanel(ssg, { Size = UDim2.fromScale(1, 1), Gradient = "magenta", Corner = 0 })
	UI.ShadowText(ssg, "SHOP", { Size = UDim2.fromScale(0.9, 0.85), Max = 140, Stroke = RGB(40, 0, 50), Thickness = 6, Offset = 5, ZIndex = 20, Font = "Gotham" })
	local promptPart = part(shop, V3(1, 1, 1), at(-40.5, 4.5, 4), RGB(255, 210, 60),
		{ Name = "ShopPrompt", Transparency = 1, CanCollide = false, NoStuds = true })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenShop"
	prompt.ActionText = "Ouvrir le shop"
	prompt.ObjectText = "Stand"
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.Parent = promptPart
	MapBuilder.ShopPrompt = prompt

	-- petit parcours fun dans le lobby
	jumpPad(lobby, L + V3(44, 0, 20), 75, V3(0, 0, -10))
	for i, p in { V3(44, 12, 6), V3(48, 13, -4), V3(42, 14, -14), V3(48, 15, -24) } do
		part(lobby, V3(4, 1, 4), CF(L + p), PAL.Towers[(i % #PAL.Towers) + 1], { Name = "Saut" .. i, Sides = false })
	end

	-- déco
	for _, p in { { -52, -38 }, { 52, -38 }, { -52, 38 }, { 52, 38 }, { -30, 30 }, { 30, 30 } } do
		tree(lobby, L.X + p[1], L.Z + p[2], 0.9, 0)
	end
	for _, p in { { -10, 18 }, { 10, 18 }, { -10, -20 }, { 10, -20 } } do
		lamp(lobby, L.X + p[1], L.Z + p[2], 0)
	end

	lobby.Parent = workspace
	return lobby
end

-- =====================================================================
-- ARÈNE GÉNÉRIQUE (sol + enceinte) pour les maps du dossier Maps/
-- =====================================================================
local function arena(map, half: number, ground: Color3, wall: Color3, neon: Color3, wallH: number?)
	local g = folder(map, "Sol")
	part(g, V3(half * 2, 4, half * 2), CF(0, -2, 0), ground, { Name = "Sol", Sides = false })
	local walls = folder(map, "Enceinte")
	local h = wallH or 36
	for i, w in {
		{ V3(half * 2 + 8, h, 4), CF(0, h / 2, -half - 2) }, { V3(half * 2 + 8, h, 4), CF(0, h / 2, half + 2) },
		{ V3(4, h, half * 2), CF(-half - 2, h / 2, 0) }, { V3(4, h, half * 2), CF(half + 2, h / 2, 0) },
	} do
		part(walls, w[1], w[2], wall, { Name = "Mur" })
		local ns = if i <= 2 then V3(w[1].X + 0.2, 0.8, w[1].Z + 0.2) else V3(w[1].X + 0.2, 0.7, w[1].Z - 0.6)
		neonStrip(walls, ns, w[2] * CF(0, h / 2 + 0.4, 0), neon)
	end
	return g
end

-- Briques exposées aux modules de maps (server/Maps/*.luau)
MapBuilder.H = {
	part = part, block = block, folder = folder, slab = slab, railing = railing, pillar = pillar, jumpPad = jumpPad,
	lamp = lamp, tree = tree, bench = bench, neonStrip = neonStrip, slideBlock = slideBlock, sign = sign,
	spawnPoint = spawnPoint, studs = studs, arena = arena, PAL = PAL, RGB = RGB, V3 = V3, CF = CF, UI = UI,
}

-- =====================================================================
-- REGISTRE DES MAPS (vote) - la Ville est intégrée, les autres viennent de server/Maps
-- =====================================================================
MapBuilder.Maps = {
	{
		Id = "ville", Name = "Ville", Order = 1, Clock = 15.2, Gradient = "cyan",
		Icon = "Main/House/Blue House 1st Outline",
		Description = "Toits, village, usine et jardins",
		Build = function(_, map, spawns)
			buildGround(map)
			buildPlaza(map, spawns)
			buildVillage(map, spawns)
			buildRooftops(map, spawns)
			buildIndustrial(map, spawns)
			buildGardens(map, spawns)
		end,
	},
}
local mapsFolder = script:FindFirstChild("Maps")
if mapsFolder then
	for _, m in mapsFolder:GetChildren() do
		if m:IsA("ModuleScript") then
			local ok, def = pcall(require, m)
			if ok and type(def) == "table" and def.Id then
				table.insert(MapBuilder.Maps, def)
			else
				warn("[MapBuilder] map invalide : " .. m.Name, def)
			end
		end
	end
end
table.sort(MapBuilder.Maps, function(a, b) return (a.Order or 99) < (b.Order or 99) end)

function MapBuilder.GetMap(id: string?)
	for _, m in MapBuilder.Maps do if m.Id == id then return m end end
	return nil
end

--- Détruit la map courante et construit `id`. Retourne la définition chargée.
function MapBuilder.LoadMap(id: string?)
	local def = MapBuilder.GetMap(id) or MapBuilder.Maps[1]
	local cur = workspace:FindFirstChild("Map")
	if cur and cur:GetAttribute("MapId") == def.Id then return def end
	if cur then cur:Destroy() end
	local map = Instance.new("Model")
	map.Name = "Map"
	map:SetAttribute("MapId", def.Id)
	local spawns = folder(map, "Spawns")
	def.Build(MapBuilder.H, map, spawns)
	for _, p in map:GetDescendants() do
		if p:IsA("BasePart") and CollectionService:HasTag(p, "SlideCeiling") then p.CollisionGroup = "SlideCeiling" end
	end
	map.Parent = workspace
	game:GetService("Lighting").ClockTime = def.Clock or 15.2
	game:GetService("ReplicatedStorage"):SetAttribute("MapId", def.Id)
	game:GetService("ReplicatedStorage"):SetAttribute("MapName", def.Name)
	return def
end

--- Infos envoyées au client pour le vote (sans la fonction Build).
function MapBuilder.Catalog()
	local out = {}
	for _, m in MapBuilder.Maps do
		table.insert(out, { Id = m.Id, Name = m.Name, Description = m.Description, Icon = m.Icon, Gradient = m.Gradient })
	end
	return out
end

function MapBuilder.SetupCollisionGroups()
	pcall(function() PhysicsService:RegisterCollisionGroup("SlideCeiling") end)
	pcall(function() PhysicsService:RegisterCollisionGroup("Sliders") end)
	PhysicsService:CollisionGroupSetCollidable("SlideCeiling", "Sliders", false)
end

function MapBuilder.SetupLighting()
	local Lighting = game:GetService("Lighting")
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local a = Instance.new("Atmosphere")
		a.Density = 0.28
		a.Haze = 1.2
		a.Color = RGB(255, 220, 190)
		a.Decay = RGB(255, 170, 120)
		a.Glare = 0.4
		a.Parent = Lighting
	end
	if not Lighting:FindFirstChild("TC_Bloom") then
		local b = Instance.new("BloomEffect")
		b.Name = "TC_Bloom"
		b.Intensity = 0.6
		b.Size = 28
		b.Threshold = 1.6
		b.Parent = Lighting
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "TC_Couleurs"
		cc.Saturation = 0.18
		cc.Contrast = 0.06
		cc.TintColor = RGB(255, 246, 236)
		cc.Parent = Lighting
		local sun = Instance.new("SunRaysEffect")
		sun.Intensity = 0.06
		sun.Parent = Lighting
	end
end

function MapBuilder.Build()
	MapBuilder.SetupCollisionGroups()
	MapBuilder.SetupLighting()
	MapBuilder.LoadMap("ville")
	local map = workspace:FindFirstChild("Map")
	local lobby = MapBuilder.BuildLobby()
	if not MapBuilder.ShopPrompt then
		MapBuilder.ShopPrompt = lobby:FindFirstChild("OpenShop", true)
	end
	return map, lobby
end

function MapBuilder.GetMapSpawns(): { BasePart }
	local map = workspace:FindFirstChild("Map")
	local list = {}
	if map and map:FindFirstChild("Spawns") then
		for _, s in map.Spawns:GetChildren() do
			if s:IsA("BasePart") then table.insert(list, s) end
		end
	end
	return list
end

function MapBuilder.GetLobbySpawn(): CFrame
	local lobby = workspace:FindFirstChild("Lobby")
	local spawns = lobby and lobby:FindFirstChild("Spawns")
	if spawns then
		local all = spawns:GetChildren()
		if #all > 0 then
			local s = all[math.random(1, #all)] :: BasePart
			return s.CFrame + Vector3.new(0, 3.5, 0)
		end
	end
	return CFrame.new(MapBuilder.LobbyCenter + Vector3.new(0, 5, 30))
end

return MapBuilder
]]></ProtectedString></Properties><Item class="Folder" referent="RBX0000002A"><Properties><string name="Name">Maps</string></Properties><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Chateau</string><ProtectedString name="Source"><![CDATA[--[[
	Map "Château" - cour pavée entourée de remparts praticables (Y=13) avec créneaux, 4 tours d'angle (Y=22),
	donjon central (Y=20) traversé par un tunnel de slide, poternes de slide dans chaque rempart, douves et ponts.
	Boucle haute : le chemin de ronde fait tout le tour ; rampes intérieures + jump pads vers les tours et le donjon.
]]
local Chateau = { Id = "chateau", Name = "Château", Order = 3, Clock = 17.4, Gradient = "violet",
	Icon = "Item/Shield/Shield 1st Outline", Description = "Remparts, donjon et douves" }

function Chateau.Build(H, map, spawns)
	local RGB, V3, CF = H.RGB, H.V3, H.CF
	local part, block, pillar = H.part, H.block, H.pillar
	local STONE, DARK, GRASS, WOOD, BANNER = RGB(165, 165, 180), RGB(110, 112, 128), RGB(110, 190, 80), RGB(150, 100, 60), RGB(220, 40, 60)
	local W, T, WH = 70, 6, 13 -- demi-taille intérieure+épaisseur, épaisseur, hauteur des remparts
	H.arena(map, 120, GRASS, RGB(90, 150, 70), RGB(255, 200, 80), 30)
	local z = H.folder(map, "Chateau")

	-- cour pavée
	part(z, V3(2 * (W - T / 2), 0.1, 2 * (W - T / 2)), CF(0, 0.05, 0), RGB(200, 195, 180), { Name = "Paves", Sides = false })

	-- remparts : morceaux + poternes de slide + porte centrale (linteau)
	local inner, outer = W - T / 2, W + T / 2 -- 67, 73
	local c = W                                -- axe du mur
	local function wallSide(alongX: boolean, sign: number)
		local lo, hi = if alongX then -outer else -inner, if alongX then outer else inner
		local segs = { { lo, -45 }, { -35, -6 }, { 6, 35 }, { 45, hi } }
		for _, sg in segs do
			local mid, len = (sg[1] + sg[2]) / 2, sg[2] - sg[1]
			if alongX then block(z, mid, sign * c, len, WH, T, STONE, 0, { Name = "Rempart" })
			else block(z, sign * c, mid, T, WH, len, STONE, 0, { Name = "Rempart" }) end
		end
		for _, m in { -40, 40 } do
			local pos = if alongX then V3(m, 0, sign * c) else V3(sign * c, 0, m)
			H.slideBlock(z, pos, T, 10, WH, DARK, if alongX then "Z" else "X")
		end
		-- porte : linteau au-dessus d'une ouverture de 9 de haut
		if alongX then block(z, 0, sign * c, 12, WH - 9, T, DARK, 9, { Name = "Linteau" })
		else block(z, sign * c, 0, T, WH - 9, 12, DARK, 9, { Name = "Linteau" }) end
		-- créneaux côté extérieur (hors zones des tours)
		for k = -42, 42, 6 do
			local o = sign * (outer - 1)
			if alongX then block(z, k, o, 2, 1.6, 2, STONE, WH, { Name = "Creneau" })
			else block(z, o, k, 2, 1.6, 2, STONE, WH, { Name = "Creneau" }) end
		end
		-- bannières côté cour
		for _, m in { -12, 12 } do
			local face = sign * (inner - 0.15)
			if alongX then part(z, V3(4, 7, 0.2), CF(m, 7, face), BANNER, { Name = "Banniere", CanCollide = false, NoStuds = true })
			else part(z, V3(0.2, 7, 4), CF(face, 7, m), BANNER, { Name = "Banniere", CanCollide = false, NoStuds = true }) end
		end
	end
	wallSide(true, -1); wallSide(true, 1); wallSide(false, -1); wallSide(false, 1)

	-- tours d'angle (cylindres Y=22) + jump pads sur le chemin de ronde
	for _, s in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		pillar(z, s[1] * W, s[2] * W, 22, 9, STONE, 0)
		H.neonStrip(z, V3(0.6, 0.6, 0.6), CF(s[1] * W, 32, s[2] * W), RGB(255, 200, 80))
		pillar(z, s[1] * W, s[2] * W, 9, 0.25, WOOD, 22)
		part(z, V3(0.2, 3, 5), CF(s[1] * W, 29.5, s[2] * W + 2.6), BANNER, { Name = "Drapeau", CanCollide = false, NoStuds = true })
		H.jumpPad(z, V3(s[1] * 53, WH, s[2] * W), 88, V3(s[1] * 12, 0, 0))
	end

	-- rampes intérieures vers le chemin de ronde (collées à la face intérieure)
	local r = inner - 2.5
	H.slab(z, V3(20, 0.1, -r), V3(42, WH, -r), 5, WOOD, 1, "Escalier")
	H.slab(z, V3(r, 0.1, 20), V3(r, WH, 42), 5, WOOD, 1, "Escalier")
	H.slab(z, V3(-20, 0.1, r), V3(-42, WH, r), 5, WOOD, 1, "Escalier")
	H.slab(z, V3(-r, 0.1, -20), V3(-r, WH, -42), 5, WOOD, 1, "Escalier")

	-- donjon (Y=20) coupé en deux par un tunnel de slide Est-Ouest
	block(z, 0, -9, 30, 20, 12, STONE, 0, { Name = "Donjon" })
	block(z, 0, 9, 30, 20, 12, STONE, 0, { Name = "Donjon" })
	H.slideBlock(z, V3(0, 0, 0), 30, 6, 20, DARK, "X")
	pillar(z, 0, 12, 10, 0.25, WOOD, 20)
	part(z, V3(0.2, 3.5, 6), CF(0, 28, 15.1), RGB(255, 210, 60), { Name = "Etendard", CanCollide = false, NoStuds = true })
	H.jumpPad(z, V3(0, 0.1, 30), 112, V3(0, 0, -14))
	H.jumpPad(z, V3(0, 0.1, -30), 112, V3(0, 0, 14))

	-- cour : puits, étals, bottes de foin, mannequins
	pillar(z, 38, 38, 2.4, 3.2, STONE, 0.1)
	part(z, V3(0.2, 5.6, 5.6), CF(38, 2.6, 38) * CFrame.Angles(0, 0, math.rad(90)), RGB(60, 150, 230),
		{ Name = "Eau", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Glass, NoStuds = true })
	for i, p in { { -38, 38 }, { 38, -38 } } do
		block(z, p[1], p[2], 10, 3, 4, WOOD, 0.1, { Name = "Etal" })
		for k = 0, 4 do
			block(z, p[1] - 4 + k * 2, p[2] + 2.5, 2, 0.5, 6, if (k + i) % 2 == 0 then BANNER else RGB(250, 250, 250), 7, { Name = "Auvent" })
		end
		pillar(z, p[1] - 4.5, p[2] + 5, 7, 0.2, WOOD, 0.1)
		pillar(z, p[1] + 4.5, p[2] + 5, 7, 0.2, WOOD, 0.1)
	end
	for _, p in { { -45, -20 }, { 46, 18 }, { -20, 48 }, { 24, -50 } } do
		block(z, p[1], p[2], 4, 2.5, 3, RGB(230, 200, 90), 0.1, { Name = "Foin" })
	end
	for _, p in { { -30, -30 }, { 30, 30 } } do
		pillar(z, p[1], p[2], 4, 0.3, WOOD, 0.1)
		block(z, p[1], p[2], 2.4, 2.4, 1, RGB(200, 160, 110), 3, { Name = "Mannequin" })
	end
	for _, p in { { -55, -55 }, { 55, -55 }, { -55, 55 }, { 55, 55 }, { -15, -40 }, { 15, 40 } } do
		H.lamp(z, p[1], p[2], 0.1, RGB(255, 160, 70))
	end

	-- douves (eau peu profonde) + ponts devant les portes
	local m1, m2 = 82, 94
	local moat = { { 0, -(m1 + m2) / 2, 2 * m2, m2 - m1 }, { 0, (m1 + m2) / 2, 2 * m2, m2 - m1 },
		{ -(m1 + m2) / 2, 0, m2 - m1, 2 * m1 }, { (m1 + m2) / 2, 0, m2 - m1, 2 * m1 } }
	for _, w in moat do
		part(z, V3(w[3], 0.2, w[4]), CF(w[1], 0.1, w[2]), RGB(50, 140, 220), { Name = "Douves", Material = Enum.Material.Glass, Transparency = 0.15 })
	end
	block(z, 0, -(m1 + m2) / 2, 12, 0.6, m2 - m1 + 4, WOOD, 0, { Name = "Pont" })
	block(z, 0, (m1 + m2) / 2, 12, 0.6, m2 - m1 + 4, WOOD, 0, { Name = "Pont" })
	block(z, -(m1 + m2) / 2, 0, m2 - m1 + 4, 0.6, 12, WOOD, 0, { Name = "Pont" })
	block(z, (m1 + m2) / 2, 0, m2 - m1 + 4, 0.6, 12, WOOD, 0, { Name = "Pont" })

	-- extérieur : arbres + camp
	for _, p in { { -105, -105 }, { 105, -105 }, { -105, 105 }, { 105, 105 }, { -105, 40 }, { 105, -40 }, { 40, 105 }, { -40, -105 } } do
		H.tree(z, p[1], p[2], 1.1, 0)
	end

	for _, p in { { -30, 15 }, { 30, -15 }, { -45, 45 }, { 45, -45 }, { 20, 55 }, { -20, -55 }, { 55, 20 }, { -55, -20 },
		{ 0, 105 }, { 0, -105 }, { 105, 0 }, { -105, 0 }, { 100, 60 }, { -100, -60 } } do
		H.spawnPoint(spawns, V3(p[1], 0.1, p[2]))
	end
end

return Chateau
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Fete</string><ProtectedString name="Source"><![CDATA[--[[
	Map "Fête foraine" - circuit surélevé de montagnes russes (boucle Y=14 avec rampes intérieures), manège central au
	toit praticable, grande roue, chapiteaux rayés, stands, auto-tamponneuses, train fantôme (tunnel de slide),
	sucettes géantes et trampolines (jump pads).
]]
local Fete = { Id = "fete", Name = "Fête foraine", Order = 6, Clock = 16.2, Gradient = "pink",
	Icon = "Item/Lucky Block/Lucky Block 1st Outline", Description = "Manège, grande roue, train fantôme" }

function Fete.Build(H, map, spawns)
	local RGB, V3, CF = H.RGB, H.V3, H.CF
	local part, block, pillar = H.part, H.block, H.pillar
	local GROUND, TRACK = RGB(150, 225, 190), RGB(255, 80, 140)
	local POP = { RGB(255, 70, 110), RGB(255, 200, 40), RGB(70, 170, 255), RGB(130, 230, 90), RGB(190, 100, 255) }
	H.arena(map, 120, GROUND, RGB(255, 170, 60), RGB(80, 220, 255), 30)
	local z = H.folder(map, "Fete")
	local HH, R, Wd = 14, 75, 6

	-- allée centrale pavée
	part(z, V3(160, 0.1, 12), CF(0, 0.05, 0), RGB(250, 225, 170), { Name = "Allee", Sides = false })
	part(z, V3(12, 0.08, 74), CF(0, 0.04, -43), RGB(250, 225, 170), { Name = "Allee", Sides = false })
	part(z, V3(12, 0.08, 74), CF(0, 0.04, 43), RGB(250, 225, 170), { Name = "Allee", Sides = false })

	-- circuit des montagnes russes (carré Y=14) + supports + rampes intérieures
	local track = H.folder(z, "Circuit")
	part(track, V3(2 * R + Wd, 1, Wd), CF(0, HH - 0.5, -R), TRACK, { Name = "Rail", Sides = false })
	part(track, V3(2 * R + Wd, 1, Wd), CF(0, HH - 0.5, R), TRACK, { Name = "Rail", Sides = false })
	part(track, V3(Wd, 1, 2 * R - Wd), CF(-R, HH - 0.5, 0), TRACK, { Name = "Rail", Sides = false })
	part(track, V3(Wd, 1, 2 * R - Wd), CF(R, HH - 0.5, 0), TRACK, { Name = "Rail", Sides = false })
	for k = -R, R, 25 do
		for _, s in { -1, 1 } do
			pillar(track, k, s * R, HH - 1, 0.7, RGB(250, 250, 250), 0)
			if math.abs(k) < R then pillar(track, s * R, k, HH - 1, 0.7, RGB(250, 250, 250), 0) end
		end
	end
	local r = R - Wd / 2 - 2.5
	H.slab(track, V3(20, 0, -r), V3(44, HH, -r), 5, RGB(255, 200, 40), 1, "Rampe")
	H.slab(track, V3(r, 0, 20), V3(r, HH, 44), 5, RGB(255, 200, 40), 1, "Rampe")
	H.slab(track, V3(-20, 0, r), V3(-44, HH, r), 5, RGB(255, 200, 40), 1, "Rampe")
	H.slab(track, V3(-r, 0, -20), V3(-r, HH, -44), 5, RGB(255, 200, 40), 1, "Rampe")
	-- wagonnets décoratifs (bloquent un peu le passage : on les saute)
	for i, p in { { -30, -R }, { 40, R }, { R, -10 }, { -R, 30 } } do
		block(z, p[1], p[2], 4, 2, 4, POP[(i % #POP) + 1], HH, { Name = "Wagon" })
	end

	-- manège central (toit Y=10 praticable)
	pillar(z, 0, 0, 1.2, 14, RGB(255, 240, 200), 0.1)
	pillar(z, 0, 0, 9, 1.2, RGB(255, 200, 40), 1.3)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local x, zz = math.cos(a) * 10, math.sin(a) * 10
		pillar(z, x, zz, 7.7, 0.25, RGB(255, 220, 90), 1.3)
		block(z, x, zz, 1.4, 2, 3, POP[(k % #POP) + 1], 3, { Name = "Cheval" })
	end
	part(z, V3(1, 31, 31), CF(0, 9.5, 0) * CFrame.Angles(0, 0, math.rad(90)), RGB(255, 80, 110),
		{ Name = "ToitManege", Shape = Enum.PartType.Cylinder, NoStuds = true })
	pillar(z, 0, 0, 3, 3, RGB(255, 220, 90), 10)
	for _, p in { { 24, 0, -10, 0 }, { -24, 0, 10, 0 } } do
		H.jumpPad(z, V3(p[1], 0.1, p[2]), 72, V3(p[3], 0, p[4]))
	end

	-- grande roue (Nord, hors circuit)
	local hub = V3(0, 26, -100)
	for _, s in { -1, 1 } do H.slab(z, V3(s * 12, 0, -100), hub, 1.4, RGB(250, 250, 250), 1.4, "Pied") end
	local prev
	for k = 0, 16 do
		local a = k / 16 * math.pi * 2
		local p = hub + V3(math.cos(a) * 20, math.sin(a) * 20, 0)
		if prev then H.slab(z, prev, p, 1, RGB(70, 170, 255), 1, "Jante") end
		if k < 16 then
			H.neonStrip(z, V3(0.4, 0.4, 0.4), CF(p), POP[(k % #POP) + 1])
			if k % 2 == 0 then block(z, p.X, p.Z + 2.6, 3, 3, 3, POP[(k / 2 % #POP) + 1], p.Y - 3.2, { Name = "Nacelle" }) end
		end
		prev = p
	end

	-- chapiteaux rayés
	local function tent(x, zz, w, d, h, c1, c2)
		local n = math.floor(w / 2)
		for i = 0, n - 1 do
			block(z, x - w / 2 + 1 + i * 2, zz, 2, h, d, if i % 2 == 0 then c1 else c2, 0, { Name = "Chapiteau" })
		end
		block(z, x, zz, w + 1, 1.2, d + 1, c1, h, { Name = "Toit" })
		block(z, x, zz, w - 4, 1.4, d - 4, c2, h + 1.2, { Name = "Toit" })
		block(z, x, zz, w - 9, 1.4, d - 9, c1, h + 2.6, { Name = "Toit" })
	end
	tent(-45, -35, 18, 14, 8, RGB(255, 60, 80), RGB(255, 245, 235))
	tent(45, 35, 18, 14, 8, RGB(60, 120, 255), RGB(255, 245, 235))

	-- stands
	for i, p in { { -40, 18 }, { 40, -18 }, { -18, 40 }, { 18, -40 } } do
		block(z, p[1], p[2], 8, 3, 4, POP[(i % #POP) + 1], 0.1, { Name = "Stand" })
		block(z, p[1], p[2] + 1, 9, 0.5, 6, RGB(255, 245, 235), 6.5, { Name = "Auvent" })
		pillar(z, p[1] - 4, p[2] + 3.5, 6.4, 0.2, RGB(250, 250, 250), 0.1)
		pillar(z, p[1] + 4, p[2] + 3.5, 6.4, 0.2, RGB(250, 250, 250), 0.1)
	end

	-- auto-tamponneuses (piste à bord bas)
	local bx, bz, bw = 40, -45, 24
	block(z, bx, bz, bw, 0.2, bw, RGB(60, 60, 80), 0, { Name = "Piste" })
	block(z, bx, bz - bw / 2 - 0.5, bw + 2, 1.4, 1, RGB(255, 200, 40), 0, { Name = "Bordure" })
	block(z, bx, bz + bw / 2 + 0.5, bw + 2, 1.4, 1, RGB(255, 200, 40), 0, { Name = "Bordure" })
	block(z, bx - bw / 2 - 0.5, bz, 1, 1.4, bw, RGB(255, 200, 40), 0, { Name = "Bordure" })
	block(z, bx + bw / 2 + 0.5, bz, 1, 1.4, bw, RGB(255, 200, 40), 0, { Name = "Bordure" })
	for i, p in { { -6, -5 }, { 5, 4 }, { -4, 7 } } do
		block(z, bx + p[1], bz + p[2], 3, 1.4, 4, POP[(i % #POP) + 1], 0.2, { Name = "Auto" })
	end

	-- train fantôme + autres tunnels
	H.slideBlock(z, V3(-45, 0, 45), 20, 12, 9, RGB(40, 30, 60), "X")
	H.slideBlock(z, V3(60, 0, 8), 12, 12, 7, RGB(190, 100, 255), "Z")
	H.slideBlock(z, V3(-100, 0, -10), 12, 12, 7, RGB(255, 120, 60), "Z")
	H.slideBlock(z, V3(100, 0, 60), 12, 12, 7, RGB(70, 170, 255), "X")

	-- sucettes géantes
	for i, p in { { -100, 100 }, { 100, -100 }, { 100, 100 }, { -100, -60 }, { 30, 100 } } do
		pillar(z, p[1], p[2], 8, 0.35, RGB(250, 250, 250), 0)
		part(z, V3(0.8, 6, 6), CF(p[1], 10.5, p[2]), POP[(i % #POP) + 1], { Name = "Sucette", Shape = Enum.PartType.Cylinder, NoStuds = true })
	end
	-- trampolines extérieurs (vers le circuit)
	H.jumpPad(z, V3(95, 0, -40), 82, V3(-14, 0, 0))
	H.jumpPad(z, V3(-95, 0, 40), 82, V3(14, 0, 0))

	for _, p in { { 20, 20 }, { -20, -20 }, { 60, 60 }, { -60, -60 }, { -60, 60 }, { 60, -60 } } do
		H.lamp(z, p[1], p[2], 0, RGB(255, 210, 150))
	end

	for _, p in { { 25, 8 }, { -25, -8 }, { 8, 25 }, { -8, -25 }, { 55, 20 }, { -55, -20 }, { 20, -60 }, { -20, 60 },
		{ 105, 0 }, { -105, 20 }, { 0, 108 }, { 60, -105 }, { -60, 105 }, { 110, 85 } } do
		H.spawnPoint(spawns, V3(p[1], 0.1, p[2]))
	end
end

return Fete
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Neige</string><ProtectedString name="Source"><![CDATA[--[[
	Map "Village alpin" - neige, lac gelé glissant au centre, chalets à toits plats enneigés (Y≈14.4) reliés par des
	passerelles en boucle, tremplin de ski avec pad de saut, tunnels de slide dans des congères, sapins et bonshommes de neige.
]]
local Neige = { Id = "neige", Name = "Village alpin", Order = 5, Clock = 10.5, Gradient = "blue",
	Icon = "Nature/Cloud/Cloud 1st Outline", Description = "Lac gelé, chalets et tremplin" }

function Neige.Build(H, map, spawns)
	local RGB, V3, CF = H.RGB, H.V3, H.CF
	local part, block, pillar = H.part, H.block, H.pillar
	local SNOW, ICE, WOOD, DARKWOOD, PINE = RGB(242, 246, 255), RGB(170, 220, 255), RGB(160, 100, 60), RGB(110, 70, 45), RGB(40, 120, 70)
	H.arena(map, 120, SNOW, RGB(120, 160, 210), RGB(120, 220, 255), 30)
	local z = H.folder(map, "Neige")
	local ROOF = 14.4

	-- lac gelé (matériau Ice : on glisse !)
	part(z, V3(70, 0.2, 70), CF(0, 0.1, 0), ICE, { Name = "LacGele", Material = Enum.Material.Ice, Transparency = 0.1 })
	for _, p in { { -10, 8 }, { 14, -12 }, { 4, 20 } } do
		part(z, V3(6, 0.05, 0.4), CF(p[1], 0.225, p[2]), RGB(255, 255, 255), { Name = "Fissure", NoStuds = true, CanCollide = false })
	end

	-- chalets (toits plats praticables)
	local function chalet(x, zz, sx, sz, roofCol)
		local m = Instance.new("Model"); m.Name = "Chalet"; m.Parent = z
		block(m, x, zz, sx, 13, sz, WOOD, 0, { Name = "Murs" })
		block(m, x, zz, sx + 2, 1, sz + 2, roofCol, 13, { Name = "Toit" })
		block(m, x, zz, sx + 1, 0.4, sz + 1, SNOW, 14, { Name = "Neige" })
		block(m, x + sx / 4, zz + sz / 4, 2.4, 3.5, 2.4, RGB(150, 70, 60), ROOF, { Name = "Cheminee" })
		-- fenêtres lumineuses
		for _, side in { -1, 1 } do
			part(m, V3(3, 3, 0.2), CF(x - sx / 4, 8, zz + side * (sz / 2 + 0.15)), RGB(255, 220, 140),
				{ Name = "Fenetre", Material = Enum.Material.Neon, CanCollide = false })
			part(m, V3(3, 3, 0.2), CF(x + sx / 4, 8, zz + side * (sz / 2 + 0.15)), RGB(255, 220, 140),
				{ Name = "Fenetre", Material = Enum.Material.Neon, CanCollide = false })
		end
		part(m, V3(4, 6, 0.2), CF(x, 3, zz + sz / 2 + 0.15), DARKWOOD, { Name = "Porte", CanCollide = false, NoStuds = true })
		return m
	end
	chalet(70, 40, 20, 16, RGB(200, 50, 50)); chalet(70, -40, 20, 16, RGB(60, 90, 200))
	chalet(-70, 40, 20, 16, RGB(60, 90, 200)); chalet(-70, -40, 20, 16, RGB(200, 50, 50))
	chalet(0, 85, 20, 16, RGB(240, 160, 30)); chalet(0, -85, 20, 16, RGB(240, 160, 30))

	-- passerelles en boucle (bords de toit)
	local function walk(a, b) H.slab(z, a, b, 4, DARKWOOD, 0.6, "Passerelle") end
	walk(V3(70, ROOF, 31), V3(70, ROOF, -31))
	walk(V3(-70, ROOF, 31), V3(-70, ROOF, -31))
	walk(V3(11, ROOF, 80), V3(59, ROOF, 45))
	walk(V3(-11, ROOF, 80), V3(-59, ROOF, 45))
	walk(V3(11, ROOF, -80), V3(59, ROOF, -45))
	walk(V3(-11, ROOF, -80), V3(-59, ROOF, -45))
	-- accès : rampes extérieures + pads
	H.slab(z, V3(110, 0, 40), V3(81, ROOF, 40), 6, DARKWOOD, 1, "Rampe")
	H.slab(z, V3(-110, 0, -40), V3(-81, ROOF, -40), 6, DARKWOOD, 1, "Rampe")
	H.jumpPad(z, V3(0, 0, 62), 82, V3(0, 0, 14))
	H.jumpPad(z, V3(0, 0, -62), 82, V3(0, 0, -14))

	-- tremplin de ski
	H.slab(z, V3(-30, 0, -108), V3(-80, 18, -108), 8, SNOW, 1, "Tremplin")
	block(z, -87, -108, 14, 18, 12, RGB(200, 210, 230), 0, { Name = "PlateformeTremplin" })
	H.jumpPad(z, V3(-89, 18, -108), 95, V3(40, 0, 24))
	for k = 0, 4 do
		part(z, V3(0.4, 1.2, 0.4), CF(-35 - k * 10, 0.6 + k * 3.6 + 1, -112.5), RGB(255, 60, 60), { Name = "Fanion", CanCollide = false, NoStuds = true })
	end

	-- congères percées (tunnels de slide)
	H.slideBlock(z, V3(-40, 0, 62), 14, 12, 7, SNOW, "X")
	H.slideBlock(z, V3(40, 0, -62), 14, 12, 7, SNOW, "X")
	H.slideBlock(z, V3(100, 0, -90), 12, 12, 7, SNOW, "Z")
	H.slideBlock(z, V3(-100, 0, 90), 12, 12, 7, SNOW, "Z")

	-- sapins
	local function pine(x, zz, s)
		block(z, x, zz, 1.2 * s, 3 * s, 1.2 * s, DARKWOOD, 0, { Name = "Tronc" })
		block(z, x, zz, 7 * s, 3 * s, 7 * s, PINE, 3 * s, { Name = "Sapin" })
		block(z, x, zz, 5 * s, 3 * s, 5 * s, PINE:Lerp(SNOW, 0.08), 6 * s, { Name = "Sapin" })
		block(z, x, zz, 3 * s, 2.5 * s, 3 * s, PINE:Lerp(SNOW, 0.15), 9 * s, { Name = "Sapin" })
		block(z, x, zz, 1.6 * s, 0.6 * s, 1.6 * s, SNOW, 11.5 * s, { Name = "NeigeSapin" })
	end
	for _, p in { { -105, -60, 1.1 }, { 105, 70, 1 }, { -105, 10, 0.9 }, { 105, -10, 1.2 }, { 40, 105, 1 }, { -40, 105, 1.1 },
		{ 35, -100, 0.9 }, { -20, -60, 0.8 }, { 25, 55, 0.8 }, { -45, -20, 0.9 }, { 48, 15, 0.9 }, { 90, 105, 1 } } do
		pine(p[1], p[2], p[3])
	end
	-- bonshommes de neige
	for _, p in { { -25, 45 }, { 30, -45 }, { 95, 0 } } do
		part(z, V3(4, 4, 4), CF(p[1], 2, p[2]), SNOW, { Name = "Boule", Shape = Enum.PartType.Ball, NoStuds = true })
		part(z, V3(3, 3, 3), CF(p[1], 5.2, p[2]), SNOW, { Name = "Boule", Shape = Enum.PartType.Ball, NoStuds = true })
		part(z, V3(2.1, 2.1, 2.1), CF(p[1], 7.5, p[2]), SNOW, { Name = "Tete", Shape = Enum.PartType.Ball, NoStuds = true })
		part(z, V3(0.3, 0.3, 1.2), CF(p[1], 7.5, p[2] - 1.3), RGB(255, 140, 30), { Name = "Carotte", NoStuds = true, CanCollide = false })
	end
	for _, p in { { 45, 35 }, { -45, -35 }, { 45, -35 }, { -45, 35 }, { 0, 50 }, { 0, -50 } } do
		H.lamp(z, p[1], p[2], 0, RGB(255, 200, 120))
	end
	_ = pillar

	for _, p in { { 20, 20 }, { -20, -20 }, { 25, -25 }, { -25, 25 }, { 90, 60 }, { -90, -60 }, { 90, -60 }, { -90, 60 },
		{ 60, 100 }, { -60, -100 }, { 100, 20 }, { -100, -20 }, { 0, 108 }, { 0, -108 } } do
		H.spawnPoint(spawns, V3(p[1], 0.2, p[2]))
	end
end

return Neige
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Neon</string><ProtectedString name="Source"><![CDATA[--[[
	Map "Néon City" - de nuit, sol sombre quadrillé de néons, tours aux arêtes lumineuses.
	Niveau 1 (Y=14) : 4 tours reliées par des ponts au disque holographique central.
	Niveau 2 (Y=22) : 4 tours longues reliées en boucle par des "ponts de lumière" ; jump pads depuis le niveau 1.
	Tuyaux néon de slide au sol, pads vers le disque central.
]]
local Neon = { Id = "neon", Name = "Néon City", Order = 4, Clock = 0.5, Gradient = "magenta",
	Icon = "Main/Lighting/Purple Lighting 1st Outline", Description = "Nuit, ponts de lumière, néons" }

function Neon.Build(H, map, spawns)
	local RGB, V3, CF = H.RGB, H.V3, H.CF
	local part, block, pillar, neon = H.part, H.block, H.pillar, H.neonStrip
	local FLOOR, BODY = RGB(26, 28, 42), RGB(44, 48, 70)
	local CYAN, PINK, GOLD = RGB(0, 235, 255), RGB(255, 40, 200), RGB(255, 210, 60)
	H.arena(map, 120, FLOOR, RGB(36, 40, 60), PINK, 34)
	local z = H.folder(map, "Neon")

	-- quadrillage lumineux (hauteurs différentes pour les deux sens : pas de faces communes aux croisements)
	for k = -90, 90, 30 do
		part(z, V3(240, 0.06, 0.3), CF(0, 0.03, k), CYAN, { Name = "Grille", Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
		part(z, V3(0.3, 0.09, 240), CF(k, 0.045, 0), PINK, { Name = "Grille", Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
	end

	local function tower(x, zz, sx, sz, h, col)
		local m = Instance.new("Model"); m.Name = "Tour"; m.Parent = z
		block(m, x, zz, sx, h - 0.6, sz, BODY, 0, { Name = "Corps" })
		block(m, x, zz, sx + 0.8, 0.6, sz + 0.8, RGB(20, 22, 32), h - 0.6, { Name = "Toit" })
		for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
			neon(m, V3(0.4, h - 1.2, 0.4), CF(x + c[1] * (sx / 2 + 0.2), (h - 0.6) / 2, zz + c[2] * (sz / 2 + 0.2)), col)
		end
		for y = 4, h - 3, 6 do
			neon(m, V3(sx, 0.4, 0.2), CF(x, y, zz - sz / 2 - 0.1), col)
			neon(m, V3(sx, 0.4, 0.2), CF(x, y, zz + sz / 2 + 0.1), col)
			neon(m, V3(0.2, 0.4, sz), CF(x - sx / 2 - 0.1, y, zz), col)
			neon(m, V3(0.2, 0.4, sz), CF(x + sx / 2 + 0.1, y, zz), col)
		end
		local l = Instance.new("PointLight"); l.Color = col; l.Range = 24; l.Brightness = 1.5; l.Parent = m:FindFirstChild("Toit")
		return m
	end
	-- niveau 1
	for _, s in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do tower(s[1] * 50, s[2] * 50, 20, 20, 14, CYAN) end
	-- niveau 2
	tower(0, -85, 28, 16, 22, PINK); tower(0, 85, 28, 16, 22, PINK)
	tower(-85, 0, 16, 28, 22, PINK); tower(85, 0, 16, 28, 22, PINK)
	-- tours d'angle décoratives
	for _, s in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do tower(s[1] * 100, s[2] * 100, 14, 14, 30, GOLD) end

	-- disque holographique central (Y=14)
	pillar(z, 0, 0, 13, 3, BODY, 0)
	part(z, V3(1, 32, 32), CF(0, 13.5, 0) * CFrame.Angles(0, 0, math.rad(90)), RGB(30, 34, 52),
		{ Name = "Disque", Shape = Enum.PartType.Cylinder, NoStuds = true })
	part(z, V3(0.3, 33, 33), CF(0, 13.1, 0) * CFrame.Angles(0, 0, math.rad(90)), CYAN,
		{ Name = "DisqueNeon", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, CanCollide = false })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		neon(z, V3(1, 1, 1), CF(math.cos(a) * 10, 24, math.sin(a) * 10), if k % 2 == 0 then CYAN else PINK)
	end
	-- ponts niveau 1 : coins intérieurs des tours -> disque
	for _, s in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		H.slab(z, V3(s[1] * 40, 14, s[2] * 40), V3(s[1] * 11, 14, s[2] * 11), 5, RGB(60, 66, 96), 0.8, "Pont")
	end
	-- ponts de lumière niveau 2 (boucle)
	local function lightBridge(a, b)
		H.slab(z, a, b, 5, CYAN, 0.6, "PontLumiere").Material = Enum.Material.Neon
	end
	lightBridge(V3(14, 22, -77), V3(77, 22, -14))
	lightBridge(V3(77, 22, 14), V3(14, 22, 77))
	lightBridge(V3(-14, 22, 77), V3(-77, 22, 14))
	lightBridge(V3(-77, 22, -14), V3(-14, 22, -77))
	-- accès : rampes sol -> niveau 1, pads niveau 1 -> niveau 2, pads sol -> disque
	for _, s in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		H.slab(z, V3(s[1] * 50, 0, s[2] * 86), V3(s[1] * 50, 14, s[2] * 60.5), 6, RGB(60, 66, 96), 1, "Rampe")
		H.jumpPad(z, V3(s[1] * 55, 14, s[2] * 55), 82, V3(-s[1] * 10, 0, -s[2] * 10))
	end
	for _, p in { { 25, 0, -12, 0 }, { -25, 0, 12, 0 }, { 0, 25, 0, -12 }, { 0, -25, 0, 12 } } do
		H.jumpPad(z, V3(p[1], 0, p[2]), 80, V3(p[3], 0, p[4]))
	end

	-- tuyaux de slide
	H.slideBlock(z, V3(0, 0, 52), 16, 11, 7, RGB(40, 30, 70), "X")
	H.slideBlock(z, V3(0, 0, -52), 16, 11, 7, RGB(40, 30, 70), "X")
	H.slideBlock(z, V3(52, 0, 0), 16, 11, 7, RGB(40, 30, 70), "Z")
	H.slideBlock(z, V3(-52, 0, 0), 16, 11, 7, RGB(40, 30, 70), "Z")

	-- bornes lumineuses
	for _, p in { { 30, 75 }, { -30, -75 }, { 75, -30 }, { -75, 30 }, { 105, 50 }, { -105, -50 } } do
		H.lamp(z, p[1], p[2], 0, if p[1] > 0 then CYAN else PINK)
	end

	for _, p in { { 30, 30 }, { -30, -30 }, { 30, -30 }, { -30, 30 }, { 70, 70 }, { -70, -70 }, { 70, -70 }, { -70, 70 },
		{ 0, 110 }, { 0, -110 }, { 110, 0 }, { -110, 0 }, { 40, 105 }, { -40, -105 } } do
		H.spawnPoint(spawns, V3(p[1], 0.1, p[2]))
	end
end

return Neon
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Plage</string><ProtectedString name="Source"><![CDATA[--[[
	Map "Plage tropicale" - sable chaud, mer turquoise, paillotes sur pilotis reliées par des ponts de corde (Y=14),
	bar central surélevé, rochers percés de tunnels de slide, ponton, tour de surveillance, jump pads.
	Boucle haute : bar central <-> 4 paillotes, paillotes Nord reliées par la cabane du phare.
]]
local Plage = { Id = "plage", Name = "Plage", Order = 2, Clock = 13.5, Gradient = "amber",
	Icon = "Nature/Planet/Green Planet 1st Outline", Description = "Paillotes, rochers et ponton" }

function Plage.Build(H, map, spawns)
	local RGB, V3, CF = H.RGB, H.V3, H.CF
	local part, block, slab, pillar = H.part, H.block, H.slab, H.pillar
	local SAND, WATER, WOOD, STRAW, ROCK = RGB(240, 216, 160), RGB(40, 180, 235), RGB(170, 110, 60), RGB(235, 200, 110), RGB(150, 145, 140)
	local HH = 14
	H.arena(map, 120, SAND, RGB(80, 200, 220), RGB(255, 120, 200), 30)
	local z = H.folder(map, "Plage")

	-- mer (au Nord) : eau peu profonde praticable + écume
	part(z, V3(240, 0.3, 50), CF(0, 0.15, -95), WATER, { Name = "Mer", Material = Enum.Material.Glass, Transparency = 0.2 })
	part(z, V3(240, 0.1, 3), CF(0, 0.05, -68.5), RGB(250, 250, 255), { Name = "Ecume", NoStuds = true })

	-- ponton vers le large
	block(z, 0, -92, 8, 1, 40, WOOD, 2, { Name = "Ponton" })
	for _, pz in { -76, -92, -108 } do
		for _, px in { -3.5, 3.5 } do pillar(z, px, pz, 2, 0.5, RGB(120, 80, 40), 0) end
	end
	H.slab(z, V3(0, 0, -64), V3(0, 3, -72), 8, WOOD, 1, "RampePonton")
	H.jumpPad(z, V3(0, 3, -108), 95, V3(0, 0, 18))

	-- plateformes surélevées (paillotes) + bar central
	local function platform(x, zz, size, name, roof)
		local m = Instance.new("Model"); m.Name = name; m.Parent = z
		part(m, V3(size, 1, size), CF(x, HH - 0.5, zz), WOOD, { Name = "Plancher", Sides = false })
		for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
			pillar(m, x + c[1] * (size / 2 - 1), zz + c[2] * (size / 2 - 1), HH - 1, 0.6, RGB(120, 80, 40), 0)
		end
		if roof then
			-- cabane au centre (on fait le tour par le plancher) + toit de paille
			block(m, x, zz, size - 8, 7, size - 8, RGB(200, 150, 90), HH, { Name = "Cabane" })
			block(m, x, zz, size - 6, 1.2, size - 6, STRAW, HH + 7, { Name = "Paille" })
			block(m, x, zz, size - 10, 1, size - 10, STRAW:Lerp(RGB(200, 160, 60), 0.4), HH + 8.2, { Name = "PailleHaut" })
		end
		return m
	end
	platform(0, 10, 26, "Bar", false)
	block(z, 0, 10, 8, 1.2, 3, RGB(255, 90, 120), HH, { Name = "Comptoir" })
	local huts = { { -62, -30 }, { 62, -30 }, { 78, 52 }, { -78, 52 } }
	for i, h in huts do platform(h[1], h[2], 20, "Paillote" .. i, true) end
	platform(0, 88, 18, "CabanePhare", true)
	-- ponts de corde (Y = 14)
	local function rope(a, b) H.slab(z, a, b, 4, RGB(205, 160, 100), 0.6, "PontDeCorde") end
	rope(V3(-13, HH, 4), V3(-52, HH, -24))
	rope(V3(13, HH, 4), V3(52, HH, -24))
	rope(V3(13, HH, 18), V3(68, HH, 46))
	rope(V3(-13, HH, 18), V3(-68, HH, 46))
	rope(V3(68, HH, 60), V3(9, HH, 84))
	rope(V3(-68, HH, 60), V3(-9, HH, 84))
	-- accès depuis le sable
	H.slab(z, V3(0, 0, 48), V3(0, HH, 23.5), 6, WOOD, 1, "EscalierBar")
	H.slab(z, V3(-30, 0, 10), V3(-13.5, HH, 10), 5, WOOD, 1, "EscalierBar")
	H.jumpPad(z, V3(-62, 0, -46), 80, V3(0, 0, 10))
	H.jumpPad(z, V3(62, 0, -46), 80, V3(0, 0, 10))
	H.jumpPad(z, V3(78, 0, 70), 80, V3(0, 0, -12))

	-- rochers percés (tunnels de slide)
	H.slideBlock(z, V3(-30, 0, 40), 14, 13, 8, ROCK, "X")
	H.slideBlock(z, V3(40, 0, 10), 14, 13, 7, ROCK, "Z")
	H.slideBlock(z, V3(-95, 0, -5), 12, 13, 8, ROCK, "Z")
	H.slideBlock(z, V3(100, 0, 95), 12, 13, 7, ROCK, "X")
	for _, r in { { -100, 100, 9 }, { 105, 15, 7 }, { 30, 105, 6 }, { -50, 95, 5 } } do
		block(z, r[1], r[2], r[3] * 2, r[3], r[3] * 1.6, ROCK, 0, { Name = "Rocher" })
	end

	-- tour de surveillance
	for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do pillar(z, 95 + c[1] * 3, -50 + c[2] * 3, 8, 0.4, RGB(250, 250, 250), 0) end
	part(z, V3(8, 1, 8), CF(95, 8.5, -50), RGB(255, 70, 70), { Name = "Vigie" })
	H.jumpPad(z, V3(95, 0, -38), 70, V3(0, 0, -10))

	-- palmiers, parasols, serviettes
	local function palm(x, zz, hgt)
		for i = 0, hgt - 1 do
			block(z, x + (i % 2) * 0.3, zz, 1.6, 1, 1.6, RGB(150, 100, 55), i, { Name = "Stipe" })
		end
		for k = 0, 3 do
			local a = k * math.pi / 2 + 0.4
			local tip = V3(x + math.cos(a) * 6, hgt - 1.5, zz + math.sin(a) * 6)
			H.slab(z, V3(x, hgt + 0.6, zz), tip, 2.4, RGB(60, 190, 70), 0.3, "Palme")
		end
		part(z, V3(1.2, 1.2, 1.2), CF(x + 0.6, hgt - 0.4, zz + 0.6), RGB(110, 70, 30), { Name = "Coco", Shape = Enum.PartType.Ball, NoStuds = true })
	end
	for _, p in { { -100, -55, 11 }, { -40, -58, 10 }, { 40, -56, 12 }, { 105, -60, 10 }, { -105, 40, 12 }, { 108, 50, 11 },
		{ -30, 75, 9 }, { 40, 70, 10 }, { 20, -30, 9 }, { -20, -35, 11 } } do
		palm(p[1], p[2], p[3])
	end
	local colors = { RGB(255, 80, 120), RGB(80, 160, 255), RGB(255, 210, 60), RGB(120, 230, 120) }
	for i, p in { { -60, 10 }, { 60, 25 }, { -25, -45 }, { 30, -45 }, { 90, -10 }, { -90, 75 } } do
		pillar(z, p[1], p[2], 6, 0.2, RGB(240, 240, 240), 0)
		part(z, V3(0.4, 8, 8), CF(p[1], 6.2, p[2]) * CFrame.Angles(0, 0, math.rad(90)), colors[(i % 4) + 1],
			{ Name = "Parasol", Shape = Enum.PartType.Cylinder, NoStuds = true })
		part(z, V3(3, 0.08, 5.5), CF(p[1] + 3.5, 0.04, p[2]), colors[((i + 1) % 4) + 1], { Name = "Serviette", NoStuds = true, CanCollide = false })
	end
	for _, p in { { -45, 0 }, { 45, 0 }, { 10, 45 }, { -80, -45 }, { 80, -45 }, { 0, -55 } } do
		H.lamp(z, p[1], p[2], 0, RGB(255, 170, 90))
	end

	for _, p in { { -20, 30 }, { 20, 30 }, { -60, 20 }, { 60, 40 }, { -100, 20 }, { 100, 30 }, { -70, -50 }, { 70, -50 },
		{ -20, -50 }, { 25, -55 }, { -40, 100 }, { 50, 100 }, { 0, 65 }, { -105, -20 } } do
		H.spawnPoint(spawns, V3(p[1], 0, p[2]))
	end
end

return Plage
]]></ProtectedString></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">MovementService</string><ProtectedString name="Source"><![CDATA[--[[
	MovementService - validation serveur du dash et du slide.
	Le client applique la physique tout de suite (réactivité) et prévient le serveur via Remotes.MoveAction :
		"Dash"        -> cooldown vérifié (Config.DashCooldown - tolérance). Refusé => Attribute "DashRejected" (le client se corrige).
		"SlideStart"  -> cooldown vérifié, personnage passé dans le CollisionGroup "Sliders" (traverse les plafonds de tunnel)
		"SlideEnd"    -> retour au groupe par défaut
	Les Attributes "Dashing" / "Sliding" du personnage servent aux effets et animations de TOUS les clients.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MovementService = {}

local lastDash: { [Player]: number } = {}
local lastSlide: { [Player]: number } = {}

local function setGroup(char: Model, group: string)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and d.Parent and d.Parent.Name ~= "Tail" then
			d.CollisionGroup = group
		end
	end
end

local function canMove(player: Player): boolean
	if player:GetAttribute("Frozen") then return false end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

function MovementService.EndSlide(player: Player)
	local char = player.Character
	if char then
		char:SetAttribute("Sliding", false)
		setGroup(char, "Default")
	end
end

local function onAction(player: Player, action: any)
	if typeof(action) ~= "string" then return end
	local now = os.clock()
	local char = player.Character
	if not char then return end
	if action == "Dash" then
		local last = lastDash[player] or 0
		if not canMove(player) or now - last < Config.DashCooldown - Config.DashServerTolerance then
			player:SetAttribute("DashRejected", now)
			return
		end
		lastDash[player] = now
		char:SetAttribute("Dashing", true)
		task.delay(Config.DashDuration + 0.1, function()
			if char.Parent then char:SetAttribute("Dashing", false) end
		end)
	elseif action == "SlideStart" then
		local last = lastSlide[player] or 0
		if not canMove(player) or now - last < Config.SlideCooldown - Config.DashServerTolerance then return end
		lastSlide[player] = now
		char:SetAttribute("Sliding", true)
		setGroup(char, "Sliders")
	elseif action == "SlideEnd" then
		MovementService.EndSlide(player)
	end
end

function MovementService.Init()
	Remotes.MoveAction.OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(function(p)
		lastDash[p] = nil
		lastSlide[p] = nil
	end)
end

return MovementService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">RoleService</string><ProtectedString name="Source"><![CDATA[--[[
	RoleService - rôle de chaque joueur et visuels associés.
	Rôles (Player Attribute "Role") :
		"Lobby"   dans le lobby (queue cosmétique visible pour montrer son skin)
		"Runner"  participant : queue dans le dos
		"Hunter"  chasseur : Highlight ROUGE visible à travers les murs + BillboardGui "HUNTER", pas de queue
	Attributes complémentaires : "Frozen" (décompte), "ImmuneUntil" (anti-chaîne, temps serveur).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(ReplicatedStorage.StudUI)
local Icons = require(ReplicatedStorage.CheckUIIcons)
local TailService = require(script.Parent.TailService)

local RoleService = {}

local function clearVisuals(char: Model)
	for _, n in { "HunterHighlight", "HunterTag" } do
		local o = char:FindFirstChild(n, true)
		if o then o:Destroy() end
	end
end

local function hunterVisuals(char: Model)
	local hl = Instance.new("Highlight")
	hl.Name = "HunterHighlight"
	hl.FillColor = Config.HunterColor
	hl.FillTransparency = 0.72
	hl.OutlineColor = Color3.fromRGB(255, 20, 40)
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = char
	hl.Parent = char

	local head = char:FindFirstChild("Head")
	if head then
		local bb = Instance.new("BillboardGui")
		bb.Name = "HunterTag"
		bb.Size = UDim2.fromOffset(190, 56)
		bb.StudsOffset = Vector3.new(0, 2.6, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 250
		bb.LightInfluence = 0
		bb.Adornee = head
		bb.Parent = head
		local icon = UI.Image(bb, Icons.Get("Player/Skull/Skull 1st Outline"), { Size = UDim2.fromOffset(46, 46),
			Position = UDim2.new(0, 22, 0.5, 0), Rotation = -10, ZIndex = 8 })
		_ = icon
		UI.ShadowText(bb, "HUNTER", { Font = "Gotham", Size = UDim2.new(1, -46, 1, 0), Position = UDim2.new(0.5, 23, 0.5, 0),
			Max = 40, Stroke = Color3.fromRGB(60, 0, 8), Thickness = 3.4, Gradient = UI.seq(Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 20, 40)) })
	end
end

function RoleService.Get(player: Player): string
	return player:GetAttribute("Role") or "Lobby"
end

--- Applique les visuels + la vitesse du rôle courant au personnage actuel.
function RoleService.ApplyVisuals(player: Player)
	local char = player.Character
	if not char then return end
	local role = RoleService.Get(player)
	clearVisuals(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if role == "Hunter" then
		TailService.Remove(player)
		hunterVisuals(char)
		if hum then hum.WalkSpeed = Config.HunterWalkSpeed end
	elseif role == "Runner" then
		TailService.Give(player)
		if hum then hum.WalkSpeed = Config.RunnerWalkSpeed end
	else
		TailService.Give(player)
		if hum then hum.WalkSpeed = Config.LobbyWalkSpeed end
	end
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = Config.JumpPower
	end
	RoleService.ApplyFreeze(player)
end

function RoleService.Set(player: Player, role: string)
	player:SetAttribute("Role", role)
	RoleService.ApplyVisuals(player)
end

--- Gèle / dégèle (décompte de début de manche, départ retardé des chasseurs).
function RoleService.SetFrozen(player: Player, frozen: boolean)
	player:SetAttribute("Frozen", frozen)
	RoleService.ApplyFreeze(player)
end

function RoleService.ApplyFreeze(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local role = RoleService.Get(player)
	if player:GetAttribute("Frozen") then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
	else
		hum.WalkSpeed = if role == "Hunter" then Config.HunterWalkSpeed elseif role == "Runner" then Config.RunnerWalkSpeed else Config.LobbyWalkSpeed
		hum.JumpPower = Config.JumpPower
	end
end

return RoleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--[[
	ShopService - achats et équipement des cosmétiques (validés côté serveur).
	RemoteFunctions :
		ShopPurchase(itemId) -> { Ok, Message, Profile }
		ShopEquip(itemId)    -> { Ok, Message, Profile }

	Points d'extension monétisation (non implémentés) :
		ShopService.GrantProduct(player, productId)  à appeler depuis MarketplaceService.ProcessReceipt
		ShopService.HasGamepass(player, passId)      à brancher sur UserOwnsGamePassAsync
	Les IDs se déclarent dans Config.Monetization.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local ShopService = {}
ShopService.OnEquipped = Instance.new("BindableEvent") -- (player, category, itemId) -> TailService rafraîchit la queue

local busy: { [Player]: boolean } = {}

local function result(ok: boolean, msg: string, player: Player)
	return { Ok = ok, Message = msg, Profile = DataService.Snapshot(player) }
end

function ShopService.Purchase(player: Player, itemId: any)
	if typeof(itemId) ~= "string" then return result(false, "Item invalide", player) end
	local item = Cosmetics.Get(itemId)
	local d = DataService.Get(player)
	if not item or not d then return result(false, "Item introuvable", player) end
	if d.Owned[itemId] then return result(false, "Déjà possédé", player) end
	if busy[player] then return result(false, "Patiente...", player) end
	if d.Coins < item.Price then return result(false, "Pas assez de pièces", player) end
	busy[player] = true
	d.Coins -= item.Price
	d.Owned[itemId] = true
	d.Equipped[item.Category] = itemId -- on équipe directement ce qu'on vient d'acheter
	busy[player] = nil
	DataService.Push(player)
	ShopService.OnEquipped:Fire(player, item.Category, itemId)
	return result(true, "Acheté !", player)
end

function ShopService.Equip(player: Player, itemId: any)
	if typeof(itemId) ~= "string" then return result(false, "Item invalide", player) end
	local item = Cosmetics.Get(itemId)
	local d = DataService.Get(player)
	if not item or not d then return result(false, "Item introuvable", player) end
	if not d.Owned[itemId] then return result(false, "Pas encore acheté", player) end
	d.Equipped[item.Category] = itemId
	DataService.Push(player)
	ShopService.OnEquipped:Fire(player, item.Category, itemId)
	return result(true, "Équipé !", player)
end

--- EXTENSION : produit développeur acheté (Robux). Retourne true si le produit a été accordé.
function ShopService.GrantProduct(player: Player, productId: number): boolean
	local def = Config.Monetization.DeveloperProducts[productId]
	if not def then return false end
	-- TODO quand les produits existeront :
	-- if def.Kind == "Coins" then DataService.AddCoins(player, def.Amount) return true end
	return false
end

--- EXTENSION : possession d'un gamepass (non branché).
function ShopService.HasGamepass(_player: Player, _passId: number): boolean
	return false
end

function ShopService.Init()
	Remotes.ShopPurchase.OnServerInvoke = ShopService.Purchase
	Remotes.ShopEquip.OnServerInvoke = ShopService.Equip
	-- MarketplaceService.ProcessReceipt = function(receipt) ... ShopService.GrantProduct(...) end  (à activer plus tard)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">TailService</string><ProtectedString name="Source"><![CDATA[--[[
	TailService - queues des participants (attache / retrait / skin équipé).
	La queue est construite par Shared.TailBuilder ; le balancement est animé côté client (EffectsController).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TailBuilder = require(ReplicatedStorage.Shared.TailBuilder)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local TailService = {}

function TailService.SkinOf(player: Player): string?
	local d = DataService.Get(player)
	return d and d.Equipped.Tail or nil
end

function TailService.Give(player: Player)
	local char = player.Character
	if not char then return end
	TailBuilder.Attach(char, TailService.SkinOf(player))
end

--- Retire la queue ; retourne le CFrame du 1er segment (pour l'effet "queue qui vole") et le skin.
function TailService.Remove(player: Player): (CFrame?, string?)
	local char = player.Character
	if not char then return nil, nil end
	local tail = char:FindFirstChild("Tail")
	if not tail then return nil, nil end
	local seg = tail:FindFirstChild("Seg1")
	local cf = seg and seg.CFrame
	local skin = tail:GetAttribute("Skin")
	tail:Destroy()
	return cf, skin
end

function TailService.Has(player: Player): boolean
	local char = player.Character
	return char ~= nil and char:FindFirstChild("Tail") ~= nil
end

function TailService.Init()
	-- changement de skin depuis le shop : on remplace la queue si elle est portée
	ShopService.OnEquipped.Event:Connect(function(player: Player, category: string)
		if category == "Tail" and TailService.Has(player) then
			TailService.Give(player)
		end
	end)
end

return TailService
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX0000003F"><Properties><string name="Name">StarterPlayer</string><float name="CharacterWalkSpeed">20</float><float name="CharacterJumpPower">50</float><bool name="CharacterUseJumpPower">true</bool><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX0000003E"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000031"><Properties><string name="Name">AnimationController</string><ProtectedString name="Source"><![CDATA[--[[
	AnimationController - animations custom de TOUS les personnages (R15), calculées localement à chaque frame.

	États (déduits de la vitesse répliquée, de l'état Humanoid et des Attributes Sliding / Dashing) :
		Idle  : respiration, transfert de poids, coup d'œil à gauche / droite toutes les ~4 s
		Walk  : petite foulée souple, bras bas, tête qui suit le pas
		Run   : penché en avant, bras pliés à 90° qui pompent, genoux hauts, rebond, rotation du torse
		Jump  : impulsion (jambes repliées, bras qui montent)
		Fall  : bras écartés qui moulinent, jambes qui cherchent le sol
		Land  : réception amortie 0.22 s (squash : bassin bas, genoux pliés, bras devant)
		Slide : corps renversé et abaissé, jambe avant tendue, bras d'équilibre, tête qui regarde devant
		Dash  : gainé, bras en arrière, jambes en ciseau
		Rip / Flinch : arrachage de queue (chasseur) / sursaut (capturé), superposés à l'état courant

	Procédural = on écrit Motor6D.Transform après l'Animator (RunService.Stepped). Le script "Animate" par défaut du
	joueur local est coupé. Si un ID est renseigné dans Config.Animations[état], cet état joue ta vraie animation
	(Animator, répliquée) et le procédural laisse la main pour cet état.
	Rig R6 : non géré (règle le jeu en R15 dans Game Settings > Avatar).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local JOINTS = {
	Root = { "LowerTorso", "Root" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" },
	RElbow = { "RightLowerArm", "RightElbow" },
	LElbow = { "LeftLowerArm", "LeftElbow" },
	RWrist = { "RightHand", "RightWrist" },
	LWrist = { "LeftHand", "LeftWrist" },
	RHip = { "RightUpperLeg", "RightHip" },
	LHip = { "LeftUpperLeg", "LeftHip" },
	RKnee = { "RightLowerLeg", "RightKnee" },
	LKnee = { "LeftLowerLeg", "LeftKnee" },
	RAnkle = { "RightFoot", "RightAnkle" },
	LAnkle = { "LeftFoot", "LeftAnkle" },
}

type Rig = {
	Char: Model, Hum: Humanoid, RootPart: BasePart,
	Motors: { [string]: Motor6D }, Current: { [string]: CFrame },
	Phase: number, Action: string?, ActionStart: number, ActionLen: number, Conns: { RBXScriptConnection },
	WasAir: boolean, LandAt: number, AirTime: number, Seed: number, State: string,
	Tracks: { [string]: AnimationTrack }, Playing: string?,
}

local rigs: { [Model]: Rig } = {}
local CUSTOM = {} -- états qui ont un vrai ID d'animation
for state, id in Config.Animations do
	if type(id) == "string" and id ~= "" then CUSTOM[state] = id end
end

local function A(x: number, y: number, z: number): CFrame
	return CFrame.Angles(x, y, z)
end

local function buildRig(char: Model): Rig?
	local hum = char:FindFirstChildOfClass("Humanoid")
	local rootPart = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not rootPart or hum.RigType ~= Enum.HumanoidRigType.R15 then return nil end
	local motors = {}
	for key, path in JOINTS do
		local part = char:FindFirstChild(path[1])
		local m = part and part:FindFirstChild(path[2])
		if m and m:IsA("Motor6D") then motors[key] = m end
	end
	if not motors.Root then return nil end
	local cur = {}
	for k in motors do cur[k] = CFrame.identity end
	return { Char = char, Hum = hum, RootPart = rootPart, Motors = motors, Current = cur, Phase = 0,
		Action = nil, ActionStart = 0, ActionLen = 0, Conns = {}, WasAir = false, LandAt = -10, AirTime = 0,
		Seed = math.random() * 100, State = "Idle", Tracks = {}, Playing = nil }
end

local function removeRig(char: Model)
	local r = rigs[char]
	if not r then return end
	for _, c in r.Conns do c:Disconnect() end
	for _, m in r.Motors do if m.Parent then m.Transform = CFrame.identity end end
	rigs[char] = nil
end

--- Vraies animations (si IDs fournis) : uniquement pour le personnage local, l'Animator les réplique.
local function playCustom(r: Rig, state: string)
	if r.Char ~= player.Character then return end
	local want = if CUSTOM[state] then state else nil
	if r.Playing == want then return end
	if r.Playing and r.Tracks[r.Playing] then r.Tracks[r.Playing]:Stop(0.15) end
	r.Playing = want
	if not want then return end
	local track = r.Tracks[want]
	if not track then
		local animator = r.Hum:FindFirstChildOfClass("Animator")
		if not animator then return end
		local anim = Instance.new("Animation")
		anim.AnimationId = CUSTOM[want]
		local ok, t = pcall(animator.LoadAnimation, animator, anim)
		if not ok then warn("[AnimationController] animation invalide pour " .. want .. " : " .. CUSTOM[want]); CUSTOM[want] = nil; return end
		t.Priority = if want == "Slide" or want == "Dash" then Enum.AnimationPriority.Action else Enum.AnimationPriority.Movement
		t.Looped = want ~= "Jump"
		r.Tracks[want] = t
		track = t
	end
	track:Play(0.15)
end

local function trackCharacter(char: Model)
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		char:WaitForChild("LowerTorso", 10)
		if not char.Parent then return end
		local r = buildRig(char)
		if not r then return end
		removeRig(char)
		rigs[char] = r
		if char == player.Character then
			-- coupe l'Animate par défaut : walk / run / idle / jump sont remplacés
			local anim = char:FindFirstChild("Animate")
			if anim and anim:IsA("LocalScript") then anim.Enabled = false end
			local animator = r.Hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, t in animator:GetPlayingAnimationTracks() do t:Stop(0) end
			end
		end
		table.insert(r.Conns, char.AncestryChanged:Connect(function()
			if not char.Parent then removeRig(char) end
		end))
		-- les parties du corps peuvent être remplacées au chargement de l'apparence
		table.insert(r.Conns, char.ChildAdded:Connect(function(c)
			if c:IsA("BasePart") then
				task.defer(function()
					local cur = rigs[char]
					if cur then
						local nr = buildRig(char)
						if nr then
							nr.Conns = cur.Conns
							nr.Tracks = cur.Tracks
							rigs[char] = nr
						end
					end
				end)
			end
		end))
	end)
end

local function playAction(char: Model?, name: string, length: number)
	local r = char and rigs[char]
	if not r then return end
	r.Action = name
	r.ActionStart = os.clock()
	r.ActionLen = length
end

-- =====================================================================
-- POSES
-- =====================================================================
local function stateOf(r: Rig, dt: number): (string, number, Vector3)
	local vel = r.RootPart.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local hs = r.Hum:GetState()
	local air = hs == Enum.HumanoidStateType.Freefall or hs == Enum.HumanoidStateType.Jumping
	local now = os.clock()
	if air then
		r.AirTime += dt
	elseif r.WasAir then
		if r.AirTime > 0.25 then r.LandAt = now end
		r.AirTime = 0
	end
	r.WasAir = air
	if r.Char:GetAttribute("Sliding") == true then return "Slide", speed, vel end
	if r.Char:GetAttribute("Dashing") == true then return "Dash", speed, vel end
	if air then return (if vel.Y > 2 then "Jump" else "Fall"), speed, vel end
	if now - r.LandAt < 0.22 then return "Land", speed, vel end
	if speed > Config.WalkRunThreshold then return "Run", speed, vel end
	if speed > 1.2 then return "Walk", speed, vel end
	return "Idle", speed, vel
end

local function computePose(r: Rig, state: string, speed: number, vel: Vector3, dt: number, t: number): { [string]: CFrame }
	local pose: { [string]: CFrame } = {}
	if state == "Slide" then
		local w = math.sin(t * 9) * 0.06
		pose.Root = CFrame.new(0, -1.15, 0.25) * A(1.05, 0, 0.05) -- abaissé juste assez pour l'ouverture des tunnels (3 studs) sans traverser le sol
		pose.Waist = A(-0.4, 0.18, 0)
		pose.Neck = A(-0.6, 0, 0)
		pose.RHip = A(1.3, 0, 0.06)
		pose.LHip = A(0.7, 0, -0.1)
		pose.RKnee = A(-0.08, 0, 0)
		pose.LKnee = A(-1.15, 0, 0)
		pose.RAnkle = A(0.4, 0, 0)
		pose.RShoulder = A(0.55 + w, 0, 1.3)
		pose.LShoulder = A(-0.7 - w, 0, -0.5)
		pose.RElbow = A(0.35, 0, 0)
		pose.LElbow = A(0.7, 0, 0)
	elseif state == "Dash" then
		pose.Root = CFrame.new(0, -0.15, 0) * A(-0.5, 0, 0)
		pose.Waist = A(-0.22, 0, 0)
		pose.Neck = A(0.4, 0, 0)
		pose.RShoulder = A(-1.35, 0, 0.3)
		pose.LShoulder = A(-1.35, 0, -0.3)
		pose.RElbow = A(0.15, 0, 0)
		pose.LElbow = A(0.15, 0, 0)
		pose.RHip = A(0.8, 0, 0)
		pose.LHip = A(-0.7, 0, 0)
		pose.RKnee = A(-0.7, 0, 0)
		pose.LKnee = A(-0.25, 0, 0)
	elseif state == "Jump" then
		local up = math.clamp(vel.Y / 50, 0, 1)
		pose.Root = A(-0.1, 0, 0)
		pose.Waist = A(0.08, 0, 0)
		pose.Neck = A(0.2 * up, 0, 0)
		pose.RShoulder = A(0.4 + 1.6 * up, 0, 0.35)
		pose.LShoulder = A(0.4 + 1.6 * up, 0, -0.35)
		pose.RElbow = A(0.4, 0, 0)
		pose.LElbow = A(0.4, 0, 0)
		pose.RHip = A(0.9, 0, 0.05)
		pose.LHip = A(0.25, 0, -0.05)
		pose.RKnee = A(-1.4, 0, 0)
		pose.LKnee = A(-0.5, 0, 0)
		pose.RAnkle = A(-0.3, 0, 0)
	elseif state == "Fall" then
		local m = math.sin(t * 11 + r.Seed)
		local fall = math.clamp(-vel.Y / 60, 0, 1)
		pose.Root = A(0.05, 0, 0)
		pose.Waist = A(-0.05, 0, m * 0.04)
		pose.Neck = A(-0.25 * fall, 0, 0)
		pose.RShoulder = A(0.5 + m * 0.35, 0, 1.4 + fall * 0.4)
		pose.LShoulder = A(0.5 - m * 0.35, 0, -1.4 - fall * 0.4)
		pose.RElbow = A(0.5, 0, 0)
		pose.LElbow = A(0.5, 0, 0)
		pose.RHip = A(0.35 + m * 0.15, 0, 0.08)
		pose.LHip = A(-0.15 - m * 0.15, 0, -0.08)
		pose.RKnee = A(-0.6, 0, 0)
		pose.LKnee = A(-0.3, 0, 0)
	elseif state == "Land" then
		local k = 1 - (os.clock() - r.LandAt) / 0.22
		pose.Root = CFrame.new(0, -0.65 * k, 0) * A(-0.25 * k, 0, 0)
		pose.Waist = A(-0.2 * k, 0, 0)
		pose.RHip = A(0.8 * k, 0, 0.06)
		pose.LHip = A(0.8 * k, 0, -0.06)
		pose.RKnee = A(-1.3 * k, 0, 0)
		pose.LKnee = A(-1.3 * k, 0, 0)
		pose.RAnkle = A(0.5 * k, 0, 0)
		pose.LAnkle = A(0.5 * k, 0, 0)
		pose.RShoulder = A(0.7 * k, 0, 0.5 * k)
		pose.LShoulder = A(0.7 * k, 0, -0.5 * k)
		pose.RElbow = A(0.4, 0, 0)
		pose.LElbow = A(0.4, 0, 0)
	elseif state == "Run" then
		local k = math.clamp(speed / 22, 0.6, 1.4)
		r.Phase += dt * (6.5 + speed * 0.38)
		local p = r.Phase
		local s, c = math.sin(p), math.cos(p)
		local leg = 0.75 * k
		pose.Root = CFrame.new(0, math.abs(c) * 0.3 * k - 0.12, 0) * A(-0.2 * k, s * 0.12, 0)
		pose.Waist = A(-0.12, -s * 0.32, s * 0.04)
		pose.Neck = A(0.22, s * 0.2, 0)
		pose.RHip = A(s * leg + 0.1, 0, 0)
		pose.LHip = A(-s * leg + 0.1, 0, 0)
		pose.RKnee = A(-0.2 - 1.5 * k * math.max(0, math.sin(p + 1.3)), 0, 0)
		pose.LKnee = A(-0.2 - 1.5 * k * math.max(0, math.sin(p + 1.3 + math.pi)), 0, 0)
		pose.RAnkle = A(0.3 * math.max(0, -s), 0, 0)
		pose.LAnkle = A(0.3 * math.max(0, s), 0, 0)
		pose.RShoulder = A(-s * 1.1 * k, 0, 0.18)
		pose.LShoulder = A(s * 1.1 * k, 0, -0.18)
		pose.RElbow = A(1.35, 0, 0)
		pose.LElbow = A(1.35, 0, 0)
		pose.RWrist = A(0.2, 0, 0)
		pose.LWrist = A(0.2, 0, 0)
	elseif state == "Walk" then
		r.Phase += dt * (4.5 + speed * 0.45)
		local p = r.Phase
		local s, c = math.sin(p), math.cos(p)
		pose.Root = CFrame.new(0, math.abs(c) * 0.1, 0) * A(-0.04, s * 0.06, s * 0.03)
		pose.Waist = A(0, -s * 0.12, -s * 0.03)
		pose.Neck = A(0.04, s * 0.08, s * 0.03)
		pose.RHip = A(s * 0.5, 0, 0)
		pose.LHip = A(-s * 0.5, 0, 0)
		pose.RKnee = A(-0.1 - 0.7 * math.max(0, math.sin(p + 1.2)), 0, 0)
		pose.LKnee = A(-0.1 - 0.7 * math.max(0, math.sin(p + 1.2 + math.pi)), 0, 0)
		pose.RShoulder = A(-s * 0.55, 0, 0.1)
		pose.LShoulder = A(s * 0.55, 0, -0.1)
		pose.RElbow = A(0.3 + math.max(0, -s) * 0.3, 0, 0)
		pose.LElbow = A(0.3 + math.max(0, s) * 0.3, 0, 0)
	else -- Idle
		local b = math.sin(t * 2.1 + r.Seed)
		local shift = math.sin(t * 0.55 + r.Seed)
		-- coup d'œil toutes les ~4 s
		local cyc = (t + r.Seed) % 4.2
		local look = if cyc < 0.9 then math.sin(cyc / 0.9 * math.pi) * (if math.floor((t + r.Seed) / 4.2) % 2 == 0 then 0.6 else -0.6) else 0
		pose.Root = CFrame.new(shift * 0.06, b * 0.035, 0) * A(0, 0, shift * 0.03)
		pose.Waist = A(b * 0.04, look * 0.25, -shift * 0.04)
		pose.Neck = A(-b * 0.05, look, 0)
		pose.RShoulder = A(0.06, 0, 0.12 + b * 0.05)
		pose.LShoulder = A(0.06, 0, -0.12 - b * 0.05)
		pose.RElbow = A(0.22, 0, 0)
		pose.LElbow = A(0.22, 0, 0)
		pose.RHip = A(0, 0, 0.04 - shift * 0.03)
		pose.LHip = A(0, 0, -0.04 - shift * 0.03)
		pose.RKnee = A(-0.05 - math.max(0, shift) * 0.12, 0, 0)
		pose.LKnee = A(-0.05 - math.max(0, -shift) * 0.12, 0, 0)
	end

	-- actions ponctuelles superposées
	if r.Action then
		local a = (os.clock() - r.ActionStart) / r.ActionLen
		if a >= 1 then
			r.Action = nil
		elseif r.Action == "Rip" then
			local grab = math.clamp(a / 0.35, 0, 1)
			local pull = math.clamp((a - 0.35) / 0.65, 0, 1)
			pose.RShoulder = A(1.8 * grab - 2.5 * pull, 0, 0.2)
			pose.RElbow = A(0.15 + 1.0 * pull, 0, 0)
			pose.RWrist = A(-0.5 * pull, 0, 0)
			pose.Waist = (pose.Waist or CFrame.identity) * A(0, -0.6 * grab + 1.1 * pull, 0)
			pose.Neck = A(0.1, -0.4 * grab + 0.6 * pull, 0)
		elseif r.Action == "Flinch" then
			local f = math.sin(a * math.pi)
			pose.RShoulder = A(0.4 * f, 0, 1.7 * f)
			pose.LShoulder = A(0.4 * f, 0, -1.7 * f)
			pose.Waist = (pose.Waist or CFrame.identity) * A(0.4 * f, 0, 0)
			pose.Neck = A(0.45 * f, 0, 0)
		end
	end
	return pose
end

local BLEND = { Slide = 22, Dash = 24, Land = 26, Jump = 16, Fall = 10, Run = 15, Walk = 12, Idle = 8 }

RunService.Stepped:Connect(function(_, dt)
	local t = os.clock()
	for _, r in rigs do
		if r.Hum.Health > 0 and r.RootPart.Parent then
			local state, speed, vel = stateOf(r, dt)
			r.State = state
			playCustom(r, state)
			if CUSTOM[state] then
				-- ta vraie animation pilote cet état : on relâche les joints
				for key, motor in r.Motors do
					r.Current[key] = CFrame.identity
					_ = motor
				end
				continue
			end
			local pose = computePose(r, state, speed, vel, dt, t)
			local alpha = 1 - math.exp(-dt * (BLEND[state] or 14))
			for key, motor in r.Motors do
				local target = pose[key] or CFrame.identity
				local cur = (r.Current[key] or CFrame.identity):Lerp(target, alpha)
				r.Current[key] = cur
				if motor.Parent then motor.Transform = cur end
			end
		end
	end
end)

-- =====================================================================
-- SUIVI DES PERSONNAGES
-- =====================================================================
local function onPlayer(p: Player)
	p.CharacterAdded:Connect(trackCharacter)
	if p.Character then trackCharacter(p.Character) end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do onPlayer(p) end
Players.PlayerRemoving:Connect(function(p)
	if p.Character then removeRig(p.Character) end
end)

Remotes.Captured.OnClientEvent:Connect(function(hunter: Player, runner: Player)
	if hunter and hunter.Character then playAction(hunter.Character, "Rip", 0.55) end
	if runner and runner.Character then playAction(runner.Character, "Flinch", 0.45) end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000032"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--[[
	EffectsController - "juice" côté client (aucune logique de jeu ici).
		* balancement procédural des queues de tous les personnages (C0 des Joints)
		* traînée de dash (skin équipé, Attribute "TrailSkin") + élargissement bref du FOV pour le joueur local
		* poussière + son pendant le slide
		* capture : la queue vole vers le chasseur (arc + rotation), effet de capture du chasseur, sons, screen shake
		* jump pads : burst de particules
		* musique lobby / manche selon l'état
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local TailBuilder = require(ReplicatedStorage.Shared.TailBuilder)
local Signals = require(ReplicatedStorage.Shared.ClientSignals)
local Audio = require(ReplicatedStorage.Shared.Audio)
local Icons = require(ReplicatedStorage:WaitForChild("CheckUIIcons"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- =====================================================================
-- QUEUES : balancement procédural
-- =====================================================================
type TailData = { Joints: { Weld }, Root: BasePart?, Seed: number }
local tails: { [Model]: TailData } = {}

local function registerTail(char: Model, tail: Instance)
	local joints = {}
	for _, d in tail:GetDescendants() do
		if d:IsA("Weld") and d.Name == "Joint" then table.insert(joints, d) end
	end
	table.sort(joints, function(a, b) return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0) end)
	tails[char] = { Joints = joints, Root = char:FindFirstChild("HumanoidRootPart") :: BasePart?, Seed = math.random() * 10 }
end

local function watchCharacter(char: Model)
	local t = char:FindFirstChild("Tail")
	if t then registerTail(char, t) end
	char.ChildAdded:Connect(function(c)
		if c.Name == "Tail" then task.defer(registerTail, char, c) end
	end)
	char.ChildRemoved:Connect(function(c)
		if c.Name == "Tail" then tails[char] = nil end
	end)
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for char, d in tails do
		if not char.Parent then
			tails[char] = nil
			continue
		end
		local root = d.Root
		local vel = if root then root.AssemblyLinearVelocity else Vector3.zero
		local localVel = if root then root.CFrame:VectorToObjectSpace(vel) else Vector3.zero
		local fwd = math.clamp(-localVel.Z / 24, -0.5, 1.6)   -- vitesse vers l'avant -> la queue se soulève en arrière
		local side = math.clamp(localVel.X / 24, -1, 1)
		local fall = math.clamp(vel.Y / 40, -1, 1)
		-- en slide le torse bascule en arrière : on relève la queue pour qu'elle traîne derrière au lieu de rentrer dans le sol
		local slideLift = if char:GetAttribute("Sliding") == true then -1.9 else 0
		for i, j in d.Joints do
			local base = j:GetAttribute("BaseC0")
			if typeof(base) == "CFrame" and j.Parent then
				local w = i / #d.Joints
				local wave = math.sin(t * (5 + fwd * 5) - i * 0.7 + d.Seed) * (0.12 + 0.18 * fwd) * (0.4 + w)
				local sway = math.sin(t * 1.9 + i * 0.5 + d.Seed) * 0.12 * (0.5 + w)
				local lift = -(0.28 * fwd + 0.15 * fall) * (if i == 1 then 1.4 else 0.55) + (if i == 1 then slideLift else slideLift * 0.04)
				j.C0 = base * CFrame.Angles(lift + wave, 0, sway - side * 0.25 * w)
			end
		end
	end
end)

-- =====================================================================
-- TRAÎNÉE DE DASH / POUSSIÈRE DE SLIDE (tous les personnages)
-- =====================================================================
local function trailItemFor(p: Player?)
	local id = p and p:GetAttribute("TrailSkin")
	return Cosmetics.Get(id) or Cosmetics.Get(Cosmetics.DefaultFor("Trail"))
end

local function ensureTrail(char: Model): Trail?
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end
	local tr = root:FindFirstChild("TC_DashTrail") :: Trail?
	local p = Players:GetPlayerFromCharacter(char)
	local item = trailItemFor(p)
	if not tr then
		local a0 = Instance.new("Attachment"); a0.Name = "TC_TrailTop"; a0.Position = Vector3.new(0, 1.2, 0.3); a0.Parent = root
		local a1 = Instance.new("Attachment"); a1.Name = "TC_TrailBottom"; a1.Position = Vector3.new(0, -1.6, 0.3); a1.Parent = root
		local newTr = Instance.new("Trail")
		newTr.Name = "TC_DashTrail"
		newTr.Attachment0 = a0
		newTr.Attachment1 = a1
		newTr.Lifetime = 0.35
		newTr.MinLength = 0.05
		newTr.LightEmission = 0.8
		newTr.FaceCamera = true
		newTr.Transparency = NumberSequence.new(0.1, 1)
		newTr.WidthScale = NumberSequence.new(1, 0.2)
		newTr.Enabled = false
		newTr.Parent = root
		tr = newTr
	end
	if item and item.Colors and tr then
		local cs = item.Colors
		tr.Color = if #cs >= 2 then ColorSequence.new(cs[1], cs[#cs]) else ColorSequence.new(cs[1])
	end
	return tr
end

local function ensureDust(char: Model): ParticleEmitter?
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end
	local pe = root:FindFirstChild("TC_SlideDust") :: ParticleEmitter?
	if pe then return pe end
	local att = Instance.new("Attachment"); att.Name = "TC_Feet"; att.Position = Vector3.new(0, -2.6, 0); att.Parent = root
	local e = Instance.new("ParticleEmitter")
	e.Name = "TC_SlideDust"
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(235, 220, 200))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.4) })
	e.Transparency = NumberSequence.new(0.35, 1)
	e.Lifetime = NumberRange.new(0.4, 0.7)
	e.Rate = 45
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(70, 20)
	e.Acceleration = Vector3.new(0, 3, 0)
	e.Enabled = false
	e.Parent = att
	return e
end

local function watchMovementFx(char: Model)
	char:GetAttributeChangedSignal("Dashing"):Connect(function()
		local on = char:GetAttribute("Dashing") == true
		local tr = ensureTrail(char)
		if not tr then return end
		if on then
			tr.Enabled = true
			if char ~= player.Character then
				Audio.Play("Dash", char:FindFirstChild("HumanoidRootPart"), 0.05)
			end
		else
			task.delay(0.2, function() if tr.Parent then tr.Enabled = false end end)
		end
	end)
	char:GetAttributeChangedSignal("Sliding"):Connect(function()
		local on = char:GetAttribute("Sliding") == true
		local dust = ensureDust(char)
		if dust then dust.Enabled = on end
		if on and char ~= player.Character then
			Audio.Play("Slide", char:FindFirstChild("HumanoidRootPart"), 0.05)
		end
	end)
end

local function onCharacter(char: Model)
	char:WaitForChild("HumanoidRootPart", 10)
	watchCharacter(char)
	watchMovementFx(char)
end

local function onPlayer(p: Player)
	p.CharacterAdded:Connect(onCharacter)
	if p.Character then task.spawn(onCharacter, p.Character) end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do onPlayer(p) end

-- dash local : traînée immédiate (sans attendre le serveur) + FOV
local baseFov = camera.FieldOfView
Signals.Connect("Dash", function()
	local char = player.Character
	if char then
		local tr = ensureTrail(char)
		if tr then
			tr.Enabled = true
			task.delay(Config.DashDuration + 0.25, function() if tr.Parent and char:GetAttribute("Dashing") ~= true then tr.Enabled = false end end)
		end
	end
	baseFov = if camera.FieldOfView > 60 and camera.FieldOfView < 90 then camera.FieldOfView else 70
	local up = TweenService:Create(camera, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = baseFov + Config.DashFovBoost })
	up:Play()
	task.delay(0.12, function()
		TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = baseFov }):Play()
	end)
	Signals.Fire("Shake", 0.25, 0.12)
end)

Signals.Connect("Slide", function(on: boolean)
	local char = player.Character
	local dust = char and ensureDust(char)
	if dust then dust.Enabled = on end
end)

-- =====================================================================
-- SCREEN SHAKE
-- =====================================================================
local shakeUntil, shakeAmp = 0, 0
Signals.Connect("Shake", function(amp: number, duration: number)
	shakeAmp = math.max(shakeAmp, amp)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end)
RunService:BindToRenderStep("TC_Shake", Enum.RenderPriority.Camera.Value + 1, function()
	local t = os.clock()
	if t < shakeUntil then
		local a = shakeAmp * math.clamp((shakeUntil - t) * 4, 0, 1)
		camera.CFrame = camera.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * a * 6), math.rad((math.random() - 0.5) * a * 6), 0)
	else
		shakeAmp = 0
	end
end)

-- =====================================================================
-- CAPTURE : la queue vole vers le chasseur
-- =====================================================================
local FX_TEXTURE = {
	Puff = "rbxasset://textures/particles/smoke_main.dds",
	Stars = Icons.Get("Main/Star/Golden Star 1st Outline"),
	Hearts = Icons.Get("Main/Heart/Heart 1st Outline"),
	Skull = Icons.Get("Player/Skull/Skull 1st Outline"),
	Coins = Icons.Get("Currency/Coin/Golden Coin 1st Outline"),
}

local function burst(pos: Vector3, fxId: string?)
	local item = Cosmetics.Get(fxId) or Cosmetics.Get(Cosmetics.DefaultFor("Capture"))
	local kind = item and item.Fx or "Puff"
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = FX_TEXTURE[kind] or FX_TEXTURE.Puff
	e.Color = ColorSequence.new(if kind == "Puff" then Color3.new(1, 1, 1) else Color3.new(1, 1, 1))
	e.Size = if kind == "Puff" then NumberSequence.new(1.5, 3.5) else NumberSequence.new(1.4, 0.4)
	e.Transparency = NumberSequence.new(0, 1)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Speed = NumberRange.new(12, 22)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(-30, 30)
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Acceleration = Vector3.new(0, if kind == "Puff" then 4 else -30, 0)
	e.Drag = 3
	e.Rate = 0
	e.Parent = p
	e:Emit(if kind == "Puff" then 18 else 24)
	-- anneau de choc
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = item and item.Color or Color3.new(1, 1, 1)
	ring.Size = Vector3.new(0.2, 2, 2)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.2
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.2, 14, 14), Transparency = 1 }):Play()
	Debris:AddItem(p, 2)
	Debris:AddItem(ring, 0.5)
end

Remotes.Captured.OnClientEvent:Connect(function(hunter: Player, runner: Player, skin: string?, fxId: string?, tailCF: CFrame?)
	local hChar = hunter and hunter.Character
	local rChar = runner and runner.Character
	local hRoot = hChar and hChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local rRoot = rChar and rChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local startCF = tailCF or (rRoot and rRoot.CFrame * CFrame.new(0, 0, 0.8))
	if rRoot then Audio.Play("CaptureWhoosh", rRoot, 0.05) end

	-- secousse : forte pour les 2 joueurs concernés, légère pour les proches
	local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if player == hunter or player == runner then
		Signals.Fire("Shake", 1, 0.35)
	elseif me and rRoot and (me.Position - rRoot.Position).Magnitude < 40 then
		Signals.Fire("Shake", 0.35, 0.2)
	end

	if not startCF or not hRoot then
		if hRoot then burst(hRoot.Position, fxId) end
		return
	end
	-- queue volante (copie locale, purement visuelle)
	local tail = TailBuilder.Build(skin, nil)
	local seg1 = tail:FindFirstChild("Seg1") :: BasePart
	for _, d in tail:GetDescendants() do
		if d:IsA("BasePart") then d.Anchored = false end
	end
	seg1.Anchored = true
	seg1.CFrame = startCF
	tail.Parent = workspace
	local t0 = os.clock()
	local DUR = 0.45
	local from = startCF.Position
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / DUR, 0, 1)
		local target = if hRoot.Parent then hRoot.Position + Vector3.new(0, 0.5, 0) else from
		local e = 1 - (1 - a) ^ 3
		local pos = from:Lerp(target, e) + Vector3.new(0, math.sin(a * math.pi) * 5, 0)
		local scale = 1 - 0.6 * a
		_ = scale
		seg1.CFrame = CFrame.new(pos) * CFrame.Angles(a * 9, a * 6, 0)
		if a >= 1 then
			conn:Disconnect()
			tail:Destroy()
			burst(target, fxId)
			Audio.Play("Capture", hRoot)
		end
	end)
end)

-- =====================================================================
-- JUMP PADS
-- =====================================================================
Signals.Connect("JumpPad", function(pad: BasePart)
	local att = pad:FindFirstChildOfClass("Attachment")
	local pe = att and att:FindFirstChildOfClass("ParticleEmitter")
	if pe then pe:Emit(25) end
	Signals.Fire("Shake", 0.2, 0.1)
end)

-- =====================================================================
-- MUSIQUE
-- =====================================================================
local function updateMusic()
	local state = ReplicatedStorage:GetAttribute("GameState")
	local role = player:GetAttribute("Role")
	if (state == Config.States.Round or state == Config.States.Countdown) and role ~= "Lobby" then
		Audio.Music("MusicRound")
	else
		Audio.Music("MusicLobby")
	end
end
ReplicatedStorage:GetAttributeChangedSignal("GameState"):Connect(updateMusic)
player:GetAttributeChangedSignal("Role"):Connect(updateMusic)
updateMusic()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000033"><Properties><string name="Name">MovementController</string><ProtectedString name="Source"><![CDATA[--[[
	MovementController - dash, slide et jump pads du joueur local.
		Dash  : Q / Shift / bouton mobile / manette X  -> impulsion horizontale, cooldown Config.DashCooldown
		Slide : C / Ctrl  / bouton mobile / manette Y  -> glissade qui conserve l'élan ; le personnage passe dans le
		        CollisionGroup "Sliders" (hitbox réduite) et traverse les plafonds des mini-tunnels.
		        Si le slide se termine sous un plafond, on reste accroupi (vitesse réduite) jusqu'à la sortie.
	La physique est appliquée localement (réactivité), le serveur valide les cooldowns (MovementService).
	Toutes les connexions liées au personnage sont déconnectées à sa mort / respawn.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Signals = require(ReplicatedStorage.Shared.ClientSignals)
local Audio = require(ReplicatedStorage.Shared.Audio)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local State = Signals.State

local char: Model?, hum: Humanoid?, root: BasePart?
local charConns: { RBXScriptConnection } = {}

local sliding = false
local crouchLocked = false
local slideReadyAt = 0
local lastPad = 0
local baseWalkSpeed: number? = nil

local function disconnectAll()
	for _, c in charConns do c:Disconnect() end
	table.clear(charConns)
end

local function frozen(): boolean
	return player:GetAttribute("Frozen") == true
end

local function alive(): boolean
	return hum ~= nil and root ~= nil and hum.Health > 0 and root.Parent ~= nil
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function setGroup(group: string)
	if not char then return end
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and d.Parent and d.Parent.Name ~= "Tail" then
			d.CollisionGroup = group
		end
	end
end

--- Contrainte de vitesse horizontale (Y libre) attachée au RootAttachment.
local function makeMover(name: string): LinearVelocity?
	if not root then return nil end
	local att = root:FindFirstChild("RootAttachment") or root:FindFirstChildOfClass("Attachment")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "RootAttachment"
		att.Parent = root
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = name
	lv.Attachment0 = att :: Attachment
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.MaxAxesForce = Vector3.new(1e5, 0, 1e5)
	lv.Parent = root
	return lv
end

local function moveDir(): Vector3
	if not hum or not root then return Vector3.new(0, 0, -1) end
	local md = flat(hum.MoveDirection)
	if md.Magnitude > 0.1 then return md.Unit end
	local look = flat(root.CFrame.LookVector)
	return if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
end

-- =====================================================================
-- DASH
-- =====================================================================
local function dash()
	if not alive() or frozen() or crouchLocked then return end
	local t = os.clock()
	if t < State.DashReadyAt then return end
	State.DashReadyAt = t + Config.DashCooldown
	State.DashCooldown = Config.DashCooldown
	Remotes.MoveAction:FireServer("Dash")
	Signals.Fire("Dash", Config.DashCooldown)
	Audio.Play("Dash", root, 0.05)

	local dir = moveDir()
	local lv = makeMover("DashVelocity")
	if not lv then return end
	lv.VectorVelocity = dir * Config.DashSpeed
	local r = root :: BasePart
	task.delay(Config.DashDuration, function()
		lv:Destroy()
		-- on garde un peu d'élan à la sortie
		if r.Parent then
			local v = r.AssemblyLinearVelocity
			r.AssemblyLinearVelocity = Vector3.new(dir.X * Config.RunnerWalkSpeed * 1.4, v.Y, dir.Z * Config.RunnerWalkSpeed * 1.4)
		end
	end)
end

-- =====================================================================
-- SLIDE
-- =====================================================================
local ceilingParams = RaycastParams.new()
ceilingParams.FilterType = Enum.RaycastFilterType.Include

local function underCeiling(): boolean
	if not root then return false end
	ceilingParams.FilterDescendantsInstances = CollectionService:GetTagged("SlideCeiling")
	local origin = root.Position - Vector3.new(0, 1.5, 0)
	-- plusieurs rayons : centre + devant / derrière
	for _, off in { Vector3.zero, root.CFrame.LookVector * 1.2, -root.CFrame.LookVector * 1.2 } do
		if workspace:Raycast(origin + off, Vector3.new(0, 5, 0), ceilingParams) then return true end
	end
	return false
end

local function standUp()
	if not hum then return end
	sliding = false
	crouchLocked = false
	State.Sliding = false
	setGroup("Default")
	if baseWalkSpeed and not frozen() then
		-- vitesse du rôle courant (le rôle a pu changer pendant le slide)
		local role = player:GetAttribute("Role")
		hum.WalkSpeed = if role == "Hunter" then Config.HunterWalkSpeed elseif role == "Runner" then Config.RunnerWalkSpeed else Config.LobbyWalkSpeed
	end
	baseWalkSpeed = nil
	TweenService:Create(hum, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { CameraOffset = Vector3.zero }):Play()
	Remotes.MoveAction:FireServer("SlideEnd")
	Signals.Fire("Slide", false)
end

local function slide()
	if not alive() or frozen() or sliding then return end
	local h = hum :: Humanoid
	local r = root :: BasePart
	if h.FloorMaterial == Enum.Material.Air then return end
	local t0 = os.clock()
	if t0 < slideReadyAt then return end
	slideReadyAt = t0 + Config.SlideCooldown + Config.SlideDuration

	sliding = true
	State.Sliding = true
	setGroup("Sliders")
	Remotes.MoveAction:FireServer("SlideStart")
	Signals.Fire("Slide", true)
	Audio.Play("Slide", r, 0.05)
	TweenService:Create(h, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { CameraOffset = Vector3.new(0, Config.SlideCameraOffset, 0) }):Play()

	local v = flat(r.AssemblyLinearVelocity)
	local dir = if v.Magnitude > 2 then v.Unit else moveDir()
	local speed = math.clamp(math.max(v.Magnitude, h.WalkSpeed) * Config.SlideBoost, Config.SlideMinSpeed, Config.SlideMaxSpeed)
	local lv = makeMover("SlideVelocity")
	baseWalkSpeed = h.WalkSpeed

	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function(dt)
		if not alive() or not sliding or frozen() then
			conn:Disconnect()
			if lv then lv:Destroy() end
			if sliding then standUp() end
			return
		end
		local elapsed = os.clock() - t0
		local jumped = h:GetState() == Enum.HumanoidStateType.Jumping
		if lv and (elapsed < Config.SlideDuration and not jumped) then
			-- léger contrôle de direction + friction
			local md = flat(h.MoveDirection)
			if md.Magnitude > 0.1 then dir = (dir + md.Unit * dt * 2.2).Unit end
			speed = math.max(Config.SlideCrouchSpeed, speed * (1 - Config.SlideFriction * dt * 0.5))
			lv.VectorVelocity = dir * speed
			return
		end
		if lv then
			lv:Destroy()
			lv = nil
			-- conserve l'élan à la sortie (et sur un saut)
			local cur = r.AssemblyLinearVelocity
			r.AssemblyLinearVelocity = Vector3.new(dir.X * speed, cur.Y, dir.Z * speed)
		end
		if underCeiling() then
			-- encore sous un tunnel : on reste accroupi
			crouchLocked = true
			h.WalkSpeed = Config.SlideCrouchSpeed
			return
		end
		conn:Disconnect()
		standUp()
	end)
	table.insert(charConns, conn)
end

-- =====================================================================
-- JUMP PADS
-- =====================================================================
local padParams = RaycastParams.new()
padParams.FilterType = Enum.RaycastFilterType.Include

local function checkPads()
	if not alive() or frozen() then return end
	local r = root :: BasePart
	local h = hum :: Humanoid
	if os.clock() - lastPad < Config.JumpPadCooldown then return end
	padParams.FilterDescendantsInstances = CollectionService:GetTagged("JumpPad")
	local hit = workspace:Raycast(r.Position, Vector3.new(0, -(h.HipHeight + 2.2), 0), padParams)
	if hit and hit.Instance then
		lastPad = os.clock()
		local pad = hit.Instance
		local power = pad:GetAttribute("Power") or Config.JumpPadPower
		local push = pad:GetAttribute("Push") or Vector3.zero
		h:ChangeState(Enum.HumanoidStateType.Jumping)
		local cur = flat(r.AssemblyLinearVelocity)
		r.AssemblyLinearVelocity = Vector3.new(push.X + cur.X * 0.3, power, push.Z + cur.Z * 0.3)
		Audio.Play("JumpPad", r, 0.05)
		Signals.Fire("JumpPad", pad)
	end
end

-- =====================================================================
-- PERSONNAGE
-- =====================================================================
local function onCharacter(c: Model)
	disconnectAll()
	sliding, crouchLocked, baseWalkSpeed = false, false, nil
	State.Sliding = false
	char = c
	hum = c:WaitForChild("Humanoid", 10) :: Humanoid
	root = c:WaitForChild("HumanoidRootPart", 10) :: BasePart
	if not hum or not root then return end
	table.insert(charConns, RunService.Heartbeat:Connect(checkPads))
	table.insert(charConns, hum.Died:Connect(function()
		sliding = false
		State.Sliding = false
		disconnectAll()
	end))
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then task.spawn(onCharacter, player.Character) end

player:GetAttributeChangedSignal("Frozen"):Connect(function()
	if frozen() and sliding then standUp() end
end)

-- refus serveur du dash (cooldown) : on resynchronise le cooldown local
player:GetAttributeChangedSignal("DashRejected"):Connect(function()
	State.DashReadyAt = math.max(State.DashReadyAt, os.clock() + 0.5)
end)

-- =====================================================================
-- ENTRÉES
-- =====================================================================
local function onAction(name: string, inputState: Enum.UserInputState)
	if inputState ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	if name == "TC_Dash" then dash() elseif name == "TC_Slide" then slide() end
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindActionAtPriority("TC_Dash", onAction, false, Enum.ContextActionPriority.High.Value,
	Enum.KeyCode.Q, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonX)
ContextActionService:BindActionAtPriority("TC_Slide", onAction, false, Enum.ContextActionPriority.High.Value,
	Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonY)

-- boutons tactiles (créés par UIController)
Signals.Connect("MobileAction", function(name: string)
	if name == "Dash" then dash() elseif name == "Slide" then slide() end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX0000003D"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--[[
	UIController - construit TOUTE l'interface avec le kit StudUI (une seule fois, ScreenGuis ResetOnSpawn = false)
	et la branche aux Remotes / Attributes. Animations et sons via StudMotion.

	Pourquoi au runtime et pas en Edit dans StarterGui : le projet est livré en fichiers (Rojo, sans MCP Studio).
	Les builders sont des fonctions pures (comme les exemples du kit) : tu peux les exécuter depuis la barre de
	commande Studio pour figer l'UI dans StarterGui si tu préfères, sans rien changer d'autre.

	Modules : Hud, LobbyMenu, Collection (Shop + Inventaire), Results, Screens (notifications + écran de rôle)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UI = require(ReplicatedStorage:WaitForChild("StudUI"))
local Motion = require(ReplicatedStorage:WaitForChild("StudMotion"))
local Icons = require(ReplicatedStorage:WaitForChild("CheckUIIcons"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared.Cosmetics)
local Signals = require(Shared.ClientSignals)
local Audio = require(Shared.Audio)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Hud = require(script.Hud)
local LobbyMenu = require(script.LobbyMenu)
local Collection = require(script.Collection)
local Results = require(script.Results)
local Screens = require(script.Screens)
local AdminPanel = require(script.AdminPanel)
local Tutorial = require(script.Tutorial)
local MapVote = require(script.MapVote)
local AssetGuard = require(script.AssetGuard)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local S = Config.States

-- dossier de sons partagé par les éléments HUD (les fenêtres ont leur propre dossier "Sons")
local sons = Instance.new("Folder")
sons.Name = "SonsUI"
sons.Parent = playerGui
Motion.CreateSounds(sons)

local profile = nil
local ctx = {
	UI = UI, Motion = Motion, Icons = Icons, Config = Config, Cosmetics = Cosmetics, Signals = Signals, Audio = Audio,
	PlayerGui = playerGui, Sons = sons, Player = player,
	Abbreviate = function(n: number) return Motion.Abbreviate(n, "") end,
	Duration = Motion.Duration,
}

-- =====================================================================
-- PROFIL (défini avant les builders : les fenêtres l'utilisent dès leur construction)
-- =====================================================================
local hud, shop, inventory, lobbyMenu, tutorial
local tutoShown = false
function ctx.GetProfile() return profile end
function ctx.SetProfile(p)
	if not p then return end
	profile = p
	if hud then hud.SetCoins(p.Coins) end
	if shop then shop.Refresh(p) end
	if inventory then inventory.Refresh(p) end
	if lobbyMenu then lobbyMenu.SetProfile(p) end
	-- tutoriel automatique au tout premier passage
	if tutorial and not p.TutorialDone and not tutoShown then
		tutoShown = true
		task.delay(1.5, function() if not ctx.InRound() then tutorial.Open() end end)
	end
end

hud = Hud.Build(ctx)
local notifs = Screens.BuildNotifications(ctx)
local roleScreen = Screens.BuildRoleScreen(ctx)
shop = Collection.Build(ctx, "Shop")
inventory = Collection.Build(ctx, "Inventory")
local results = Results.Build(ctx)
local banner = Screens.BuildBanner(ctx)
local admin = AdminPanel.Build(ctx)
tutorial = Tutorial.Build(ctx)
ctx.Notify = function(text, kind) notifs.Push(text, kind) end

local function inRoundForMe(): boolean
	local st = ReplicatedStorage:GetAttribute("GameState")
	local role = player:GetAttribute("Role")
	return (st == S.Round or st == S.Countdown) and role ~= "Lobby" and role ~= nil
end
ctx.InRound = inRoundForMe
-- les menus ne s'ouvrent pas en pleine manche
ctx.OpenShop = function() if not inRoundForMe() then shop.Open() end end
ctx.OpenInventory = function() if not inRoundForMe() then inventory.Open() end end
ctx.OpenTutorial = function() if not inRoundForMe() then tutorial.Open() end end
ctx.OpenAdmin = function() admin.Open() end
local mapVote = MapVote.Build(ctx)
ctx.OpenVote = function() if not inRoundForMe() then mapVote.Open() end end
ctx.CloseAll = function()
	for _, m in { shop, inventory, tutorial, admin, mapVote } do m.Close() end
end
lobbyMenu = LobbyMenu.Build(ctx)
if profile then lobbyMenu.SetProfile(profile) end
Remotes.DataUpdated.OnClientEvent:Connect(ctx.SetProfile)
task.spawn(function()
	local ok, p = pcall(Remotes.GetProfile.InvokeServer, Remotes.GetProfile)
	if ok and p then ctx.SetProfile(p) end
end)

-- =====================================================================
-- RÔLE / STATS
-- =====================================================================
local function refreshRole()
	hud.SetRole(player:GetAttribute("Role") or "Lobby")
end
player:GetAttributeChangedSignal("Role"):Connect(refreshRole)
refreshRole()

player:GetAttributeChangedSignal("TailsTaken"):Connect(function()
	hud.SetTails(player:GetAttribute("TailsTaken") or 0)
end)
hud.SetTails(0)

-- =====================================================================
-- ÉTAT DE PARTIE
-- =====================================================================
local STATE_LABEL = {
	[S.Lobby] = "EN ATTENTE",
	[S.Intermission] = "INTERMISSION",
	[S.Countdown] = "PRÉPAREZ-VOUS",
	[S.Round] = "MANCHE",
	[S.Results] = "RÉSULTATS",
}

local function onState()
	local st = ReplicatedStorage:GetAttribute("GameState") or S.Lobby
	hud.SetState(STATE_LABEL[st] or st)
	local playing = inRoundForMe()
	lobbyMenu.SetVisible(not playing)
	if playing then
		shop.Close()
		inventory.Close()
		tutorial.Close()
		mapVote.Close()
		task.delay(0.35, function() lobbyMenu.SetVisible(not inRoundForMe()) end)
	end
	if st == S.Lobby or st == S.Results then roleScreen.Hide() end
end
ReplicatedStorage:GetAttributeChangedSignal("GameState"):Connect(onState)
player:GetAttributeChangedSignal("Role"):Connect(onState)
onState()

-- minuteur / sous-titre / restants / cooldown du dash
RunService.RenderStepped:Connect(function()
	local st = ReplicatedStorage:GetAttribute("GameState") or S.Lobby
	local endsAt = ReplicatedStorage:GetAttribute("EndsAt") or 0
	local now = workspace:GetServerTimeNow()
	local left = math.max(0, endsAt - now)
	if st == S.Lobby then
		local ready = ReplicatedStorage:GetAttribute("ReadyCount") or 0
		local min = ReplicatedStorage:GetAttribute("MinPlayers") or Config.MinPlayers
		hud.SetTimer(("%d/%d"):format(ready, min))
		hud.SetSub(if player:GetAttribute("Ready") then "Joueurs prêts" else 'Clique sur <font color="#B4FF3C">JOUER</font> pour participer')
	else
		hud.SetTimer(Motion.Duration(math.ceil(left)), st == S.Round and left <= 15)
		local release = ReplicatedStorage:GetAttribute("HuntersReleaseAt") or 0
		if st == S.Round and now < release then
			hud.SetSub(('Chasseurs lâchés dans <font color="#FF5A6A">%d</font>'):format(math.ceil(release - now)))
		elseif st == S.Round or st == S.Countdown then
			hud.SetSub(('Map : <font color="#FFD23F">%s</font>'):format(ReplicatedStorage:GetAttribute("MapName") or "?"))
		elseif st == S.Intermission then
			hud.SetSub(if player:GetAttribute("Ready") then "La manche commence bientôt !" else 'Clique sur <font color="#B4FF3C">JOUER</font> pour participer')
		else
			hud.SetSub("")
		end
	end
	if st == S.Round or st == S.Countdown then
		local r = ReplicatedStorage:GetAttribute("RunnersLeft") or 0
		hud.SetRemaining(("%d participant%s"):format(r, if r > 1 then "s" else ""))
	else
		hud.SetRemaining("")
	end
	hud.UpdateDash(Signals.State.DashReadyAt, Signals.State.DashCooldown)
	admin.Update()
	mapVote.Update()
	hud.SetVoteVisible(st == S.Intermission and mapVote.HasVote())
end)

-- =====================================================================
-- REMOTES
-- =====================================================================
Remotes.Notify.OnClientEvent:Connect(function(text: string, kind: string?)
	notifs.Push(text, kind)
	if kind == "success" then Signals.Fire("Shake", 0.5, 0.2) end
end)

Remotes.RoleAssigned.OnClientEvent:Connect(function(role: string, countdown: number)
	roleScreen.Show(role, countdown)
end)

Remotes.Results.OnClientEvent:Connect(function(data)
	roleScreen.Hide()
	results.Show(data)
end)

Remotes.OpenMenu.OnClientEvent:Connect(function(which: string)
	if inRoundForMe() then return end
	if which == "Shop" then shop.Open() elseif which == "Inventory" then inventory.Open() end
end)

Remotes.Captured.OnClientEvent:Connect(function(hunter: Player, runner: Player, skin: string?)
	if hunter == player then
		hud.SetTails(player:GetAttribute("TailsTaken") or 0)
		local item = Cosmetics.Get(skin) or Cosmetics.Get(Cosmetics.DefaultFor("Tail"))
		banner.Show("Queue prise !", item and item.Icon or "Exclusive/Trail/Red Trail 1st Outline",
			runner and runner.DisplayName or "?", "+" .. Config.Coins.PerTail)
	end
end)

-- vérifie que toutes les images de l'UI se chargent ; remplace celles qui sont indisponibles
task.delay(2, function()
	AssetGuard.Run(ctx, { playerGui })
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">AdminPanel</string><ProtectedString name="Source"><![CDATA[--[[
	AdminPanel - fenêtre "Admin" (archétype D "upgrade / prestige" du kit : en-tête violet, 2 stud panels d'état,
	boîte d'info, gros CTA en ligne, rangée de petites actions).
		LANCER (vert, confirmer)   TERMINER (rouge, détruire)
		TOUS PRÊTS (bleu)  +1000 (vert argent)  MANCHE 60s (violet, bascule)  REVOIR TUTO (gris)
	Les commandes sont validées côté serveur (AdminService) ; la tuile n'apparaît que si Player.IsAdmin.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AdminPanel = {}
local RGB = Color3.fromRGB

function AdminPanel.Build(ctx)
	local UI, Icons, Motion, Config = ctx.UI, ctx.Icons, ctx.Motion, ctx.Config
	local Remotes = ReplicatedStorage:WaitForChild("Remotes")
	local gui = UI.ScreenGui("MenuAdmin", 11, { Parent = ctx.PlayerGui })
	Motion.CreateSounds(gui.Sons)
	local win = UI.Window(gui, { Size = Vector2.new(600, 452), Title = "Admin", Header = "purple",
		Icon = Icons.Get("Item/Hammer/Hammer 1st Outline") })
	local body = win.Corps
	UI.Pill(win.Fenetre, '<font color="#FFD23F">Panneau de contrôle</font>', { Width = 240, Position = UDim2.new(0.5, 0, 0, win.HeaderHeight), ZIndex = 20 })

	-- ------------------------------------------------------------ état
	local function statPanel(x, grad, title, icon)
		local p = UI.StudPanel(body, { Size = UDim2.fromOffset(270, 104), Position = UDim2.fromOffset(x, 22), Gradient = grad, ZIndex = 3 })
		UI.Text(p, title, { Name = "Titre", Size = UDim2.new(1, -90, 0, 26), Position = UDim2.new(0, 90, 0, 24), AnchorPoint = Vector2.new(0, 0.5),
			AlignX = Enum.TextXAlignment.Left, Max = 22, Thickness = 2.6, ZIndex = 7 })
		local v, vs = UI.ShadowText(p, "-", { Name = "Valeur", Size = UDim2.new(1, -96, 0, 50), Position = UDim2.new(0, 90, 0, 66), AnchorPoint = Vector2.new(0, 0.5),
			AlignX = Enum.TextXAlignment.Left, Max = 40, Thickness = 3.2, ZIndex = 7 })
		UI.Image(p, Icons.Get(icon), { Size = UDim2.fromOffset(84, 84), Position = UDim2.fromOffset(44, 50), Rotation = -10, ZIndex = 9 })
		return v, vs
	end
	local stateText, stateShadow = statPanel(16, "cyan", "ÉTAT", "Item/Clock/Golden Clock 1st Outline")
	local playersText, playersShadow = statPanel(309, "violet", "JOUEURS PRÊTS", "Player/4 Players/4 Players 1st Outline")

	local info = UI.InsetBox(body, { Name = "Info", Size = UDim2.fromOffset(563, 64), Position = UDim2.fromOffset(16, 140) })
	local infoText = UI.Text(info, "", { Size = UDim2.new(1, -24, 1, -10), Max = 18, Rich = true, Font = "Bold",
		Color = RGB(220, 235, 245), Thickness = 2.2, ZIndex = 6 })

	-- ------------------------------------------------------------ actions
	local actions = {}
	local function action(name, cmd, p)
		p.Name = name
		local b = UI.Button(body, p)
		actions[cmd] = b
		Motion.BindButton(b, 1.04, gui.Sons, function()
			local ok, res = pcall(Remotes.AdminCommand.InvokeServer, Remotes.AdminCommand, cmd)
			if ok and res and res.Ok then
				Motion.Play(gui.Sons, "Achat", 1.2)
				Motion.Float(b, res.Message, UI.Colors.FloatSuccess)
				if cmd == "Start" then task.delay(0.6, function() ctx.CloseAll() end) end
			else
				Motion.Play(gui.Sons, "Refus")
				Motion.Shake(b)
				Motion.Float(b, if ok and res then res.Message else "Erreur", UI.Colors.FloatError)
			end
			if ok and res and res.ShortRound ~= nil then
				ctx.AdminShortRound = res.ShortRound
			end
		end)
		return b
	end
	action("Lancer", "Start", { Theme = "green", Size = Vector2.new(270, 74), Position = UDim2.fromOffset(151, 254),
		Text = "LANCER", TextSize = 38, Icon = Icons.Get("Item/Rocket/Rocket 1st Outline") })
	action("Terminer", "End", { Theme = "red", Size = Vector2.new(270, 74), Position = UDim2.fromOffset(444, 254),
		Text = "TERMINER", TextSize = 34, Icon = Icons.Get("UI/Skip/Skip 1st Outline") })
	local small = {
		{ "TousPrets", "AllReady", "blue", "TOUS PRÊTS", "Player/Add Player/Add Player 1st Outline" },
		{ "Pieces", "Coins", "green", "+" .. Config.AdminCoinsGift, "Currency/Coin/Golden Coin 1st Outline" },
		{ "MancheCourte", "ShortRound", "purple", "MANCHE " .. Config.AdminShortRoundTime .. "s", "Item/Clock/Clock 1st Outline" },
		{ "RevoirTuto", "ResetTuto", "gray", "TUTO", "Item/Book/Yellow Book 1st Outline" },
	}
	for i, a in small do
		action(a[1], a[2], { Theme = a[3], Size = Vector2.new(134, 54), Position = UDim2.fromOffset(83 + (i - 1) * 144, 330),
			Text = a[4], TextSize = 19, Icon = Icons.Get(a[5]), IconSize = 0.8 })
	end

	local menu = Motion.Window(gui, win.Fenetre, { Keep = { Notifications = true, Recompenses = true } })
	local api = { Gui = gui, Menu = menu }

	local LABEL = { Lobby = "ATTENTE", Intermission = "INTERMISSION", Countdown = "DÉCOMPTE", Round = "MANCHE", Results = "RÉSULTATS" }
	function api.Update()
		if not menu.IsOpen then return end
		local st = ReplicatedStorage:GetAttribute("GameState") or "Lobby"
		local left = math.max(0, (ReplicatedStorage:GetAttribute("EndsAt") or 0) - workspace:GetServerTimeNow())
		local s = (LABEL[st] or st) .. (if st ~= "Lobby" then "  " .. Motion.Duration(math.ceil(left)) else "")
		stateText.Text, stateShadow.Text = s, s
		local ready = ReplicatedStorage:GetAttribute("ReadyCount") or 0
		local p = ("%d / %d"):format(ready, #game:GetService("Players"):GetPlayers())
		playersText.Text, playersShadow.Text = p, p
		local short = ctx.AdminShortRound == true
		infoText.Text = ('LANCER saute l\'intermission (seul : manche <font color="#FFD23F">sans chasseur</font> pour tester).\nDurée des manches : <font color="#FFD23F">%d s</font>   ·   Minimum normal : <font color="#FFD23F">%d joueurs</font>')
			:format(if short then Config.AdminShortRoundTime else Config.RoundTime, ReplicatedStorage:GetAttribute("MinPlayers") or Config.MinPlayers)
		local inRound = st == "Round" or st == "Countdown"
		UI.SetDisabled(actions.Start, inRound)
		UI.SetDisabled(actions.End, not inRound)
	end

	function api.Open() menu.Open(); api.Update() end
	function api.Close() menu.Close() end
	return api
end

return AdminPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">AssetGuard</string><ProtectedString name="Source"><![CDATA[--[[
	AssetGuard - vérifie que toutes les images de l'UI se chargent (ContentProvider:PreloadAsync).
	Une image qui échoue (asset retiré / hors vente / modéré) est remplacée par une icône de secours du même kit,
	et son ID est listé une seule fois dans l'Output : "[AssetGuard] image indisponible : rbxassetid://...".
	Les textures décoratives (studs, soleil) qui échouent sont simplement masquées.
]]

local ContentProvider = game:GetService("ContentProvider")

local AssetGuard = {}

local DECOR = { Studs = true, Soleil = true, Reflets = true }

function AssetGuard.Run(ctx, roots: { Instance })
	local Icons = ctx.Icons
	local fallbacks = {
		Icons.Get("Main/Star/Golden Star 1st Outline"),
		Icons.Get("Item/Gift/Red Gift 1st Outline"),
	}
	local byId: { [string]: { GuiObject } } = {}
	for _, root in roots do
		for _, d in root:GetDescendants() do
			if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" then
				byId[d.Image] = byId[d.Image] or {}
				table.insert(byId[d.Image], d)
			end
		end
	end
	local ids = {}
	for id in byId do table.insert(ids, id) end
	task.spawn(function()
		local failed = {}
		pcall(function()
			ContentProvider:PreloadAsync(ids, function(id, status)
				if status == Enum.AssetFetchStatus.Failure then table.insert(failed, id) end
			end)
		end)
		for _, id in failed do
			warn("[AssetGuard] image indisponible : " .. id)
			for _, img in byId[id] or {} do
				if DECOR[img.Name] then
					img.Visible = false
				else
					local fb = if id == fallbacks[1] then fallbacks[2] else fallbacks[1]
					img.Image = fb
				end
			end
		end
	end)
end

return AssetGuard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">Collection</string><ProtectedString name="Source"><![CDATA[--[[
	Collection - fenêtres Shop et Inventaire (archétype "grille de slots + colonne d'onglets", cf. exemple 05 du kit).
		Shop       : en-tête image rose + panier, tous les items, bouton Acheter (vert, prix) / Équiper (bleu) / Équipé (gris)
		Inventaire : en-tête bleu + sac, uniquement les items possédés, bouton Équiper / Équipé
	Onglets (à droite, hors fenêtre) : Queues / Traînées / Captures. Rareté = étiquette en dégradé + soleil teinté.
	L'item équipé a le liseré de sélection lime (pulsé).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Collection = {}
local RGB = Color3.fromRGB

function Collection.Build(ctx, mode: string)
	local UI, Icons, Motion, Cosmetics = ctx.UI, ctx.Icons, ctx.Motion, ctx.Cosmetics
	local Remotes = ReplicatedStorage:WaitForChild("Remotes")
	local isShop = mode == "Shop"
	local gui = UI.ScreenGui(if isShop then "MenuShop" else "MenuInventaire", 11, { Parent = ctx.PlayerGui })
	Motion.CreateSounds(gui.Sons)
	local win = UI.Window(gui, {
		Size = Vector2.new(640, 470), Position = UDim2.new(0.5, -80, 0.5, 0),
		Title = if isShop then "Shop" else "Inventaire",
		-- en-tête stud généré par le kit (l'ancienne texture "image" du shop n'est pas disponible hors du jeu de référence)
		Header = if isShop then "pink" else "blue",
		Icon = Icons.Get(if isShop then "Main/Shopping Bag/Red Shopping Bag 1st Outline" else "Item/Chest/Chest 1st Outline"),
	})
	local coinsPill = UI.Pill(win.Fenetre, "", { Width = 230, Position = UDim2.new(0.5, 0, 0, win.HeaderHeight), ZIndex = 20 })

	local grid = UI.ScrollList(win.Corps, { Size = UDim2.fromOffset(626, 382), Position = UDim2.fromOffset(4, 4),
		Grid = Vector2.new(140, 184), GridGap = 12, PadTop = 26, PadLeft = 12 })

	-- onglets
	local tabsFrame = UI.new("Frame", { Name = "Onglets", BackgroundTransparency = 1, Size = UDim2.fromOffset(162, 392),
		Position = UDim2.fromOffset(646, 78) }, win.Fenetre)
	local tabs, base = {}, {}
	for i, cat in Cosmetics.Categories do
		local b = UI.Button(tabsFrame, { Name = "Onglet_" .. cat.Id, Theme = cat.Theme, Size = Vector2.new(150, 58),
			Position = UDim2.fromOffset(83, 34 + (i - 1) * 68), Text = cat.Label, TextSize = 24, Icon = Icons.Get(cat.Icon) })
		b:SetAttribute("Categorie", cat.Id)
		table.insert(tabs, b)
		table.insert(base, b.Position)
	end

	local menu = Motion.Window(gui, win.Fenetre, { Keep = { Notifications = true, Recompenses = true } })
	local api = { Gui = gui, Menu = menu, Window = win }
	local currentCat = Cosmetics.Categories[1].Id
	local cells: { [string]: Frame } = {}
	local busy = false

	local function rarityColor(r: string): Color3
		local rr = UI.Rarities[r]
		return if rr then rr.tab.fond.Keypoints[1].Value else Color3.new(1, 1, 1)
	end

	-- --------------------------------------------------------- bouton d'action d'une cellule
	local function setAction(cell: Frame, item, profile)
		local old = cell:FindFirstChild("Action")
		if old then old:Destroy() end
		local owned = profile and profile.Owned[item.Id]
		local equipped = profile and profile.Equipped[item.Category] == item.Id
		local btn
		if equipped then
			btn = UI.Button(cell, { Name = "Action", Theme = "gray", Size = Vector2.new(140, 46), Position = UDim2.fromOffset(70, 160),
				Text = "ÉQUIPÉ", TextSize = 24, Icon = UI.Assets.Check })
			UI.SetDisabled(btn, true)
		elseif owned then
			btn = UI.Button(cell, { Name = "Action", Theme = "blue", Size = Vector2.new(140, 46), Position = UDim2.fromOffset(70, 160),
				Text = "ÉQUIPER", TextSize = 24 })
		else
			btn = UI.Button(cell, { Name = "Action", Style = "Glossy", Theme = "cash", Size = Vector2.new(140, 46), Position = UDim2.fromOffset(70, 160),
				Text = ctx.Abbreviate(item.Price), FixedTextSize = 26, Icon = Icons.Get("Currency/Coin/Golden Coin 1st Outline") })
		end
		Motion.BindButton(btn, 1.05, gui.Sons)
		btn.Activated:Connect(function()
			if equipped or busy then return end
			busy = true
			local remote = if owned then Remotes.ShopEquip else Remotes.ShopPurchase
			local ok, res = pcall(remote.InvokeServer, remote, item.Id)
			busy = false
			if ok and res and res.Ok then
				if not owned then
					Motion.Play(gui.Sons, "Achat", 1)
					ctx.Audio.Play("Purchase")
					Motion.Float(btn, "Acheté !", UI.Colors.FloatSuccess)
				else
					Motion.Float(btn, "Équipé !", UI.Colors.FloatSuccess)
				end
				if res.Profile then ctx.SetProfile(res.Profile) end
			else
				Motion.Play(gui.Sons, "Refus")
				Motion.Shake(btn)
				Motion.Float(btn, if ok and res then res.Message else "Erreur", UI.Colors.FloatError)
			end
		end)
	end

	-- --------------------------------------------------------- cellules
	for i, item in Cosmetics.Items do
		local cell = UI.new("Frame", { Name = "Cellule_" .. item.Id, BackgroundTransparency = 1, Size = UDim2.fromOffset(140, 184),
			LayoutOrder = i }, grid)
		cell:SetAttribute("Categorie", item.Category)
		local slot = UI.ItemSlot(cell, { Name = "Carte", Button = false, Size = Vector2.new(140, 130), Icon = Icons.Get(item.Icon),
			IconScale = 0.66, Title = item.Name, TitleMax = 20, Tag = string.upper(item.Rarity), TagColor = Color3.new(1, 1, 1) })
		local tag = slot:FindFirstChild("Etiquette")
		local rr = UI.Rarities[item.Rarity]
		if tag and rr then UI.Gradient(tag, rr.text, 90) end
		local sun = slot:FindFirstChild("Soleil", true)
		if sun then sun.ImageColor3 = rarityColor(item.Rarity) end
		slot.Icone.Rotation = -8
		cells[item.Id] = cell
	end
	Motion.SpinSunbursts(grid, 20)

	local function applyFilter(profile)
		for id, cell in cells do
			local item = Cosmetics.Get(id)
			local owned = profile and profile.Owned[id]
			cell.Visible = item ~= nil and item.Category == currentCat and (isShop or owned == true)
		end
	end

	function api.Refresh(profile)
		if not profile then return end
		coinsPill.Texte.Text = ('<font color="#FFD23F">%s</font> pièces'):format(ctx.Abbreviate(profile.Coins))
		for id, cell in cells do
			local item = Cosmetics.Get(id)
			if item then
				setAction(cell, item, profile)
				local sel = cell.Carte.Lisere:FindFirstChild("Selection")
				if sel then
					local on = profile.Equipped[item.Category] == id
					sel.Enabled = on
					if on then Motion.PulseStroke(sel) else Motion.StopIdle(sel) end
				end
			end
		end
		applyFilter(profile)
	end

	local function choose(tab)
		Motion.SelectTab(tabs, tab, 6, base)
		currentCat = tab:GetAttribute("Categorie")
		applyFilter(ctx.GetProfile())
	end
	for _, b in tabs do
		Motion.BindButton(b, 1.05, gui.Sons, function() choose(b) end)
	end
	choose(tabs[1])

	-- l'icône d'en-tête se balance (comme le panier de la référence)
	if win.Icone then Motion.Sway(win.Icone, 3, 1.6) end

	function api.Open() menu.Open() end
	function api.Close() menu.Close() end
	_ = RGB
	return api
end

return Collection
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud - HUD permanent construit avec le kit StudUI (offsets 1050x620 + une WindowScale par racine).
		Haut centre  : minuteur (InsetBox + Pill d'état) + sous-titre (départ des chasseurs / joueurs prêts)
		Haut gauche  : badge de rôle (bouton stud recoloré) + participants restants
		Bas gauche   : pièces (MoneyText + pièce dorée) + queues prises
		Bas centre   : barre de cooldown du dash + rappel des touches
		Bas droite   : boutons tactiles Dash / Slide (mobile uniquement)
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Hud = {}

local RGB = Color3.fromRGB

function Hud.Build(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local gui = UI.ScreenGui("HudTailChase", 4, { Parent = ctx.PlayerGui, Menu = false, IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets })
	local api = { Gui = gui }

	local function root(name, size, pos, anchor)
		local f = UI.new("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromOffset(size.X, size.Y),
			Position = pos, AnchorPoint = anchor }, gui)
		local sc = UI.new("UIScale", { Name = "WindowScale" }, f)
		Motion.BindResponsive(sc, 0.9)
		return f
	end

	-- ------------------------------------------------------------ minuteur
	local top = root("Minuteur", Vector2.new(300, 176), UDim2.new(0.5, 0, 0, 4), Vector2.new(0.5, 0))
	local box = UI.InsetBox(top, { Name = "Boite", Size = UDim2.fromOffset(210, 62), Position = UDim2.fromOffset(45, 22) })
	local timerText, timerShadow = UI.ShadowText(box, "--:--", { Font = "Gotham", Max = 44, Size = UDim2.new(1, -16, 1, -8),
		Stroke = RGB(8, 12, 14), Thickness = 3, ZIndex = 8 })
	local pill = UI.Pill(top, "LOBBY", { Width = 190, Position = UDim2.fromOffset(150, 22), TextSize = 18 })
	local subText = UI.Text(top, "", { Name = "Sous", Font = "Gotham", Size = UDim2.fromOffset(320, 26), Position = UDim2.fromOffset(150, 102),
		Max = 20, Rich = true, Stroke = RGB(10, 12, 16), Thickness = 2.6 })

	-- bouton VOTE (intermission) : rouvre la fenêtre de vote de map
	local voteBtn = UI.Button(top, { Name = "BoutonVote", Theme = "blue", Size = Vector2.new(150, 46), Position = UDim2.fromOffset(150, 144),
		Text = "VOTE", TextSize = 26, Icon = Icons.Get("Item/Location Pin/Location Pin 1st Outline") })
	voteBtn.Visible = false
	local voteBadge = UI.NotifBadge(voteBtn)
	Motion.PulseScale(voteBadge.Pulse)
	Motion.BindButton(voteBtn, 1.05, ctx.Sons, function() if ctx.OpenVote then ctx.OpenVote() end end)
	function api.SetVoteVisible(v: boolean)
		voteBtn.Visible = v
	end

	function api.SetTimer(text: string, urgent: boolean?)
		timerText.Text = text
		timerShadow.Text = text
		timerText.TextColor3 = if urgent then RGB(255, 110, 110) else Color3.new(1, 1, 1)
	end
	function api.SetState(text: string)
		pill.Texte.Text = text
	end
	function api.SetSub(text: string)
		subText.Text = text
	end

	-- ------------------------------------------------------------ rôle + restants
	local roleRoot = root("Role", Vector2.new(240, 120), UDim2.fromOffset(12, 8), Vector2.zero)
	local badge = UI.Button(roleRoot, { Name = "Badge", Theme = "gray", Size = Vector2.new(220, 64), Position = UDim2.fromOffset(110, 32),
		Text = "LOBBY", TextSize = 30, Icon = Icons.Get("Main/House/Blue House 1st Outline") })
	badge.Active = false
	badge.Selectable = false
	local restRow = UI.new("Frame", { Name = "Restants", BackgroundTransparency = 1, Size = UDim2.fromOffset(230, 40),
		Position = UDim2.fromOffset(0, 72) }, roleRoot)
	UI.Image(restRow, Icons.Get("Player/4 Players/4 Players 1st Outline"), { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(24, 20), Rotation = -8 })
	local restText, restShadow = UI.ShadowText(restRow, "", { Font = "Gotham", Max = 24, Size = UDim2.fromOffset(180, 30),
		Position = UDim2.fromOffset(48, 22), AnchorPoint = Vector2.new(0, 0.5), AlignX = Enum.TextXAlignment.Left,
		Stroke = RGB(10, 12, 16), Thickness = 3, ZIndex = 4 })

	local ROLE_LOOK = {
		Hunter = { "red", "CHASSEUR", "Player/Skull/Skull 1st Outline" },
		Runner = { "blue", "PARTICIPANT", "Item/Shoe/Blue Shoe 1st Outline" },
		Lobby = { "gray", "LOBBY", "Main/House/Blue House 1st Outline" },
	}
	function api.SetRole(role: string)
		local look = ROLE_LOOK[role] or ROLE_LOOK.Lobby
		UI.Recolor(badge, look[1])
		UI.SetButtonText(badge, look[2])
		badge.Icone.Image = Icons.Get(look[3])
		local sc = badge:FindFirstChild("ButtonScale")
		if sc then
			sc.Scale = 1.15
			TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	end
	function api.SetRemaining(text: string)
		restText.Text = text
		restShadow.Text = text
		restRow.Visible = text ~= ""
	end

	-- ------------------------------------------------------------ pièces + queues prises
	local stats = root("Stats", Vector2.new(320, 110), UDim2.new(0, 12, 1, -12), Vector2.new(0, 1))
	UI.Image(stats, Icons.Get("Currency/Coin/Golden Coin 1st Outline"), { Name = "Piece", Size = UDim2.fromOffset(46, 46),
		Position = UDim2.fromOffset(24, 28), Rotation = -10, ZIndex = 3 })
	-- ligne argent (comme la référence) : montant lime + bouton « + » glossy vert qui ouvre le shop
	local row = UI.new("Frame", { Name = "LigneArgent", BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40), Position = UDim2.fromOffset(52, 8) }, stats)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, row)
	local moneyHolder = UI.new("Frame", { Name = "Argent", BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40), LayoutOrder = 1 }, row)
	local moneyText, moneyShadow = UI.MoneyText(moneyHolder, "0")
	local plusSlot = UI.new("Frame", { Name = "EmplacementPlus", BackgroundTransparency = 1, Size = UDim2.fromOffset(39, 38), LayoutOrder = 2 }, row)
	local plus = UI.Button(plusSlot, { Name = "BoutonPlus", Style = "Glossy", Theme = "cash", Size = Vector2.new(39, 38), Studs = false })
	UI.OutlinedIcon(plus, UI.Assets.PlusBlack, UI.Assets.PlusWhite, { Size = UDim2.fromOffset(15, 15), Position = UDim2.fromOffset(19, 17), ZIndex = 4 })
	Motion.BindButton(plus, 1.06, ctx.Sons, function() if ctx.OpenShop then ctx.OpenShop() end end)
	api.PlusButton = plus
	UI.Image(stats, Icons.Get("Exclusive/Trail/Red Trail 1st Outline"), { Name = "QueueIcone", Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(24, 80), Rotation = -12, ZIndex = 3 })
	local tailsText, tailsShadow = UI.ShadowText(stats, "Queues prises : 0", { Font = "Gotham", Max = 24, Size = UDim2.fromOffset(260, 30),
		Position = UDim2.fromOffset(52, 82), AnchorPoint = Vector2.new(0, 0.5), AlignX = Enum.TextXAlignment.Left,
		Stroke = RGB(24, 25, 21), Thickness = 3, ZIndex = 2 })

	local shownCoins = 0
	function api.SetCoins(n: number)
		local from = shownCoins
		shownCoins = n
		local t0 = os.clock()
		task.spawn(function()
			while true do
				local a = math.clamp((os.clock() - t0) / 0.6, 0, 1)
				local v = math.floor(from + (n - from) * a)
				local s = tostring(v):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
				moneyText.Text = s
				moneyShadow.Text = s
				if a >= 1 then break end
				task.wait()
			end
		end)
	end
	function api.SetTails(n: number)
		local s = "Queues prises : " .. n
		tailsText.Text = s
		tailsShadow.Text = s
		if n > 0 then
			tailsText.TextColor3 = UI.Colors.FloatSuccess
			task.delay(0.6, function() tailsText.TextColor3 = Color3.new(1, 1, 1) end)
		end
	end

	-- ------------------------------------------------------------ dash
	local dashRoot = root("Dash", Vector2.new(300, 84), UDim2.new(0.5, 0, 1, -10), Vector2.new(0.5, 1))
	UI.Text(dashRoot, "[Q] DASH     [C] SLIDE", { Name = "Touches", Font = "Gotham", Size = UDim2.fromOffset(300, 22),
		Position = UDim2.fromOffset(150, 14), Max = 17, Stroke = RGB(10, 12, 16), Thickness = 2.4 })
	local bar = UI.ProgressBar(dashRoot, { Name = "BarreDash", Size = UDim2.fromOffset(250, 34), Position = UDim2.fromOffset(25, 36),
		Progress = 1, Text = "DASH PRÊT", Fill = UI.seq(RGB(143, 227, 252), RGB(31, 142, 245)) })
	local fill = bar:FindFirstChild("Remplissage") :: Frame
	local valueText = bar:FindFirstChild("Valeur") :: TextLabel
	UI.Image(dashRoot, Icons.Get("Main/Lighting/Blue Lighting 1st Outline"), { Name = "Eclair", Size = UDim2.fromOffset(46, 46),
		Position = UDim2.fromOffset(26, 52), Rotation = -12, ZIndex = 12 })
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		dashRoot.Touches.Visible = false
	end

	function api.UpdateDash(readyAt: number, cooldown: number)
		local left = readyAt - os.clock()
		if left <= 0 or cooldown <= 0 then
			fill.Size = UDim2.fromScale(1, 1)
			valueText.Text = "DASH PRÊT"
		else
			fill.Size = UDim2.fromScale(math.clamp(1 - left / cooldown, 0, 1), 1)
			valueText.Text = ("DASH %.1fs"):format(left)
		end
	end

	-- ------------------------------------------------------------ boutons tactiles
	if UserInputService.TouchEnabled then
		local mob = root("Mobile", Vector2.new(250, 130), UDim2.new(1, -12, 1, -150), Vector2.new(1, 1))
		local dashBtn = UI.Button(mob, { Name = "BoutonDash", Theme = "blue", Size = Vector2.new(106, 106), Position = UDim2.fromOffset(62, 65),
			IconLayout = "Big", Icon = Icons.Get("Main/Lighting/Lighting 1st Outline"), Text = "DASH", TextSize = 26 })
		local slideBtn = UI.Button(mob, { Name = "BoutonSlide", Theme = "green", Size = Vector2.new(106, 106), Position = UDim2.fromOffset(186, 65),
			IconLayout = "Big", Icon = Icons.Get("Item/Shoe/Red Shoe 1st Outline"), Text = "SLIDE", TextSize = 26 })
		Motion.BindButton(dashBtn, 1.04, ctx.Sons, function() ctx.Signals.Fire("MobileAction", "Dash") end)
		Motion.BindButton(slideBtn, 1.04, ctx.Sons, function() ctx.Signals.Fire("MobileAction", "Slide") end)
		api.Mobile = mob
	end

	function api.SetInRound(inRound: boolean)
		dashRoot.Visible = true
		roleRoot.Visible = true
		if api.Mobile then api.Mobile.Visible = true end
		_ = inRound
	end

	return api
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">LobbyMenu</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyMenu - menu gauche du lobby, géométrie exacte du "left menu" de référence (screenshot 01 / exemple 02) :
		Frame 220x292 @ (0,14,0.5,0) ; bouton large 220x64 en haut, puis grille 2x2 de tuiles 106x106
		(centres x 53/167, y 125/239), icône énorme qui déborde, gaps 8 px.
		JOUER (vert prairie = confirmer) -> "PRÊT !" (jaune) ; re-cliquer annule
		SHOP (rouge) · INVENTAIRE (bleu) · TUTO (jaune) · ADMIN (violet, seulement si Player.IsAdmin)
	Badges "!" pulsés : Shop quand un item est achetable, Tuto tant que le tutoriel n'est pas terminé.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LobbyMenu = {}

function LobbyMenu.Build(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local Remotes = ReplicatedStorage:WaitForChild("Remotes")
	local player = Players.LocalPlayer
	local gui = UI.ScreenGui("MenuGauche", 4, { Parent = ctx.PlayerGui, Menu = false })
	local panel = UI.new("Frame", { Name = "Panneau", BackgroundTransparency = 1, Size = UDim2.fromOffset(220, 292),
		Position = UDim2.new(0, 14, 0.5, 10), AnchorPoint = Vector2.new(0, 0.5) }, gui)
	Motion.BindResponsive(UI.new("UIScale", { Name = "WindowScale" }, panel))

	local play = UI.Button(panel, { Name = "Jouer", Theme = "meadow", Size = Vector2.new(220, 64), Position = UDim2.fromOffset(110, 32),
		Text = "JOUER", TextSize = 32, TextThickness = 3.2, Icon = Icons.Get("Item/Target/Target 1st Outline") })
	local function tile(name, theme, text, icon, x, y, size)
		return UI.Button(panel, { Name = name, Theme = theme, Size = Vector2.new(106, 106), Position = UDim2.fromOffset(x, y),
			Text = text, IconLayout = "Big", Icon = Icons.Get(icon), TextSize = size or 28 })
	end
	local shop = tile("Shop", "red", "Shop", "Main/Shopping Bag/Red Shopping Bag 1st Outline", 53, 125)
	local inv = tile("Inventaire", "blue", "Objets", "Item/Chest/Chest 1st Outline", 167, 125, 26)
	local tuto = tile("Tuto", "yellow", "Tuto", "Item/Book/Yellow Book 1st Outline", 53, 239)
	local admin = tile("Admin", "purple", "Admin", "Item/Hammer/Hammer 1st Outline", 167, 239)

	local shopBadge = UI.NotifBadge(shop)
	local tutoBadge = UI.NotifBadge(tuto)
	Motion.PulseScale(shopBadge.Pulse)
	Motion.PulseScale(tutoBadge.Pulse)
	shopBadge.Visible = false
	tutoBadge.Visible = false

	local api = { Gui = gui }

	local function refreshPlay()
		local ready = player:GetAttribute("Ready") == true
		UI.Recolor(play, if ready then "yellow" else "meadow")
		UI.SetButtonText(play, if ready then "PRÊT !" else "JOUER")
	end
	player:GetAttributeChangedSignal("Ready"):Connect(refreshPlay)
	refreshPlay()

	local function refreshAdmin()
		admin.Visible = player:GetAttribute("IsAdmin") == true
	end
	player:GetAttributeChangedSignal("IsAdmin"):Connect(refreshAdmin)
	refreshAdmin()

	Motion.BindButton(play, 1.04, ctx.Sons, function()
		local ready = not (player:GetAttribute("Ready") == true)
		Remotes.SetReady:FireServer(ready)
		Motion.Float(play, if ready then "En attente des autres joueurs..." else "Annulé", if ready then UI.Colors.FloatSuccess else UI.Colors.FloatWarn)
	end)
	Motion.BindButton(shop, 1.04, ctx.Sons, function() ctx.OpenShop() end)
	Motion.BindButton(inv, 1.04, ctx.Sons, function() ctx.OpenInventory() end)
	Motion.BindButton(tuto, 1.04, ctx.Sons, function() ctx.OpenTutorial() end)
	Motion.BindButton(admin, 1.04, ctx.Sons, function() ctx.OpenAdmin() end)

	--- Badges selon le profil : un item non possédé abordable / tutoriel pas fini.
	function api.SetProfile(profile)
		local affordable = false
		for _, item in ctx.Cosmetics.Items do
			if not profile.Owned[item.Id] and item.Price <= profile.Coins then affordable = true break end
		end
		shopBadge.Visible = affordable
		tutoBadge.Visible = profile.TutorialDone ~= true
	end

	function api.SetVisible(v: boolean)
		panel.Visible = v -- (pas gui.Enabled : StudMotion.Window restaure Enabled à la fermeture d'un menu)
	end
	return api
end

return LobbyMenu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">MapVote</string><ProtectedString name="Source"><![CDATA[--[[
	MapVote - fenêtre de vote de map pendant l'intermission (archétype C "calendrier de récompenses" du kit :
	grandes tuiles stud panel colorées, soleil qui tourne derrière l'icône, nom en MAJUSCULES, bouton d'état).
		VOTER (vert)  ->  VOTÉ ! (gris) sur la tuile choisie ; on peut changer d'avis.
		Compteur de votes par tuile, couronne qui se balance sur la map en tête, Pill "Fin du vote dans 12 s".
	S'ouvre seule au début de l'intermission, se ferme seule à la fin ; bouton VOTE du HUD pour la rouvrir.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local MapVote = {}
local RGB = Color3.fromRGB

function MapVote.Build(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local Remotes = ReplicatedStorage:WaitForChild("Remotes")
	local gui = UI.ScreenGui("MenuVote", 11, { Parent = ctx.PlayerGui })
	Motion.CreateSounds(gui.Sons)
	local win = UI.Window(gui, { Size = Vector2.new(640, 440), Title = "Vote de map", Header = "blue", TitleWidth = 400,
		Icon = Icons.Get("Item/Location Pin/Location Pin 1st Outline") })
	local pill = UI.Pill(win.Fenetre, "", { Width = 260, Position = UDim2.new(0.5, 0, 0, win.HeaderHeight), ZIndex = 20 })
	local menu = Motion.Window(gui, win.Fenetre, { Keep = { Notifications = true, Recompenses = true } })

	local api = { Gui = gui, Menu = menu }
	local tiles = {}
	local myVote: string? = nil
	local catalog = {}

	local function loadCatalog()
		local raw = ReplicatedStorage:GetAttribute("MapCatalog")
		if typeof(raw) == "string" then
			local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
			if ok then for _, m in list do catalog[m.Id] = m end end
		end
	end

	local function clear()
		for _, t in tiles do t.Frame:Destroy() end
		table.clear(tiles)
	end

	local function refresh()
		local best, bestN = nil, 0
		for _, t in tiles do
			local n = ReplicatedStorage:GetAttribute("Votes_" .. t.Id) or 0
			t.Count.Text = ('<font color="#FFD23F">%d</font> vote%s'):format(n, if n > 1 then "s" else "")
			if n > bestN then best, bestN = t, n elseif n == bestN then best = nil end
			local mine = myVote == t.Id
			UI.Recolor(t.Button, if mine then "gray" else "green")
			UI.SetButtonText(t.Button, if mine then "VOTÉ !" else "VOTER")
			t.Selection.Enabled = mine
		end
		for _, t in tiles do t.Crown.Visible = t == best end
	end

	--- (Re)construit les tuiles à partir de VoteOptions.
	local function build()
		clear()
		myVote = nil
		local raw = ReplicatedStorage:GetAttribute("VoteOptions")
		if typeof(raw) ~= "string" then return false end
		local ok, ids = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok or #ids == 0 then return false end
		if next(catalog) == nil then loadCatalog() end
		local n = #ids
		local w, gap = 192, 14
		local x0 = (635 - (n * w + (n - 1) * gap)) / 2
		for i, id in ids do
			local m = catalog[id] or { Name = id, Description = "", Icon = "Main/Star/Golden Star 1st Outline", Gradient = "cyan" }
			local x = x0 + (i - 1) * (w + gap)
			local tile = UI.StudPanel(win.Corps, { Name = "Map_" .. id, Size = UDim2.fromOffset(w, 290), Position = UDim2.fromOffset(x, 30),
				Gradient = m.Gradient or "cyan", ZIndex = 3 })
			local sel = UI.Stroke(tile, UI.Colors.Selection, 4, 0, nil, "Selection")
			sel.Enabled = false
			UI.ShadowText(tile, string.upper(m.Name), { Size = UDim2.new(1, -14, 0, 36), Position = UDim2.new(0.5, 0, 0, 28), Max = 28,
				Thickness = 3.2, Stroke = RGB(10, 22, 40), ZIndex = 9 })
			UI.Sunburst(tile, 190, { Position = UDim2.fromScale(0.5, 0.4), ZIndex = 4 })
			UI.Image(tile, Icons.Get(m.Icon or "Main/Star/Golden Star 1st Outline"), { Name = "Icone", Size = UDim2.fromOffset(104, 104),
				Position = UDim2.fromScale(0.5, 0.4), Rotation = -8, ZIndex = 6 })
			UI.Text(tile, m.Description or "", { Font = "Bold", Size = UDim2.new(1, -18, 0, 36), Position = UDim2.new(0.5, 0, 1, -98), Max = 16,
				Thickness = 2.2, Stroke = RGB(10, 22, 40), ZIndex = 8 })
			local count = UI.Text(tile, "", { Name = "Votes", Size = UDim2.new(1, -18, 0, 24), Position = UDim2.new(0.5, 0, 1, -66), Max = 20,
				Rich = true, Thickness = 2.6, Stroke = RGB(10, 22, 40), ZIndex = 8 })
			local btn = UI.Button(tile, { Name = "Bouton", Theme = "green", Size = Vector2.new(166, 46), Position = UDim2.new(0.5, 0, 1, -28),
				Text = "VOTER", TextSize = 24, ZIndex = 8 })
			local crown = UI.Image(tile, Icons.Get("Item/Crown/Crown 1st Outline"), { Name = "Couronne", Size = UDim2.fromOffset(58, 58),
				Position = UDim2.new(1, -6, 0, 2), Rotation = 14, ZIndex = 14 })
			crown.Visible = false
			Motion.Sway(crown, 6, 2.4)
			Motion.BindButton(btn, 1.05, gui.Sons, function()
				if myVote == id then return end
				myVote = id
				Remotes.MapVote:FireServer(id)
				Motion.Play(gui.Sons, "Achat", 1.3)
				Motion.Float(btn, "+1 vote !", UI.Colors.FloatSuccess)
				local sc = tile:FindFirstChildOfClass("UIScale") or UI.new("UIScale", {}, tile)
				sc.Scale = 1.06
				TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				refresh()
			end)
			table.insert(tiles, { Id = id, Frame = tile, Count = count, Button = btn, Selection = sel, Crown = crown })
			ReplicatedStorage:GetAttributeChangedSignal("Votes_" .. id):Connect(function()
				if tiles[i] and tiles[i].Id == id then refresh() end
			end)
		end
		Motion.SpinSunbursts(win.Corps, 20)
		refresh()
		return true
	end

	function api.Update()
		if not menu.IsOpen then return end
		local left = math.max(0, (ReplicatedStorage:GetAttribute("EndsAt") or 0) - workspace:GetServerTimeNow())
		pill.Texte.Text = ('Fin du vote dans <font color="#FFD23F">%d s</font>'):format(math.ceil(left))
	end
	function api.HasVote(): boolean
		return #tiles > 0
	end
	function api.Open()
		if #tiles == 0 and not build() then return end
		menu.Open()
		api.Update()
	end
	function api.Close() menu.Close() end

	ReplicatedStorage:GetAttributeChangedSignal("VoteOptions"):Connect(function()
		if ReplicatedStorage:GetAttribute("VoteOptions") then
			if build() and not ctx.InRound() and ctx.Player:GetAttribute("Ready") == true then menu.Open() end
		else
			clear()
			menu.Close()
		end
	end)
	return api
end

return MapVote
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">Results</string><ProtectedString name="Source"><![CDATA[--[[
	Results - écran de résultats animé (fenêtre en-tête doré + trophée).
		3 grandes cartes (slots à soleil) : SURVIE / QUEUES / PIÈCES (les pièces défilent avec un tic sonore)
		détail des gains (InsetBox, valeurs surlignées #FFD23F)
		classement de la manche (liste d'InsetBox)
	S'ouvre via StudMotion.Window (rebond, flou 18, FOV +8), se ferme seul après Config.ResultsTime.
]]

local TweenService = game:GetService("TweenService")

local Results = {}
local RGB = Color3.fromRGB

function Results.Build(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local gui = UI.ScreenGui("MenuResultats", 12, { Parent = ctx.PlayerGui })
	Motion.CreateSounds(gui.Sons)
	local win = UI.Window(gui, { Size = Vector2.new(640, 470), Title = "Résultats", Header = "gold",
		Icon = Icons.Get("Item/Trophy/Golden Trophy 1st Outline") })
	local headline = UI.Pill(win.Fenetre, "", { Width = 360, Position = UDim2.new(0.5, 0, 0, win.HeaderHeight), ZIndex = 20 })

	local function card(x: number, top: string, icon: string)
		local s = UI.ItemSlot(win.Corps, { Name = "Carte" .. top, Button = false, Size = Vector2.new(170, 130), Position = UDim2.fromOffset(x, 36),
			Icon = Icons.Get(icon), IconScale = 0.6, Title = "-", TitleMax = 30, Top = top, ZIndex = 3 })
		s.Icone.Rotation = -10
		return s
	end
	local cSurv = card(37, "SURVIE", "Item/Clock/Clock 1st Outline")
	local cTails = card(232, "QUEUES", "Exclusive/Trail/Red Trail 1st Outline")
	local cCoins = card(427, "PIÈCES", "Currency/Coin/Golden Coin 1st Outline")
	cCoins.Rayons.Soleil.ImageColor3 = RGB(255, 210, 60)
	Motion.SpinSunbursts(win.Corps, 20)

	local detail = UI.InsetBox(win.Corps, { Name = "Detail", Size = UDim2.fromOffset(560, 40), Position = UDim2.fromOffset(37, 182) })
	local detailText = UI.Text(detail, "", { Size = UDim2.new(1, -16, 1, -6), Max = 19, Rich = true, Thickness = 2.4, ZIndex = 6 })

	local list = UI.ScrollList(win.Corps, { Name = "Classement", Size = UDim2.fromOffset(572, 150), Position = UDim2.fromOffset(31, 232),
		Padding = 6, PadTop = 4, PadLeft = 6 })

	local menu = Motion.Window(gui, win.Fenetre, { Keep = { Notifications = true, Recompenses = true } })
	local api = { Gui = gui, Menu = menu }
	local token = 0

	local function setTitle(slot, text: string)
		slot.Nom.Text = text
	end

	function api.Show(data)
		token += 1
		local my = token
		local m = data.Mine
		headline.Texte.Text = ('<font color="#FFD23F">%s</font>'):format(data.Headline or "Fin de la manche !")
		setTitle(cSurv, ctx.Duration(m.Survival))
		setTitle(cTails, "x" .. tostring(m.Tails))
		setTitle(cCoins, "+0")
		local b = m.Coins
		detailText.Text = ('Survie <font color="#FFD23F">+%d</font>   Queues <font color="#FFD23F">+%d</font>   Participation <font color="#FFD23F">+%d</font>%s')
			:format(b.Survival, b.Tails, b.Participation, if b.Bonus > 0 then ('   Survivant <font color="#60E87A">+%d</font>'):format(b.Bonus) else "")

		for _, c in list:GetChildren() do if c:IsA("GuiObject") then c:Destroy() end end
		for i, row in data.Rows do
			local box = UI.InsetBox(list, { Name = "Ligne" .. i, Size = UDim2.fromOffset(554, 36), LayoutOrder = i,
				Transparency = if row.Name == ctx.Player.DisplayName then 0 else 0.25,
				Color = if row.Name == ctx.Player.DisplayName then RGB(30, 60, 30) else nil })
			local medal = if i == 1 then "#FFD23F" elseif i == 2 then "#E2E6EC" elseif i == 3 then "#FF9A4A" else "#FFFFFF"
			UI.Text(box, ('<font color="%s">#%d</font>  %s%s'):format(medal, i, row.Name, if row.Survived then '  <font color="#60E87A">SURVIVANT</font>' else ""),
				{ Size = UDim2.new(0.6, -10, 1, 0), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
					AlignX = Enum.TextXAlignment.Left, Max = 18, Rich = true, Thickness = 2.2, ZIndex = 6 })
			UI.Text(box, ('%s   x%d   <font color="#FFD23F">+%d</font>'):format(ctx.Duration(row.Survival), row.Tails, row.Coins),
				{ Size = UDim2.new(0.4, -10, 1, 0), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
					AlignX = Enum.TextXAlignment.Right, Max = 18, Rich = true, Thickness = 2.2, ZIndex = 6 })
		end

		menu.Open()
		if m.Survived or m.LastSurvivor then ctx.Audio.Play("Victory") end
		-- cartes qui "pop" une par une, puis pièces qui défilent
		for i, c in { cSurv, cTails, cCoins } do
			local sc = c:FindFirstChild("ButtonScale") :: UIScale
			sc.Scale = 0.3
			task.delay(0.15 + i * 0.15, function()
				if token ~= my then return end
				TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				Motion.Play(gui.Sons, "Carte")
			end)
		end
		task.delay(0.8, function()
			local total = b.Total
			local t0 = os.clock()
			local last = -1
			while token == my do
				local a = math.clamp((os.clock() - t0) / 1.4, 0, 1)
				local v = math.floor(total * (1 - (1 - a) ^ 2))
				if v ~= last then
					setTitle(cCoins, "+" .. v)
					if v % 3 == 0 then ctx.Audio.Play("CoinTick", nil, 0.05) end
					last = v
				end
				if a >= 1 then break end
				task.wait()
			end
			if token == my then
				Motion.Float(cCoins, "+" .. total .. " pièces !", UI.Colors.FloatSuccess)
			end
		end)
		task.delay(ctx.Config.ResultsTime - 0.3, function()
			if token == my then menu.Close() end
		end)
	end
	return api
end

return Results
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">Screens</string><ProtectedString name="Source"><![CDATA[--[[
	Screens - notifications animées + écran de rôle / décompte de début de manche.
	Notifications : Pills StudUI empilées en haut (pop Back-Out, 3 s, fondu), couleur selon le type.
	Écran de rôle : StudPanel rouge (chasseur) ou bleu (participant), icône sticker inclinée qui déborde,
	titre extrudé, consigne, puis décompte 5..1 et "GO !" qui "pop".
]]

local TweenService = game:GetService("TweenService")

local Screens = {}
local RGB = Color3.fromRGB

local KIND_COLOR = {
	hunter = "#FF5A6A",
	success = "#B4FF3C",
	danger = "#FF7A7A",
	go = "#FFD23F",
	info = "#FFFFFF",
}

function Screens.BuildNotifications(ctx)
	local UI, Motion = ctx.UI, ctx.Motion
	local gui = UI.ScreenGui("Notifications", 30, { Parent = ctx.PlayerGui, Menu = false, IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets })
	local holder = UI.new("Frame", { Name = "Pile", BackgroundTransparency = 1, Size = UDim2.fromOffset(640, 260),
		Position = UDim2.new(0.5, 0, 0, 132), AnchorPoint = Vector2.new(0.5, 0) }, gui)
	Motion.BindResponsive(UI.new("UIScale", { Name = "WindowScale" }, holder), 0.9)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder }, holder)

	local api = { Gui = gui }
	local order = 0
	function api.Push(text: string, kind: string?)
		order += 1
		local items = {}
		for _, c in holder:GetChildren() do if c:IsA("Frame") then table.insert(items, c) end end
		if #items >= 4 then
			table.sort(items, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
			items[1]:Destroy()
		end
		local row = UI.new("Frame", { Name = "Notif", BackgroundTransparency = 1, Size = UDim2.fromOffset(640, 40), LayoutOrder = order }, holder)
		local sc = UI.new("UIScale", { Scale = 0.5 }, row)
		local col = KIND_COLOR[kind or "info"] or "#FFFFFF"
		local pill = UI.Pill(row, ('<font color="%s">%s</font>'):format(col, text), { Height = 36, TextSize = 22,
			Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5) })
		ctx.Audio.Play("Notify")
		TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		task.delay(3, function()
			if not row.Parent then return end
			local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			TweenService:Create(sc, info, { Scale = 0.6 }):Play()
			for _, d in pill:GetDescendants() do
				if d:IsA("TextLabel") then TweenService:Create(d, info, { TextTransparency = 1 }):Play() end
				if d:IsA("UIStroke") then TweenService:Create(d, info, { Transparency = 1 }):Play() end
			end
			TweenService:Create(pill, info, { BackgroundTransparency = 1 }):Play()
			task.wait(0.32)
			row:Destroy()
		end)
	end
	return api
end

function Screens.BuildRoleScreen(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local gui = UI.ScreenGui("EcranRole", 20, { Parent = ctx.PlayerGui, Menu = false })
	local root = UI.new("Frame", { Name = "Ecran", BackgroundTransparency = 1, Size = UDim2.fromOffset(600, 330),
		Position = UDim2.new(0.5, 0, 0.5, -40), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false }, gui)
	local scale = UI.new("UIScale", { Name = "WindowScale" }, root)
	local anim = Instance.new("NumberValue")
	anim.Value = 1
	Motion.BindResponsive(scale, 1, anim)

	local HUNTER = UI.seq(RGB(255, 110, 110), RGB(240, 30, 60), RGB(170, 0, 30))
	local RUNNER = UI.seq(RGB(124, 214, 255), RGB(58, 166, 255), RGB(26, 112, 238))
	local panel = UI.StudPanel(root, { Name = "Panneau", Size = UDim2.fromOffset(540, 160), Position = UDim2.fromOffset(40, 30), Gradient = RUNNER })
	local icon = UI.Image(root, "", { Name = "Icone", Size = UDim2.fromOffset(150, 150), Position = UDim2.fromOffset(70, 40), Rotation = -12, ZIndex = 14 })
	local title, titleShadow = UI.ShadowText(panel, "TU ES PARTICIPANT !", { Font = "Gotham", Max = 50, Size = UDim2.fromOffset(400, 64),
		Position = UDim2.fromOffset(320, 58), Stroke = RGB(2, 30, 60), Thickness = 4, ZIndex = 12 })
	local sub = UI.Text(panel, "", { Font = "Bold", Max = 22, Size = UDim2.fromOffset(400, 50), Position = UDim2.fromOffset(320, 118),
		Stroke = RGB(2, 30, 60), Thickness = 2.4, ZIndex = 12 })
	local countHolder = UI.new("Frame", { Name = "Decompte", BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 120),
		Position = UDim2.fromOffset(310, 262), AnchorPoint = Vector2.new(0.5, 0.5) }, root)
	local countScale = UI.new("UIScale", {}, countHolder)
	local count, countShadow = UI.ShadowText(countHolder, "5", { Font = "Gotham", Max = 110, Size = UDim2.fromScale(1, 1),
		Stroke = RGB(60, 30, 0), Thickness = 6, Offset = 5, Gradient = UI.seq(RGB(255, 240, 130), RGB(255, 160, 0)), ZIndex = 12 })

	local api = { Gui = gui }
	local token = 0

	local function pop(s: UIScale, from: number)
		s.Scale = from
		TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end

	function api.Show(role: string, countdown: number)
		token += 1
		local my = token
		local hunter = role == "Hunter"
		panel.Degrade.Color = if hunter then HUNTER else RUNNER
		local txt = if hunter then "TU ES CHASSEUR !" else "TU ES PARTICIPANT !"
		title.Text, titleShadow.Text = txt, txt
		local strokeCol = if hunter then RGB(60, 0, 10) else RGB(2, 30, 60)
		title.UIStroke.Color = strokeCol
		titleShadow.UIStroke.Color = strokeCol
		titleShadow.TextColor3 = strokeCol
		sub.UIStroke.Color = strokeCol
		sub.Text = if hunter then "Touche les participants pour leur arracher la queue !" else "Garde ta queue le plus longtemps possible ! Dash et slide pour t'échapper."
		icon.Image = Icons.Get(if hunter then "Player/Skull/Skull 1st Outline" else "Exclusive/Trail/Red Trail 1st Outline")
		Motion.Sway(icon, 4, 2.2)
		root.Visible = true
		anim.Value = 0.6
		TweenService:Create(anim, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 }):Play()
		ctx.Audio.Play("RoundStart")
		task.spawn(function()
			for n = countdown, 1, -1 do
				if token ~= my then return end
				count.Text, countShadow.Text = tostring(n), tostring(n)
				pop(countScale, 1.6)
				ctx.Audio.Play("Countdown")
				task.wait(1)
			end
			if token ~= my then return end
			local go = if hunter then "ATTENDS..." else "GO !"
			count.Text, countShadow.Text = go, go
			pop(countScale, 1.8)
			ctx.Audio.Play("Go")
			ctx.Signals.Fire("Shake", 0.4, 0.2)
			task.wait(0.9)
			if token ~= my then return end
			TweenService:Create(anim, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = 0.7 }):Play()
			task.wait(0.18)
			if token == my then root.Visible = false end
		end)
	end
	function api.Hide()
		token += 1
		root.Visible = false
	end
	return api
end

--[[ Bannière de récompense (archétype G du kit) : panneau stud doré + soleil qui tourne, titre extrudé,
	carte de récompense (queue arrachée, "+10" pièces). DisplayOrder 40, jamais masquée par les menus. ]]
function Screens.BuildBanner(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local gui = UI.ScreenGui("Recompenses", 40, { Parent = ctx.PlayerGui, Menu = false })
	local banner = UI.StudPanel(gui, { Name = "Banniere", Size = UDim2.fromOffset(420, 210), Position = UDim2.new(0.5, 0, 0, 96),
		AnchorPoint = Vector2.new(0.5, 0), Gradient = "gold", ZIndex = 2 })
	banner.Visible = false
	banner.ClipsDescendants = true
	UI.new("UIScale", { Name = "WindowScale" }, banner)
	local sun = UI.Sunburst(banner, 420, { Position = UDim2.fromScale(0.5, 0.62), Transparency = 0.55, ZIndex = 3 })
	sun.Name = "Soleil"
	local title, titleShadow = UI.ShadowText(banner, "Queue prise !", { Max = 40, Size = UDim2.new(1, -20, 0, 50),
		Position = UDim2.new(0.5, 0, 0, 38), Stroke = RGB(70, 34, 0), Thickness = 3.5, ZIndex = 10 })
	local slot = UI.ItemSlot(banner, { Name = "Carte", Button = false, Size = Vector2.new(112, 120), Position = UDim2.new(0.5, 0, 0, 74),
		AnchorPoint = Vector2.new(0.5, 0), Title = "Classique", Tag = "+10", TagColor = UI.Colors.TagGold, ZIndex = 5 })
	local api = { Gui = gui }
	function api.Show(text: string, iconPath: string, name: string, tag: string)
		title.Text, titleShadow.Text = text, text
		slot.Icone.Image = Icons.Get(iconPath)
		slot.Icone.Rotation = -10
		slot.Nom.Text = name
		slot.Etiquette.Text = tag
		slot.Etiquette.Visible = true
		task.spawn(Motion.ShowBanner, banner, 2.2, ctx.Sons)
	end
	return api
end

return Screens
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--[[
	Tutorial - tutoriel en 4 pages (fenêtre en-tête vert + livre).
	Chaque page : grand stud panel coloré (soleil qui tourne + icône sticker inclinée qui déborde, titre extrudé,
	description Montserrat Bold), une rangée "extra" (touches, gains...), points de pagination, RETOUR (gris) / SUIVANT (bleu)
	puis C'EST PARTI ! (vert) à la dernière page. Pill "1 / 4" sur la jointure de l'en-tête.
	S'ouvre automatiquement au premier passage (profil.TutorialDone == false) et via la tuile "Tuto" du lobby.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Tutorial = {}
local RGB = Color3.fromRGB

function Tutorial.Build(ctx)
	local UI, Icons, Motion = ctx.UI, ctx.Icons, ctx.Motion
	local Remotes = ReplicatedStorage:WaitForChild("Remotes")
	local C = ctx.Config.Coins
	local gui = UI.ScreenGui("MenuTuto", 11, { Parent = ctx.PlayerGui })
	Motion.CreateSounds(gui.Sons)
	local win = UI.Window(gui, { Size = Vector2.new(640, 470), Title = "Comment jouer", Header = "green", TitleWidth = 420,
		Icon = Icons.Get("Item/Book/Yellow Book 1st Outline") })
	local body = win.Corps
	local pill = UI.Pill(win.Fenetre, "1 / 4", { Width = 120, Position = UDim2.new(0.5, 0, 0, win.HeaderHeight), ZIndex = 20 })

	local HUNTER = UI.seq(RGB(255, 110, 110), RGB(240, 30, 60), RGB(170, 0, 30))
	local PAGES = {
		{ Title = "GARDE TA QUEUE !", Gradient = "cyan", Icon = "Exclusive/Trail/Red Trail 1st Outline", Stroke = RGB(2, 30, 60),
			Text = "Chaque participant porte une queue dans le dos. Survis le plus longtemps possible sans te la faire arracher !",
			Extra = { { "3:00", "par manche" }, { "2+", "joueurs" }, { "1-2", "chasseurs" } } },
		{ Title = "LES CHASSEURS", Gradient = HUNTER, Icon = "Player/Skull/Skull 1st Outline", Stroke = RGB(60, 0, 12),
			Text = "Ils brillent en ROUGE à travers les murs. S'ils te touchent, ta queue est arrachée... et tu deviens chasseur à ton tour !",
			Extra = { { "ROUGE", "= danger" }, { "2 s", "d'immunité" }, { "+1", "queue prise" } } },
		{ Title = "BOUGE COMME UN PRO", Gradient = "violet", Icon = "Main/Lighting/Lighting 1st Outline", Stroke = RGB(34, 4, 70),
			Text = "Dash pour t'échapper, slide pour passer dans les mini-tunnels (néon cyan), jump pads verts pour monter sur les toits.",
			Extra = { { "Q / Shift", "DASH" }, { "C / Ctrl", "SLIDE" }, { "Pad vert", "SAUT" } } },
		{ Title = "GAGNE DES PIÈCES", Gradient = "gold", Icon = "Currency/Coin/Golden Coin 1st Outline", Stroke = RGB(70, 34, 0),
			Text = "Dépense-les au Shop du lobby : skins de queue, traînées de dash et effets de capture. Que du style, aucun avantage !",
			Extra = { { "+1", ("/ %d s survie"):format(C.SurvivalSecondsPerCoin) }, { "+" .. C.PerTail, "par queue" }, { "+" .. C.LastSurvivor, "survivant" } } },
	}

	-- ------------------------------------------------------------ éléments réutilisés d'une page à l'autre
	local holder = UI.new("Frame", { Name = "Page", BackgroundTransparency = 1, Size = UDim2.fromOffset(603, 232),
		Position = UDim2.fromOffset(317, 136), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 }, body)
	local pageScale = UI.new("UIScale", {}, holder)
	local panel = UI.StudPanel(holder, { Name = "Panneau", Size = UDim2.fromOffset(603, 232), Gradient = "cyan", ZIndex = 3 })
	panel.ClipsDescendants = false
	local sun = UI.Sunburst(panel, 300, { Position = UDim2.fromOffset(130, 116), Transparency = 0.5, ZIndex = 4 })
	local icon = UI.Image(panel, "", { Name = "Icone", Size = UDim2.fromOffset(176, 176), Position = UDim2.fromOffset(128, 108), Rotation = -10, ZIndex = 9 })
	local title, titleShadow = UI.ShadowText(panel, "", { Font = "Gotham", Max = 36, Size = UDim2.fromOffset(360, 50),
		Position = UDim2.fromOffset(418, 52), Thickness = 3.6, ZIndex = 10 })
	local desc = UI.Text(panel, "", { Font = "Bold", Max = 21, Size = UDim2.fromOffset(350, 110), Position = UDim2.fromOffset(418, 148),
		Thickness = 2.4, ZIndex = 10 })

	local extras = {}
	for i = 1, 3 do
		local box = UI.InsetBox(body, { Name = "Extra" .. i, Size = UDim2.fromOffset(190, 54), Position = UDim2.fromOffset(16 + (i - 1) * 206, 262) })
		local big = UI.Text(box, "", { Font = "Gotham", Size = UDim2.new(0.5, -6, 1, -6), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
			AlignX = Enum.TextXAlignment.Left, Max = 24, Gradient = UI.TextGradients.Stock, Stroke = RGB(33, 7, 0), Thickness = 2.6, ZIndex = 6 })
		local small = UI.Text(box, "", { Size = UDim2.new(0.5, -8, 1, -6), Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
			AlignX = Enum.TextXAlignment.Right, Max = 17, Thickness = 2.2, ZIndex = 6 })
		extras[i] = { Big = big, Small = small }
	end

	local dots = {}
	for i = 1, #PAGES do
		local d = UI.new("Frame", { Name = "Point" .. i, BackgroundColor3 = RGB(60, 70, 80), BorderSizePixel = 0, Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(317 + (i - (#PAGES + 1) / 2) * 24, 336), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4 }, body)
		UI.new("UICorner", { CornerRadius = UDim.new(1, 0) }, d)
		UI.Stroke(d, UI.Colors.SlotStroke, 2)
		dots[i] = d
	end

	local back = UI.Button(body, { Name = "Retour", Theme = "gray", Size = Vector2.new(160, 52), Position = UDim2.fromOffset(98, 342),
		Text = "RETOUR", TextSize = 26 })
	local nextB = UI.Button(body, { Name = "Suivant", Theme = "blue", Size = Vector2.new(190, 56), Position = UDim2.fromOffset(526, 340),
		Text = "SUIVANT", TextSize = 28 })

	local menu = Motion.Window(gui, win.Fenetre, { Keep = { Notifications = true, Recompenses = true } })
	Motion.Spin(sun, 22)
	Motion.Sway(icon, 4, 1.8)
	local api = { Gui = gui, Menu = menu }
	local page = 1

	local function show(n: number, animate: boolean?)
		page = math.clamp(n, 1, #PAGES)
		local p = PAGES[page]
		panel.Degrade.Color = if typeof(p.Gradient) == "string" then UI.PanelThemes[p.Gradient] else p.Gradient
		icon.Image = Icons.Get(p.Icon)
		title.Text, titleShadow.Text = p.Title, p.Title
		title.UIStroke.Color = p.Stroke
		titleShadow.UIStroke.Color = p.Stroke
		titleShadow.TextColor3 = p.Stroke
		desc.Text = p.Text
		desc.UIStroke.Color = p.Stroke
		for i, e in extras do
			local x = p.Extra[i]
			e.Big.Text = x and x[1] or ""
			e.Small.Text = x and x[2] or ""
		end
		for i, d in dots do
			d.BackgroundColor3 = if i == page then UI.Colors.Selection else RGB(60, 70, 80)
			d.Size = if i == page then UDim2.fromOffset(18, 18) else UDim2.fromOffset(14, 14)
		end
		pill.Texte.Text = ('<font color="#FFD23F">%d</font> / %d'):format(page, #PAGES)
		UI.SetDisabled(back, page == 1)
		local last = page == #PAGES
		UI.Recolor(nextB, if last then "green" else "blue")
		UI.SetButtonText(nextB, if last then "C'EST PARTI !" else "SUIVANT")
		if animate then
			pageScale.Scale = 0.88
			TweenService:Create(pageScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			Motion.Play(gui.Sons, "Carte")
		end
	end

	Motion.BindButton(back, 1.05, gui.Sons, function()
		if page > 1 then show(page - 1, true) end
	end)
	Motion.BindButton(nextB, 1.05, gui.Sons, function()
		if page < #PAGES then
			show(page + 1, true)
		else
			Remotes.TutorialDone:FireServer()
			Motion.Play(gui.Sons, "Achat")
			menu.Close()
			ctx.Notify("Bonne chance ! Clique sur JOUER quand tu es prêt.", "go")
		end
	end)

	function api.Open()
		show(1, false)
		menu.Open()
	end
	function api.Close() menu.Close() end
	show(1, false)
	return api
end

return Tutorial
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX00000040"><Properties><string name="Name">Lighting</string><float name="Brightness">2.6</float><float name="ClockTime">15.2</float><float name="GeographicLatitude">30</float><Color3 name="Ambient"><R>0.36</R><G>0.3</G><B>0.26</B></Color3><Color3 name="OutdoorAmbient"><R>0.55</R><G>0.5</G><B>0.45</B></Color3><float name="EnvironmentDiffuseScale">0.6</float><float name="EnvironmentSpecularScale">0.4</float><bool name="GlobalShadows">true</bool></Properties></Item><Item class="SoundService" referent="RBX00000041"><Properties><string name="Name">SoundService</string><bool name="RespectFilteringEnabled">true</bool></Properties></Item></roblox>