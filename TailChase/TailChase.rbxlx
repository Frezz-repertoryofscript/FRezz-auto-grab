	Heavy = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy),
	-- descriptions only (the single "breathing" text)
	Bold = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold),
}

