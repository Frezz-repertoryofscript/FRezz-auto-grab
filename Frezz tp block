-- ================== Slider Logic ==================
local dragging = false

local function updateSlider(percent)
    percent = math.clamp(percent, 0, 1)
    flySpeed = 0.1 + (percent * 0.9)
    SliderFill.Size = UDim2.new(percent, 0, 1, 0)
    SliderKnob.Position = UDim2.new(percent, -10, 0.5, -10)
    SliderLabel.Text = string.format("Vitesse du vol : %.1fs", flySpeed)
end

SliderBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        local percent = (input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X
        updateSlider(percent)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local percent = (input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X
        updateSlider(percent)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ================== Fonctions FREZZ TP ==================
local function createFlyingCarpet()
    if character:FindFirstChild("FlyingCarpet") then return end
    local carpet = Instance.new("Part")
    carpet.Name = "FlyingCarpet"
    carpet.Size = Vector3.new(7, 0.6, 9)
    carpet.Color = Color3.fromRGB(255, 130, 0)
    carpet.Material = Enum.Material.Neon
    carpet.CanCollide = true
    carpet.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = carpet
    weld.Parent = carpet
end

local function flyTo(targetPart)
    createFlyingCarpet()
    local targetCFrame = targetPart.CFrame * CFrame.new(0, 9, 0)

    local tweenInfo = TweenInfo.new(flySpeed, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    TweenService:Create(root, tweenInfo, {CFrame = targetCFrame}):Play()
    
    print("🛫 FREZZ TP → " .. targetPart.Parent.Name .. " (" .. string.format("%.1f", flySpeed) .. "s)")
end

local function refreshBrainrotList()
    for _, btn in pairs(brainrotButtons) do btn:Destroy() end
    brainrotButtons = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("brainrot") or n:find("br ") or n:find("cappuccina") or n:find("tung") or n:find("sigma") or n:find("skibidi") then
            local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
            if rootPart and rootPart ~= root then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -10, 0, 55)
                btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
                btn.Text = "🧠 " .. obj.Name
                btn.TextColor3 = Color3.new(1,1,1)
                btn.TextScaled = true
                btn.Font = Enum.Font.GothamSemibold
                btn.Parent = TPScrolling

                btn.MouseButton1Click:Connect(function()
                    if rootPart then flyTo(rootPart) end
                end)
                table.insert(brainrotButtons, btn)
            end
        end
    end

    TPScrolling.CanvasSize = UDim2.new(0,0,0, TPListLayout.AbsoluteContentSize.Y + 30)
end

-- ================== Fonctions FREZZ BLOCK ==================
local function refreshPlayersList()
    for _, btn in pairs(playerButtons) do btn:Destroy() end
    playerButtons = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 50)
            btn.BackgroundColor3 = Color3.fromRGB(55, 55, 75)
            btn.Text = "👤 " .. plr.Name
            btn.TextColor3 = Color3.fromRGB(255, 80, 80)
            btn.TextScaled = true
            btn.Font = Enum.Font.GothamSemibold
            btn.Parent = BlockScrolling

            btn.MouseButton1Click:Connect(function()
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    root.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2.5)
                    print("🚫 FREZZ BLOCK → " .. plr.Name)
                end
            end)

            table.insert(playerButtons, btn)
        end
    end

    BlockScrolling.CanvasSize = UDim2.new(0,0,0, BlockListLayout.AbsoluteContentSize.Y + 20)
end

-- ================== Contrôles ==================
TPClose.MouseButton1Click:Connect(function() frezzTPGui.Enabled = false end)
BlockClose.MouseButton1Click:Connect(function() frezzBlockGui.Enabled = false end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    if input.KeyCode == Enum.KeyCode.RightShift then
        frezzTPGui.Enabled = not frezzTPGui.Enabled
        if frezzTPGui.Enabled then refreshBrainrotList() end
    end
    
    if input.KeyCode == Enum.KeyCode.LeftShift then
        frezzBlockGui.Enabled = not frezzBlockGui.Enabled
        if frezzBlockGui.Enabled then refreshPlayersList() end
    end
end)

-- Auto refresh toutes les 6 secondes
spawn(function()
    while wait(6) do
        if frezzTPGui.Enabled then refreshBrainrotList() end
        if frezzBlockGui.Enabled then refreshPlayersList() end
    end
end)

